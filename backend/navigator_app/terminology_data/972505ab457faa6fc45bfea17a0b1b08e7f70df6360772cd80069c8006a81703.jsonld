      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Evidence-qualified ways in which a virtual instrument or product relates to a specific source musical instrument or instrument state."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Virtual-instrument source relations"
