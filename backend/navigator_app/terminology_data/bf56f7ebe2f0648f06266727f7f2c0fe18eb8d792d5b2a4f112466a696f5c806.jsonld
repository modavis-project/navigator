        "@value": "testing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A person, organization, group, or other entity capable of bearing responsibility or participating agentively in an activity."
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/ontology/core#Continuant",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
