    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "The exchange profile permits this property on TuningEntry and TuningReference and restricts it to the MIDI range 0–127. A global domain is omitted because asserting both domains would infer an invalid intersection."
      }
    ]
