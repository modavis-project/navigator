<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF xmlns:ns1="http://purl.org/dc/terms/" xmlns:ns2="http://purl.org/vocab/vann/" xmlns:ns3="http://www.w3.org/2002/07/owl#" xmlns:ns4="http://www.w3.org/2000/01/rdf-schema#" xmlns:ns5="http://www.w3.org/2003/06/sw-vocab-status/ns#" xmlns:ns6="http://www.w3.org/2004/02/skos/core#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/evidence">
    <ns1:conformsTo rdf:resource="https://www.w3.org/TR/annotation-vocab/" />
    <ns1:conformsTo rdf:resource="https://www.w3.org/TR/owl2-profiles/#OWL_2_RL" />
    <ns1:creator rdf:resource="https://orcid.org/0000-0002-7904-3892" />
    <ns1:description xml:lang="en">Citable source resources, captured snapshots, precise fragments, selectors, checksums, and qualified evidence relations.</ns1:description>
    <ns1:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-27</ns1:issued>
    <ns1:license rdf:resource="https://creativecommons.org/licenses/by/4.0/" />
    <ns1:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-27</ns1:modified>
    <ns1:publisher rdf:resource="https://orcid.org/0000-0002-7904-3892" />
    <ns1:title xml:lang="en">MODAVIS Evidence Ontology</ns1:title>
    <ns2:preferredNamespacePrefix>modevidence</ns2:preferredNamespacePrefix>
    <ns2:preferredNamespaceUri>https://w3id.org/modavis/ontology/evidence#</ns2:preferredNamespaceUri>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology" />
    <ns3:imports rdf:resource="https://w3id.org/modavis/ontology/core/0.1.0" />
    <ns3:versionIRI rdf:resource="https://w3id.org/modavis/ontology/evidence/0.1.0" />
    <ns3:versionInfo>0.1.0</ns3:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/evidence#Checksum">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/evidence" />
    <ns4:label xml:lang="en">checksum</ns4:label>
    <ns4:subClassOf rdf:resource="https://w3id.org/modavis/ontology/core#Entity" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">A qualified fixity value that records both the digest algorithm and digest value for a resource.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/evidence#EvidenceRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/evidence" />
    <ns4:label xml:lang="en">evidence relation</ns4:label>
    <ns4:subClassOf rdf:resource="https://w3id.org/modavis/ontology/core#IdentifiedResource" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">A qualified relation recording how a source fragment evaluates an assertion or other identified claim-like resource, including supporting, opposing, and contextual roles.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/evidence#Selector">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/evidence" />
    <ns4:label xml:lang="en">source selector</ns4:label>
    <ns4:subClassOf rdf:resource="http://www.w3.org/ns/oa#Selector" />
    <ns4:subClassOf rdf:resource="https://w3id.org/modavis/ontology/core#Entity" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">A structured description of how to identify a segment within a source snapshot, optionally conforming to Web Annotation, Media Fragments, or a reviewed media-specific selector specification.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/evidence#SourceFragment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/evidence" />
    <ns4:label xml:lang="en">source fragment</ns4:label>
    <ns4:subClassOf rdf:resource="https://w3id.org/modavis/ontology/core#Entity" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">A precisely selectable part of a source snapshot, such as a page, text range, image region, timecode, path, or three-dimensional region.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/evidence#SourceResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/evidence" />
    <ns4:label xml:lang="en">source resource</ns4:label>
    <ns4:subClassOf rdf:resource="https://w3id.org/modavis/ontology/core#Entity" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">A citable resource such as a publication, archive item, web page, dataset, image, recording, transcript, or file.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/evidence#SourceSnapshot">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/evidence" />
    <ns4:label xml:lang="en">source snapshot</ns4:label>
    <ns4:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity" />
    <ns4:subClassOf rdf:resource="https://w3id.org/modavis/ontology/core#Entity" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">A captured, time-specific state of a source resource with explicit fixity, a timezone-qualified capture time, and an accountable generating activity.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/evidence#checksumAlgorithm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/evidence#Checksum" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/evidence" />
    <ns4:label xml:lang="en">checksum algorithm</ns4:label>
    <ns4:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Identifies the digest algorithm used to calculate a checksum value.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/evidence#checksumValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/evidence#Checksum" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/evidence" />
    <ns4:label xml:lang="en">checksum value</ns4:label>
    <ns4:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">The normalized digest value produced by the declared checksum algorithm.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/evidence#evaluates">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/evidence#EvidenceRelation" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/evidence" />
    <ns4:label xml:lang="en">evaluates</ns4:label>
    <ns4:range rdf:resource="https://w3id.org/modavis/ontology/core#IdentifiedResource" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Relates a qualified evidence relation to the assertion, event, relation, or other identified claim-like resource it evaluates.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/evidence#evidenceRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/evidence#EvidenceRelation" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/evidence" />
    <ns4:label xml:lang="en">evidence role</ns4:label>
    <ns4:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Classifies how a source fragment bears on the evaluated resource, such as supporting, opposing, or contextual evidence.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/evidence#extractionConfidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/evidence#EvidenceRelation" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/evidence" />
    <ns4:label xml:lang="en">extraction confidence</ns4:label>
    <ns4:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">A decimal from zero through one expressing confidence in the extraction or association represented by an evidence relation.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/evidence#fragmentOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/evidence#SourceFragment" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/evidence" />
    <ns4:label xml:lang="en">fragment of</ns4:label>
    <ns4:range rdf:resource="https://w3id.org/modavis/ontology/evidence#SourceSnapshot" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Identifies the fixed source snapshot within which a fragment is selected.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/evidence#hasChecksum">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/evidence" />
    <ns4:label xml:lang="en">has checksum</ns4:label>
    <ns4:range rdf:resource="https://w3id.org/modavis/ontology/evidence#Checksum" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Relates a resource to a qualified checksum that names both digest algorithm and value.</ns6:definition>
    <ns6:scopeNote xml:lang="en">The applicable SHACL profile determines which fixed resource is being checked. A checksum establishes fixity only for the declared bytes or canonical materialization and does not establish authenticity or truth.</ns6:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/evidence#hasSelector">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/evidence#SourceFragment" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/evidence" />
    <ns4:label xml:lang="en">has selector</ns4:label>
    <ns4:range rdf:resource="https://w3id.org/modavis/ontology/evidence#Selector" />
    <ns4:subPropertyOf rdf:resource="http://www.w3.org/ns/oa#hasSelector" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Relates a source fragment to a structured selector locating it within a fixed source snapshot.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/evidence#selectorConformsTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/evidence#Selector" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/evidence" />
    <ns4:label xml:lang="en">selector conforms to</ns4:label>
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Identifies the specification or profile under which a selector value is interpreted.</ns6:definition>
    <ns6:scopeNote xml:lang="en">The value must be an IRI identifying the citable selector specification or profile. A human-readable format label is insufficient to define interpretation semantics.</ns6:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/evidence#selectorType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/evidence#Selector" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/evidence" />
    <ns4:label xml:lang="en">selector type</ns4:label>
    <ns4:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Classifies the selector with a concept governed by the applicable exchange profile or selector specification.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/evidence#selectorValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/evidence#Selector" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/evidence" />
    <ns4:label xml:lang="en">selector value</ns4:label>
    <ns4:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">The serialized selector expression interpreted according to the selector's declared conformance specification and type.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/evidence#snapshotCapturedAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/evidence#SourceSnapshot" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/evidence" />
    <ns4:label xml:lang="en">source snapshot captured at</ns4:label>
    <ns4:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
    <ns4:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#generatedAtTime" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Records the timezone-qualified instant at which the fixed source state was captured.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/evidence#snapshotCapturedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/evidence#SourceSnapshot" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/evidence" />
    <ns4:label xml:lang="en">source snapshot captured by</ns4:label>
    <ns4:range rdf:resource="http://www.w3.org/ns/prov#Activity" />
    <ns4:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasGeneratedBy" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Identifies the accountable capture, retrieval, or digitization activity that generated the fixed source snapshot.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/evidence#snapshotOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/evidence#SourceSnapshot" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/evidence" />
    <ns4:label xml:lang="en">snapshot of</ns4:label>
    <ns4:range rdf:resource="https://w3id.org/modavis/ontology/evidence#SourceResource" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Identifies the source resource of which a source snapshot captures a particular state.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/evidence#sourceUri">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/evidence#SourceResource" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/evidence" />
    <ns4:label xml:lang="en">source URI</ns4:label>
    <ns4:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">An absolute retrieval or reference URI recorded for a source resource; it is not required to be the resource's persistent identity IRI.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/evidence#usesFragment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/evidence#EvidenceRelation" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/evidence" />
    <ns4:label xml:lang="en">uses fragment</ns4:label>
    <ns4:range rdf:resource="https://w3id.org/modavis/ontology/evidence#SourceFragment" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Identifies a precise source fragment used by an evidence relation.</ns6:definition>
  </rdf:Description>
</rdf:RDF>
