      {
        "@language": "en",
        "@value": "organ coupler shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "An organ coupler must connect distinct components; model same-component effects separately."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "organ coupler shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      PREFIX modorgan: <https://w3id.org/modavis/ontology/organ#>\n      SELECT $this WHERE {\n        $this modorgan:couplesFrom ?component ;\n              modorgan:couplesTo ?component .\n      }\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
