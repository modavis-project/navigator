    <ns4:range rdf:resource="https://w3id.org/modavis/ontology/virtual-instrument#VirtualInstrumentProduct" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Identifies the one stable product identity of which a virtual-instrument version is an edition or release.</ns6:definition>
  </rdf:Description>
