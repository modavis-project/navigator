      {
        "@value": "testing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Identifies an agent accountable for governing the scope and maintenance of a curated knowledge collection."
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/ontology/heritage#currentSnapshot",
    "@type": [
