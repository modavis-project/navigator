<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF xmlns:ns1="http://purl.org/dc/terms/" xmlns:ns2="http://purl.org/vocab/vann/" xmlns:ns3="http://www.w3.org/2002/07/owl#" xmlns:ns4="http://www.w3.org/2000/01/rdf-schema#" xmlns:ns5="http://www.w3.org/2003/06/sw-vocab-status/ns#" xmlns:ns6="http://www.w3.org/2004/02/skos/core#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/media">
    <ns1:conformsTo rdf:resource="https://www.w3.org/TR/owl2-profiles/#OWL_2_RL" />
    <ns1:conformsTo rdf:resource="https://www.w3.org/TR/prov-o/" />
    <ns1:creator rdf:resource="https://orcid.org/0000-0002-7904-3892" />
    <ns1:description xml:lang="en">Representation-neutral semantics for digital surrogates, managed assets, bitstreams, fixity, derivation, and representation status.</ns1:description>
    <ns1:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-27</ns1:issued>
    <ns1:license rdf:resource="https://creativecommons.org/licenses/by/4.0/" />
    <ns1:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-27</ns1:modified>
    <ns1:publisher rdf:resource="https://orcid.org/0000-0002-7904-3892" />
    <ns1:title xml:lang="en">MODAVIS Media and Digital Representation Ontology</ns1:title>
    <ns2:preferredNamespacePrefix>modmedia</ns2:preferredNamespacePrefix>
    <ns2:preferredNamespaceUri>https://w3id.org/modavis/ontology/media#</ns2:preferredNamespaceUri>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology" />
    <ns3:imports rdf:resource="https://w3id.org/modavis/ontology/core/0.1.0" />
    <ns3:imports rdf:resource="https://w3id.org/modavis/ontology/evidence/0.1.0" />
    <ns3:imports rdf:resource="https://w3id.org/modavis/ontology/provenance/0.1.0" />
    <ns3:versionIRI rdf:resource="https://w3id.org/modavis/ontology/media/0.1.0" />
    <ns3:versionInfo>0.1.0</ns3:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/media#Bitstream">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/media" />
    <ns4:label xml:lang="en">bitstream</ns4:label>
    <ns4:subClassOf rdf:resource="https://w3id.org/modavis/ontology/media#DigitalAsset" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">A finite sequence of bytes whose exact content can be fixed by a byte size and checksum.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/media#DigitalAsset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/media" />
    <ns4:label xml:lang="en">digital asset</ns4:label>
    <ns4:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity" />
    <ns4:subClassOf rdf:resource="https://w3id.org/modavis/ontology/core#Entity" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">An identified digital unit managed as retrievable, exchangeable, or preservable content with format, rights, fixity, and provenance where applicable.</ns6:definition>
    <ns6:scopeNote xml:lang="en">A digital asset need not represent another resource. Digital representations are digital assets with an explicit representation relation.</ns6:scopeNote>
    <ns6:scopeNote xml:lang="en">An asset may be a file, compound object, package, stream, model, or another managed unit; storage layout is not inferred from this class.</ns6:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/media#DigitalRepresentation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/media" />
    <ns4:label xml:lang="en">digital representation</ns4:label>
    <ns4:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity" />
    <ns4:subClassOf rdf:resource="https://w3id.org/modavis/ontology/media#DigitalAsset" />
    <ns4:subClassOf rdf:resource="https://w3id.org/modavis/ontology/media#Representation" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">A representation encoded in digital form and capable of being versioned, fixed, derived, or rendered by a computational system.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/media#DigitalSurrogate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/media" />
    <ns4:label xml:lang="en">digital surrogate</ns4:label>
    <ns4:subClassOf rdf:resource="https://w3id.org/modavis/ontology/media#DigitalRepresentation" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">A digital representation intended to stand in for selected documentary, analytical, experiential, or operational aspects of a physical or otherwise distinct resource.</ns6:definition>
    <ns6:scopeNote xml:lang="en">A surrogate does not replace the represented object. A playable virtual instrument may itself be a musical instrument while also serving as a surrogate for aspects of another instrument; the two retain distinct identities.</ns6:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/media#Representation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/media" />
    <ns4:label xml:lang="en">representation</ns4:label>
    <ns4:subClassOf rdf:resource="https://w3id.org/modavis/ontology/core#Entity" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">An entity intentionally standing for, documenting, modeling, or rendering some aspect of another identified resource.</ns6:definition>
    <ns6:scopeNote xml:lang="en">A representation is not asserted to be complete, authentic, or identical to the represented resource.</ns6:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/media#byteSize">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/media#Bitstream" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/media" />
    <ns4:label xml:lang="en">byte size</ns4:label>
    <ns4:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">The exact number of bytes in a fixed bitstream.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/media#conformsToProfile">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/media#DigitalRepresentation" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/media" />
    <ns4:label xml:lang="en">conforms to profile</ns4:label>
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Identifies a specification, profile, or format contract to which a digital representation conforms.</ns6:definition>
    <ns6:scopeNote xml:lang="en">The object should be the persistent IRI of a citable specification or profile. This assertion does not by itself record which validator, versioned test suite, or conformance result established the claim.</ns6:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/media#contentUrl">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/media#DigitalAsset" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/media" />
    <ns4:label xml:lang="en">content URL</ns4:label>
    <ns4:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">A retrieval location for the digital asset; it is not required to be the asset's persistent identity IRI.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/media#derivedFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/media#DigitalAsset" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/media" />
    <ns4:label xml:lang="en">derived from digital asset</ns4:label>
    <ns4:range rdf:resource="https://w3id.org/modavis/ontology/media#DigitalAsset" />
    <ns4:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Relates a digital asset to a source digital asset from which it was derived while preserving both identities.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/media#generatedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/media#DigitalAsset" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/media" />
    <ns4:label xml:lang="en">generated by activity</ns4:label>
    <ns4:range rdf:resource="http://www.w3.org/ns/prov#Activity" />
    <ns4:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasGeneratedBy" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Identifies the capture, processing, reconstruction, simulation, inference, authoring, or other activity that generated a digital asset.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/media#hasChecksum">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/media#Bitstream" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/media" />
    <ns4:label xml:lang="en">has bitstream checksum</ns4:label>
    <ns4:range rdf:resource="https://w3id.org/modavis/ontology/evidence#Checksum" />
    <ns4:subPropertyOf rdf:resource="https://w3id.org/modavis/ontology/evidence#hasChecksum" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Relates a bitstream to a qualified checksum recording its digest algorithm and value.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/media#hasRepresentation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/media" />
    <ns4:label xml:lang="en">has representation</ns4:label>
    <ns4:range rdf:resource="https://w3id.org/modavis/ontology/media#Representation" />
    <ns3:inverseOf rdf:resource="https://w3id.org/modavis/ontology/media#representationOf" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Relates an identified resource to a representation of some documented aspect of that resource.</ns6:definition>
    <ns6:scopeNote xml:lang="en">The subject remains the represented resource and is not inferred to be a MODAVIS Entity solely from this link. The inverse representationOf carries the representation-side domain.</ns6:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/media#mediaType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/media#DigitalAsset" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/media" />
    <ns4:label xml:lang="en">media type</ns4:label>
    <ns4:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">The lowercase IANA media type of a digital asset, without using a filename extension as the authoritative format declaration.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/media#representationOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/media#Representation" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/media" />
    <ns4:label xml:lang="en">representation of</ns4:label>
    <ns4:range rdf:resource="https://w3id.org/modavis/ontology/core#IdentifiedResource" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Identifies a resource represented by a representation without asserting identity, completeness, or evidential status.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/media#representationStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/media#DigitalRepresentation" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/media" />
    <ns4:label xml:lang="en">representation status</ns4:label>
    <ns4:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Classifies how a digital representation was produced or what epistemic status it carries, separately from its detailed generating provenance.</ns6:definition>
  </rdf:Description>
</rdf:RDF>
