        "@value": "testing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A domain event understood as an intentional or organized action or process."
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/ontology/events#Event",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
