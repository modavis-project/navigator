    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/audio#takeNumber" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SamplePlaybackParametersShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">sample playback parameters shape</ns2:label>
