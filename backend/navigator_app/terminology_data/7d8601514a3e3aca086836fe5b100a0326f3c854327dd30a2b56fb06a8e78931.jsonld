      {
        "@language": "en",
        "@value": "context binding shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "Every context binding linked from an assertion must identify that same assertion."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "context binding shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      PREFIX modcontext: <https://w3id.org/modavis/ontology/context#>\n      SELECT $this WHERE {\n        ?assertion modcontext:hasContextBinding $this .\n        FILTER NOT EXISTS { $this modcontext:contextualizesAssertion ?assertion . }\n      }\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
