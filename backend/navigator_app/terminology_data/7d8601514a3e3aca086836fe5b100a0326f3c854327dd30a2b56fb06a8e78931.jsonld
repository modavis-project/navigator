      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#MidiPlaybackBindingShape-maximumNoteNumber-PropertyShape-01"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#MidiPlaybackBindingShape-maximumNoteOnVelocity-PropertyShape-02"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#MidiPlaybackBindingShape-minimumNoteNumber-PropertyShape-03"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#MidiPlaybackBindingShape-minimumNoteOnVelocity-PropertyShape-04"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#MidiPlaybackBindingShape-playbackParameters-PropertyShape-05"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#MidiPlaybackBindingShape-rootNoteNumber-PropertyShape-06"
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ],
    "http://www.w3.org/ns/shacl#sparql": [
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#MidiPlaybackBindingShape-SPARQLConstraint-01"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#MidiPlaybackBindingShape-SPARQLConstraint-02"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#MidiPlaybackBindingShape-SPARQLConstraint-03"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://w3id.org/modavis/ontology/midi#MidiPlaybackBinding"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#MidiPlaybackBindingShape-SPARQLConstraint-01",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "midi playback binding shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "A MIDI note-number range cannot have a minimum greater than its maximum."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "midi playback binding shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      PREFIX modmidi: <https://w3id.org/modavis/ontology/midi#>\n      SELECT $this WHERE {\n        $this modmidi:minimumNoteNumber ?minimum ; modmidi:maximumNoteNumber ?maximum .\n        FILTER (?minimum > ?maximum)\n      }\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#MidiPlaybackBindingShape-SPARQLConstraint-02",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "midi playback binding shape sparqlconstraint 02"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "A MIDI note-on velocity range cannot have a minimum greater than its maximum."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "midi playback binding shape sparqlconstraint 02"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      PREFIX modmidi: <https://w3id.org/modavis/ontology/midi#>\n      SELECT $this WHERE {\n        $this modmidi:minimumNoteOnVelocity ?minimum ; modmidi:maximumNoteOnVelocity ?maximum .\n        FILTER (?minimum > ?maximum)\n      }\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#MidiPlaybackBindingShape-SPARQLConstraint-03",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "midi playback binding shape sparqlconstraint 03"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "The root MIDI note number must fall within any declared note-number range."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "midi playback binding shape sparqlconstraint 03"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      PREFIX modmidi: <https://w3id.org/modavis/ontology/midi#>\n      SELECT $this WHERE {\n        { $this modmidi:rootNoteNumber ?root ; modmidi:minimumNoteNumber ?minimum . FILTER (?root < ?minimum) }\n        UNION\n        { $this modmidi:rootNoteNumber ?root ; modmidi:maximumNoteNumber ?maximum . FILTER (?root > ?maximum) }\n      }\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#MidiPlaybackBindingShape-maximumNoteNumber-PropertyShape-01",
    "@type": [
      "http://www.w3.org/ns/shacl#PropertyShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "maximum note number property constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#datatype": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
      }
    ],
    "http://www.w3.org/ns/shacl#maxCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#maxInclusive": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 127
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "Maximum note number constraint: at most 1 value(s) are permitted; values must use the nonNegativeInteger datatype; value must be at most 127."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "maximum note number property constraint"
      }
