    <ns3:class rdf:resource="http://www.w3.org/ns/prov#SoftwareAgent" />
    <ns3:message xml:lang="en">Used software constraint: values must be instances of SoftwareAgent.</ns3:message>
    <ns3:name xml:lang="en">used software property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/provenance#usedSoftware" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">projection shape</ns2:label>
    <ns3:message xml:lang="en">The focus node must satisfy the named logical, node-kind, or lexical constraint declared by this shape.</ns3:message>
    <ns3:name xml:lang="en">projection shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-Path-PropertyShape-08" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-projectionGeneratedBy-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-projectionGraphIri-PropertyShape-02" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-projectionPredicateIri-PropertyShape-03" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-projectionRule-PropertyShape-04" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-projectionRuleVersion-PropertyShape-05" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-projectionSubject-PropertyShape-06" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-projectsAssertion-PropertyShape-07" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-SPARQLConstraint-01" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-SPARQLConstraint-02" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-SPARQLConstraint-03" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/assertion#Projection" />
    <ns3:xone rdf:nodeID="cb161d92839d05ca6c7ce9daf69f54942d90de8c07fc6e9252e8a2452bd390d458c" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-Path-PropertyShape-08">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">property path property constraint</ns2:label>
    <ns3:hasValue rdf:resource="https://w3id.org/modavis/vocab/assertion-status/accepted" />
    <ns3:message xml:lang="en">Property path constraint: the value accepted is required.</ns3:message>
    <ns3:name xml:lang="en">property path property constraint</ns3:name>
    <ns3:path rdf:nodeID="cbcd454e1cf2858462e2ff0295846617889e6b51b3e721d58cb95bdcb7aab537d4" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-SPARQLConstraint-01">
    <ns2:label xml:lang="en">projection shape sparqlconstraint 01</ns2:label>
    <ns3:message xml:lang="en">A projection without a named target graph must include its exact projected RDF statement in the validation graph.</ns3:message>
    <ns3:name xml:lang="en">projection shape sparqlconstraint 01</ns3:name>
    <ns3:select>
      PREFIX modassert: &lt;https://w3id.org/modavis/ontology/assertion#&gt;
      SELECT $this WHERE {
        $this modassert:projectionSubject ?subject ;
              modassert:projectionPredicateIri ?predicateIri .
        FILTER NOT EXISTS { $this modassert:projectionGraphIri ?graph . }
        FILTER NOT EXISTS {
          $this modassert:projectionObject ?object .
          BIND (IRI(STR(?predicateIri)) AS ?predicate)
          ?subject ?predicate ?object .
        }
        FILTER NOT EXISTS {
          $this modassert:projectionLiteral ?literal .
          BIND (IRI(STR(?predicateIri)) AS ?predicate)
          ?subject ?predicate ?literal .
        }
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-SPARQLConstraint-02">
    <ns2:label xml:lang="en">projection shape sparqlconstraint 02</ns2:label>
    <ns3:message xml:lang="en">Projection subject and object values must reproduce the assertion being projected.</ns3:message>
    <ns3:name xml:lang="en">projection shape sparqlconstraint 02</ns3:name>
    <ns3:select>
      PREFIX modassert: &lt;https://w3id.org/modavis/ontology/assertion#&gt;
      SELECT $this WHERE {
        $this modassert:projectsAssertion ?assertion ; modassert:projectionSubject ?subject .
        { FILTER NOT EXISTS { ?assertion modassert:assertsSubject ?subject . } }
        UNION
        { $this modassert:projectionObject ?object . FILTER NOT EXISTS { ?assertion modassert:assertsObject ?object . } }
        UNION
        { $this modassert:projectionLiteral ?literal . FILTER NOT EXISTS { ?assertion modassert:assertsLiteral ?literal . } }
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-SPARQLConstraint-03">
    <ns2:label xml:lang="en">projection shape sparqlconstraint 03</ns2:label>
    <ns3:message xml:lang="en">The projection predicate IRI must equal the projected-property mapping of the assertion predicate concept.</ns3:message>
    <ns3:name xml:lang="en">projection shape sparqlconstraint 03</ns3:name>
    <ns3:select>
      PREFIX modassert: &lt;https://w3id.org/modavis/ontology/assertion#&gt;
      PREFIX assertionpredicate: &lt;https://w3id.org/modavis/vocab/assertion-predicate/&gt;
      PREFIX xsd: &lt;http://www.w3.org/2001/XMLSchema#&gt;
      SELECT $this WHERE {
        $this modassert:projectsAssertion ?assertion ; modassert:projectionPredicateIri ?projected .
        ?assertion modassert:assertsPredicate ?predicate .
        FILTER (
          ?predicate != assertionpredicate:has-builder ||
          ?projected != "https://w3id.org/modavis/ontology/instrument#hasBuilder"^^xsd:anyURI
        )
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-projectionGeneratedBy-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">projection generated by property constraint</ns2:label>
    <ns3:class rdf:resource="http://www.w3.org/ns/prov#Activity" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Projection generated by constraint: exactly 1 value(s) are required; values must be instances of Activity; values must have node kind IRI.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">projection generated by property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/assertion#projectionGeneratedBy" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-projectionGraphIri-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">projection graph iri property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Projection graph iri constraint: at most 1 value(s) are permitted; values must use the anyURI datatype; lexical form must match the declared pattern.</ns3:message>
    <ns3:name xml:lang="en">projection graph iri property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/assertion#projectionGraphIri" />
    <ns3:pattern>^[A-Za-z][A-Za-z0-9+.-]*:</ns3:pattern>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-projectionLiteral-PropertyShape-09">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">projection literal property constraint</ns2:label>
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</ns3:maxCount>
    <ns3:message xml:lang="en">Projection literal constraint: at most 0 value(s) are permitted.</ns3:message>
    <ns3:name xml:lang="en">projection literal property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/assertion#projectionLiteral" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-projectionLiteral-PropertyShape-11">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">projection literal property constraint</ns2:label>
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Projection literal constraint: exactly 1 value(s) are required; values must have node kind Literal.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">projection literal property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/assertion#projectionLiteral" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-projectionObject-PropertyShape-10">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">projection object property constraint</ns2:label>
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Projection object constraint: exactly 1 value(s) are required; values must have node kind IRI.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">projection object property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/assertion#projectionObject" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-projectionObject-PropertyShape-12">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">projection object property constraint</ns2:label>
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</ns3:maxCount>
    <ns3:message xml:lang="en">Projection object constraint: at most 0 value(s) are permitted.</ns3:message>
    <ns3:name xml:lang="en">projection object property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/assertion#projectionObject" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-projectionPredicateIri-PropertyShape-03">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">projection predicate iri property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Projection predicate iri constraint: exactly 1 value(s) are required; values must use the anyURI datatype; lexical form must match the declared pattern.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">projection predicate iri property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/assertion#projectionPredicateIri" />
    <ns3:pattern>^[A-Za-z][A-Za-z0-9+.-]*:</ns3:pattern>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-projectionRule-PropertyShape-04">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">projection rule property constraint</ns2:label>
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Projection rule constraint: exactly 1 value(s) are required; values must have node kind IRI.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">projection rule property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/assertion#projectionRule" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-projectionRuleVersion-PropertyShape-05">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">projection rule version property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Projection rule version constraint: exactly 1 value(s) are required; values must use the string datatype; lexical length must be at least 1.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:minLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minLength>
    <ns3:name xml:lang="en">projection rule version property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/assertion#projectionRuleVersion" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-projectionSubject-PropertyShape-06">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">projection subject property constraint</ns2:label>
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Projection subject constraint: exactly 1 value(s) are required; values must have node kind IRI.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">projection subject property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/assertion#projectionSubject" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-projectsAssertion-PropertyShape-07">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">projects assertion property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/assertion#Assertion" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Projects assertion constraint: exactly 1 value(s) are required; values must be instances of Assertion.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">projects assertion property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/assertion#projectsAssertion" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-xone-Alternative-NodeShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">projection shape xone alternative node shape 01</ns2:label>
    <ns3:name xml:lang="en">projection shape xone alternative node shape 01</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-projectionLiteral-PropertyShape-09" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-projectionObject-PropertyShape-10" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-xone-Alternative-NodeShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">projection shape xone alternative node shape 02</ns2:label>
    <ns3:name xml:lang="en">projection shape xone alternative node shape 02</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-projectionLiteral-PropertyShape-11" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-projectionObject-PropertyShape-12" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#PublicEventShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">public event shape</ns2:label>
    <ns3:name xml:lang="en">public event shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#PublicEventShape-affectedEntity-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#PublicEventShape-eventType-PropertyShape-02" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#PublicEventShape-evidencedBy-PropertyShape-03" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#PublicEventShape-hasParticipant-PropertyShape-04" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#PublicEventShape-hasSource-PropertyShape-05" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#PublicEventShape-hasTimeSpan-PropertyShape-06" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#PublicEventShape-tookPlaceAt-PropertyShape-07" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#PublicEventShape-SPARQLConstraint-01" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#PublicEventShape-SPARQLConstraint-02" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/events#Event" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#PublicEventShape-SPARQLConstraint-01">
    <ns2:label xml:lang="en">public event shape sparqlconstraint 01</ns2:label>
    <ns3:message xml:lang="en">At least one event source must be the source resource reached through each linked evidence fragment.</ns3:message>
    <ns3:name xml:lang="en">public event shape sparqlconstraint 01</ns3:name>
    <ns3:select>
      PREFIX modevent: &lt;https://w3id.org/modavis/ontology/events#&gt;
      PREFIX modevidence: &lt;https://w3id.org/modavis/ontology/evidence#&gt;
      SELECT $this WHERE {
        $this modevent:evidencedBy ?relation .
        ?relation modevidence:usesFragment/modevidence:fragmentOf/modevidence:snapshotOf ?source .
        FILTER NOT EXISTS { $this modevent:hasSource ?source . }
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#PublicEventShape-SPARQLConstraint-02">
    <ns2:label xml:lang="en">public event shape sparqlconstraint 02</ns2:label>
    <ns3:message xml:lang="en">Every event evidence relation must identify that event as the resource it evaluates.</ns3:message>
    <ns3:name xml:lang="en">public event shape sparqlconstraint 02</ns3:name>
    <ns3:select>
      PREFIX modevent: &lt;https://w3id.org/modavis/ontology/events#&gt;
      PREFIX modevidence: &lt;https://w3id.org/modavis/ontology/evidence#&gt;
      SELECT $this WHERE {
        $this modevent:evidencedBy ?relation .
        FILTER NOT EXISTS { ?relation modevidence:evaluates $this . }
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#PublicEventShape-affectedEntity-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">affected entity property constraint</ns2:label>
    <ns3:message xml:lang="en">Affected entity constraint: at least 1 value(s) are required; values must have node kind IRI.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">affected entity property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/events#affectedEntity" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#PublicEventShape-eventType-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">event type property constraint</ns2:label>
    <ns3:in rdf:nodeID="cba08efc02ba7f8825edb5a3fb71e32defe66541c5e08165a2cad439c8bb9bc45c" />
    <ns3:message xml:lang="en">Event type constraint: at least 1 value(s) are required; values must have node kind IRI; values must belong to the enumerated release set.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">event type property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/events#eventType" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#PublicEventShape-evidencedBy-PropertyShape-03">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">evidenced by property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/evidence#EvidenceRelation" />
    <ns3:message xml:lang="en">Evidenced by constraint: at least 1 value(s) are required; values must be instances of EvidenceRelation.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">evidenced by property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/events#evidencedBy" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#PublicEventShape-hasParticipant-PropertyShape-04">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">has participant property constraint</ns2:label>
    <ns3:message xml:lang="en">Has participant constraint: values must have node kind IRI.</ns3:message>
    <ns3:name xml:lang="en">has participant property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/events#hasParticipant" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#PublicEventShape-hasSource-PropertyShape-05">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">has source property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/evidence#SourceResource" />
    <ns3:message xml:lang="en">Has source constraint: at least 1 value(s) are required; values must be instances of SourceResource.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">has source property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/events#hasSource" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#PublicEventShape-hasTimeSpan-PropertyShape-06">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">has time span property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/core#TimeSpan" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Has time span constraint: at most 1 value(s) are permitted; values must be instances of TimeSpan.</ns3:message>
    <ns3:name xml:lang="en">has time span property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/events#hasTimeSpan" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#PublicEventShape-tookPlaceAt-PropertyShape-07">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">took place at property constraint</ns2:label>
    <ns3:message xml:lang="en">Took place at constraint: values must have node kind IRI.</ns3:message>
    <ns3:name xml:lang="en">took place at property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/events#tookPlaceAt" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#RepresentationShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">representation shape</ns2:label>
    <ns3:name xml:lang="en">representation shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#RepresentationShape-representationOf-PropertyShape-01" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#RepresentationShape-SPARQLConstraint-01" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/media#Representation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#RepresentationShape-SPARQLConstraint-01">
    <ns2:label xml:lang="en">representation shape sparqlconstraint 01</ns2:label>
    <ns3:message xml:lang="en">A representation chain cannot contain a cycle; retain distinct identities for representations and represented resources.</ns3:message>
    <ns3:name xml:lang="en">representation shape sparqlconstraint 01</ns3:name>
    <ns3:select>
      PREFIX modmedia: &lt;https://w3id.org/modavis/ontology/media#&gt;
      SELECT $this WHERE { $this modmedia:representationOf+ $this . }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#RepresentationShape-representationOf-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">representation of property constraint</ns2:label>
    <ns3:message xml:lang="en">A representation requires at least one represented resource IRI.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">representation of property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/media#representationOf" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SHA256ChecksumShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">sha256 checksum shape</ns2:label>
    <ns3:name xml:lang="en">sha256 checksum shape</ns3:name>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SHA256ChecksumShape-SPARQLConstraint-01" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/evidence#Checksum" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SHA256ChecksumShape-SPARQLConstraint-01">
    <ns2:label xml:lang="en">sha256 checksum shape sparqlconstraint 01</ns2:label>
    <ns3:message xml:lang="en">A checksum declared as SHA-256 must contain exactly 64 lowercase hexadecimal characters.</ns3:message>
    <ns3:name xml:lang="en">sha256 checksum shape sparqlconstraint 01</ns3:name>
    <ns3:select>
      PREFIX modevidence: &lt;https://w3id.org/modavis/ontology/evidence#&gt;
      PREFIX checksum: &lt;https://w3id.org/modavis/vocab/checksum-algorithm/&gt;
      SELECT $this WHERE {
        $this modevidence:checksumAlgorithm checksum:sha-256 ;
              modevidence:checksumValue ?value .
        FILTER (!REGEX(STR(?value), "^[0-9a-f]{64}$"))
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SampleExtractionRegionShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">sample extraction region shape</ns2:label>
    <ns3:name xml:lang="en">sample extraction region shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SampleExtractionRegionShape-assignmentConfidence-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SampleExtractionRegionShape-assignmentMethod-PropertyShape-02" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SampleExtractionRegionShape-captureSequenceIndex-PropertyShape-03" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SampleExtractionRegionShape-takeNumber-PropertyShape-04" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/audio#SampleExtractionRegion" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SampleExtractionRegionShape-assignmentConfidence-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">assignment confidence property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxInclusive>
    <ns3:message xml:lang="en">Assignment confidence constraint: at most 1 value(s) are permitted; values must use the decimal datatype; value must be at least 0; value must be at most 1.</ns3:message>
    <ns3:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</ns3:minInclusive>
    <ns3:name xml:lang="en">assignment confidence property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/audio#assignmentConfidence" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SampleExtractionRegionShape-assignmentMethod-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">assignment method property constraint</ns2:label>
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Assignment method constraint: at most 1 value(s) are permitted; values must have node kind IRI.</ns3:message>
    <ns3:name xml:lang="en">assignment method property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/audio#assignmentMethod" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SampleExtractionRegionShape-captureSequenceIndex-PropertyShape-03">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">capture sequence index property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Capture sequence index constraint: at most 1 value(s) are permitted; values must use the nonNegativeInteger datatype.</ns3:message>
    <ns3:name xml:lang="en">capture sequence index property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/audio#captureSequenceIndex" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SampleExtractionRegionShape-takeNumber-PropertyShape-04">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">take number property constraint</ns2:label>
