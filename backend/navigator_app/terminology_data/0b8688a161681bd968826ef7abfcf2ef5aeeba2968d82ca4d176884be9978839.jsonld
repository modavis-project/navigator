        "@value": "compatibility target"
      }
    ],
    "http://www.w3.org/2003/06/sw-vocab-status/ns#term_status": [
      {
        "@value": "testing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Identifies the governed concept, specification, platform, host, product version, protocol, plugin format, or operating environment evaluated by a compatibility statement."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "The target is an IRI. Profiles may require a SKOS concept for a closed classification or an identified resource for a version-specific environment."
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/ontology/virtual-instrument#compatibilityVersion",
