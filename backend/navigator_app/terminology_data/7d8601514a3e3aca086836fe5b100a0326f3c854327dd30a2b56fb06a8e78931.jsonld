  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#SampleExtractionRegionShape-assignmentConfidence-PropertyShape-01",
    "@type": [
      "http://www.w3.org/ns/shacl#PropertyShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "assignment confidence property constraint"
      }
    ],
