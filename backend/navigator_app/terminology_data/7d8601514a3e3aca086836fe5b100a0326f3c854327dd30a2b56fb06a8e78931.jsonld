        "@value": "assertion shape"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "The focus node must satisfy the named logical, node-kind, or lexical constraint declared by this shape."
      }
    ],
