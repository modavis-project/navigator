  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#VirtualInstrumentIdentityLayerShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">virtual instrument identity layer shape</ns2:label>
    <ns3:name xml:lang="en">virtual instrument identity layer shape</ns3:name>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#VirtualInstrumentIdentityLayerShape-SPARQLConstraint-01" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/virtual-instrument#VirtualInstrumentPackage" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/virtual-instrument#VirtualInstrumentProduct" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/virtual-instrument#VirtualInstrumentVersion" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/virtual-instrument#VirtualMusicalInstrument" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#VirtualInstrumentIdentityLayerShape-SPARQLConstraint-01">
    <ns2:label xml:lang="en">virtual instrument identity layer shape sparqlconstraint 01</ns2:label>
    <ns3:message xml:lang="en">A resource cannot occupy more than one of the distinct virtual-instrument, product, version, and package identity layers.</ns3:message>
    <ns3:name xml:lang="en">virtual instrument identity layer shape sparqlconstraint 01</ns3:name>
    <ns3:select>
      PREFIX modvmi: &lt;https://w3id.org/modavis/ontology/virtual-instrument#&gt;
      PREFIX rdfs: &lt;http://www.w3.org/2000/01/rdf-schema#&gt;
      SELECT DISTINCT $this WHERE {
        $this a ?leftType, ?rightType .
        ?leftType rdfs:subClassOf* ?leftLayer .
        ?rightType rdfs:subClassOf* ?rightLayer .
        FILTER (?leftLayer IN (
          modvmi:VirtualMusicalInstrument,
          modvmi:VirtualInstrumentProduct,
          modvmi:VirtualInstrumentVersion,
          modvmi:VirtualInstrumentPackage
        ))
        FILTER (?rightLayer IN (
          modvmi:VirtualMusicalInstrument,
          modvmi:VirtualInstrumentProduct,
          modvmi:VirtualInstrumentVersion,
          modvmi:VirtualInstrumentPackage
        ))
        FILTER (?leftLayer != ?rightLayer)
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#VirtualInstrumentPackageShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">virtual instrument package shape</ns2:label>
    <ns3:name xml:lang="en">virtual instrument package shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#VirtualInstrumentPackageShape-packageOfVersion-PropertyShape-01" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/virtual-instrument#VirtualInstrumentPackage" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#VirtualInstrumentPackageShape-packageOfVersion-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">package of version property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/virtual-instrument#VirtualInstrumentVersion" />
    <ns3:message xml:lang="en">A virtual-instrument package requires at least one distributed version.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">package of version property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/virtual-instrument#packageOfVersion" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#VirtualInstrumentProductionMethodShape">
