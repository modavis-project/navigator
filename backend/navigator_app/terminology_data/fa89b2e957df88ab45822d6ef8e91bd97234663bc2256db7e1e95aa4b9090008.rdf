    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SamplePlaybackParametersShape-SPARQLConstraint-01" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SamplePlaybackParametersShape-SPARQLConstraint-02" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SamplePlaybackParametersShape-SPARQLConstraint-03" />
