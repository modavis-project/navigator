modshape:AudioSignalShape-channelCount-PropertyShape-01 a sh:PropertyShape ;
    rdfs:label "channel count property constraint"@en ;
    sh:datatype xsd:positiveInteger ;
    sh:maxCount 1 ;
    sh:message "An audio signal requires one positive channel count."@en ;
    sh:minCount 1 ;
    sh:name "channel count property constraint"@en ;
    sh:path modaudio:channelCount ;
    sh:severity sh:Violation .

modshape:AudioSignalShape-sampleRate-PropertyShape-02 a sh:PropertyShape ;
    rdfs:label "sample rate property constraint"@en ;
    sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:message "An audio signal requires one positive decimal sample rate in hertz."@en ;
    sh:minCount 1 ;
    sh:minExclusive 0 ;
    sh:name "sample rate property constraint"@en ;
    sh:path modaudio:sampleRate ;
    sh:severity sh:Violation .

modshape:AudioSignalShape-totalFrames-PropertyShape-03 a sh:PropertyShape ;
    rdfs:label "total frames property constraint"@en ;
    sh:datatype xsd:positiveInteger ;
    sh:maxCount 1 ;
    sh:message "An audio signal requires one positive total-frame count."@en ;
    sh:minCount 1 ;
    sh:name "total frames property constraint"@en ;
    sh:path modaudio:totalFrames ;
    sh:severity sh:Violation .

modshape:LoopPointSetShape-SPARQLConstraint-01 rdfs:label "loop point set shape sparqlconstraint 01"@en ;
    sh:message "Every loop region in a loop point set must use the same fixed audio signal as the set."@en ;
    sh:name "loop point set shape sparqlconstraint 01"@en ;
    sh:select """
      PREFIX modaudio: <https://w3id.org/modavis/ontology/audio#>
      SELECT $this WHERE {
        $this modaudio:appliesToSignal ?signal ; modaudio:hasLoopRegion ?region .
        FILTER NOT EXISTS { ?region modaudio:appliesToSignal ?signal . }
      }
    """ ;
    sh:severity sh:Violation .

modshape:LoopPointSetShape-appliesToSignal-PropertyShape-01 a sh:PropertyShape ;
    rdfs:label "applies to signal property constraint"@en ;
    sh:class modaudio:AudioSignal ;
    sh:maxCount 1 ;
    sh:message "Applies to signal constraint: exactly 1 value(s) are required; values must be instances of AudioSignal."@en ;
    sh:minCount 1 ;
    sh:name "applies to signal property constraint"@en ;
    sh:path modaudio:appliesToSignal ;
    sh:severity sh:Violation .

modshape:LoopPointSetShape-confidence-PropertyShape-02 a sh:PropertyShape ;
    rdfs:label "confidence property constraint"@en ;
    sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:maxInclusive 1 ;
    sh:message "Confidence constraint: at most 1 value(s) are permitted; values must use the decimal datatype; value must be at least 0; value must be at most 1."@en ;
    sh:minInclusive 0 ;
    sh:name "confidence property constraint"@en ;
    sh:path modaudio:confidence ;
    sh:severity sh:Violation .

modshape:LoopPointSetShape-hasLoopRegion-PropertyShape-03 a sh:PropertyShape ;
    rdfs:label "has loop region property constraint"@en ;
    sh:class modaudio:SustainLoopRegion ;
    sh:message "Has loop region constraint: at least 1 value(s) are required; values must be instances of SustainLoopRegion."@en ;
    sh:minCount 1 ;
    sh:name "has loop region property constraint"@en ;
    sh:path modaudio:hasLoopRegion ;
    sh:severity sh:Violation .

modshape:LoopPointSetShape-loopabilityAssessment-PropertyShape-04 a sh:PropertyShape ;
    rdfs:label "loopability assessment property constraint"@en ;
    sh:maxCount 1 ;
    sh:message "Loopability assessment constraint: at most 1 value(s) are permitted; values must have node kind IRI."@en ;
    sh:name "loopability assessment property constraint"@en ;
    sh:nodeKind sh:IRI ;
    sh:path modaudio:loopabilityAssessment ;
    sh:severity sh:Violation .

modshape:SampleExtractionRegionShape-assignmentConfidence-PropertyShape-01 a sh:PropertyShape ;
    rdfs:label "assignment confidence property constraint"@en ;
    sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
