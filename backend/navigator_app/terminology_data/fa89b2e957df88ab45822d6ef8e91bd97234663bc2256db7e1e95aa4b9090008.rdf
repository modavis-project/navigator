    <ns2:label xml:lang="en">assertion shape xone alternative node shape 02</ns2:label>
    <ns3:name xml:lang="en">assertion shape xone alternative node shape 02</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#AssertionShape-assertsLiteral-PropertyShape-10" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#AssertionShape-assertsObject-PropertyShape-11" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#AudioSignalShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">audio signal shape</ns2:label>
    <ns3:name xml:lang="en">audio signal shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#AudioSignalShape-channelCount-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#AudioSignalShape-sampleRate-PropertyShape-02" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#AudioSignalShape-totalFrames-PropertyShape-03" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/audio#AudioSignal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#AudioSignalShape-channelCount-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">channel count property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">An audio signal requires one positive channel count.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">channel count property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/audio#channelCount" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#AudioSignalShape-sampleRate-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">sample rate property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">An audio signal requires one positive decimal sample rate in hertz.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</ns3:minExclusive>
    <ns3:name xml:lang="en">sample rate property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/audio#sampleRate" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#AudioSignalShape-totalFrames-PropertyShape-03">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">total frames property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">An audio signal requires one positive total-frame count.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">total frames property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/audio#totalFrames" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#BitstreamShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">bitstream shape</ns2:label>
    <ns3:name xml:lang="en">bitstream shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#BitstreamShape-byteSize-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#BitstreamShape-hasChecksum-PropertyShape-02" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#BitstreamShape-mediaType-PropertyShape-03" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/media#Bitstream" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#BitstreamShape-byteSize-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">byte size property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A fixed bitstream requires one non-negative byte size.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">byte size property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/media#byteSize" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#BitstreamShape-hasChecksum-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">has checksum property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/evidence#Checksum" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A fixed bitstream requires exactly one qualified checksum under the closed MODAVIS 0.1.0 algorithm profile.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">has checksum property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/media#hasChecksum" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#BitstreamShape-mediaType-PropertyShape-03">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">media type property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A fixed bitstream requires one IANA media type string.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">media type property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/media#mediaType" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ChecksumShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">checksum shape</ns2:label>
    <ns3:name xml:lang="en">checksum shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ChecksumShape-checksumAlgorithm-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ChecksumShape-checksumValue-PropertyShape-02" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/evidence#Checksum" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ChecksumShape-checksumAlgorithm-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">checksum algorithm property constraint</ns2:label>
    <ns3:in rdf:nodeID="cb1c077a02b56334cfec575d05f6f02669fdb5763d278c73632dcb6b2a8af97ee9c" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A MODAVIS 0.1.0 checksum requires exactly one digest algorithm from the closed release scheme.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">checksum algorithm property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/evidence#checksumAlgorithm" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ChecksumShape-checksumValue-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">checksum value property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A checksum requires one non-empty normalized digest value.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:minLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minLength>
    <ns3:name xml:lang="en">checksum value property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/evidence#checksumValue" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#CompatibilityStatementShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">compatibility statement shape</ns2:label>
    <ns3:name xml:lang="en">compatibility statement shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#CompatibilityStatementShape-compatibilityStatus-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#CompatibilityStatementShape-compatibilityTarget-PropertyShape-02" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#CompatibilityStatementShape-compatibilityVersion-PropertyShape-03" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#CompatibilityStatementShape-hasEvidenceRelation-PropertyShape-04" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#CompatibilityStatementShape-SPARQLConstraint-01" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/virtual-instrument#CompatibilityStatement" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#CompatibilityStatementShape-SPARQLConstraint-01">
    <ns2:label xml:lang="en">compatibility statement shape sparqlconstraint 01</ns2:label>
    <ns3:message xml:lang="en">Every compatibility evidence relation must identify the compatibility statement it evaluates.</ns3:message>
    <ns3:name xml:lang="en">compatibility statement shape sparqlconstraint 01</ns3:name>
    <ns3:select>
      PREFIX modevidence: &lt;https://w3id.org/modavis/ontology/evidence#&gt;
      PREFIX modvmi: &lt;https://w3id.org/modavis/ontology/virtual-instrument#&gt;
      SELECT $this WHERE {
        $this modvmi:hasEvidenceRelation ?relation .
        FILTER NOT EXISTS { ?relation modevidence:evaluates $this . }
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#CompatibilityStatementShape-compatibilityStatus-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">compatibility status property constraint</ns2:label>
    <ns3:in rdf:nodeID="cbf1c547eae5fddb6c1de3bb4750fb717e28c179786b2c38d67bfa41b28eec0ffe" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Compatibility status constraint: exactly 1 value(s) are required; values must have node kind IRI; values must belong to the enumerated release set.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">compatibility status property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/virtual-instrument#compatibilityStatus" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#CompatibilityStatementShape-compatibilityTarget-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">compatibility target property constraint</ns2:label>
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Compatibility target constraint: exactly 1 value(s) are required; values must have node kind IRI.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">compatibility target property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/virtual-instrument#compatibilityTarget" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#CompatibilityStatementShape-compatibilityVersion-PropertyShape-03">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">compatibility version property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/virtual-instrument#VirtualInstrumentVersion" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Compatibility version constraint: exactly 1 value(s) are required; values must be instances of VirtualInstrumentVersion.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">compatibility version property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/virtual-instrument#compatibilityVersion" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#CompatibilityStatementShape-hasEvidenceRelation-PropertyShape-04">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">has evidence relation property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/evidence#EvidenceRelation" />
    <ns3:message xml:lang="en">A compatibility statement requires evidence identifying the test, documentation, or review basis.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">has evidence relation property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/virtual-instrument#hasEvidenceRelation" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">component membership shape</ns2:label>
    <ns3:name xml:lang="en">component membership shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-appliesInConfiguration-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-appliesInState-PropertyShape-02" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-childComponent-PropertyShape-03" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-membershipInstrument-PropertyShape-04" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-membershipType-PropertyShape-05" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-parentComponent-PropertyShape-06" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-SPARQLConstraint-01" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-SPARQLConstraint-02" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-SPARQLConstraint-03" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-SPARQLConstraint-04" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/instrument#ComponentMembership" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-SPARQLConstraint-01">
    <ns2:label xml:lang="en">component membership shape sparqlconstraint 01</ns2:label>
    <ns3:message xml:lang="en">A component membership cannot relate a component to itself.</ns3:message>
    <ns3:name xml:lang="en">component membership shape sparqlconstraint 01</ns3:name>
    <ns3:select>
      PREFIX modinst: &lt;https://w3id.org/modavis/ontology/instrument#&gt;
      SELECT $this WHERE {
        $this modinst:parentComponent ?component ;
              modinst:childComponent ?component .
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-SPARQLConstraint-02">
    <ns2:label xml:lang="en">component membership shape sparqlconstraint 02</ns2:label>
    <ns3:message xml:lang="en">A membership configuration must belong to the membership instrument.</ns3:message>
    <ns3:name xml:lang="en">component membership shape sparqlconstraint 02</ns3:name>
    <ns3:select>
      PREFIX modinst: &lt;https://w3id.org/modavis/ontology/instrument#&gt;
      SELECT $this WHERE {
        $this modinst:membershipInstrument ?instrument ;
              modinst:appliesInConfiguration ?configuration .
        FILTER NOT EXISTS { ?configuration modinst:configurationOf ?instrument . }
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-SPARQLConstraint-03">
    <ns2:label xml:lang="en">component membership shape sparqlconstraint 03</ns2:label>
    <ns3:message xml:lang="en">A membership state must describe the membership instrument.</ns3:message>
    <ns3:name xml:lang="en">component membership shape sparqlconstraint 03</ns3:name>
    <ns3:select>
      PREFIX modinst: &lt;https://w3id.org/modavis/ontology/instrument#&gt;
      SELECT $this WHERE {
        $this modinst:membershipInstrument ?instrument ;
              modinst:appliesInState ?state .
        FILTER NOT EXISTS { ?state modinst:stateOf ?instrument . }
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-SPARQLConstraint-04">
    <ns2:label xml:lang="en">component membership shape sparqlconstraint 04</ns2:label>
    <ns3:message xml:lang="en">A hasMembership discovery link must originate from the membership instrument or recorded parent component.</ns3:message>
    <ns3:name xml:lang="en">component membership shape sparqlconstraint 04</ns3:name>
    <ns3:select>
      PREFIX modinst: &lt;https://w3id.org/modavis/ontology/instrument#&gt;
      SELECT $this WHERE {
        ?owner modinst:hasMembership $this .
        FILTER NOT EXISTS { $this modinst:membershipInstrument ?owner . }
        FILTER NOT EXISTS { $this modinst:parentComponent ?owner . }
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-appliesInConfiguration-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">applies in configuration property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/instrument#InstrumentConfiguration" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Applies in configuration constraint: at most 1 value(s) are permitted; values must be instances of InstrumentConfiguration.</ns3:message>
    <ns3:name xml:lang="en">applies in configuration property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/instrument#appliesInConfiguration" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-appliesInState-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">applies in state property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/instrument#InstrumentState" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Applies in state constraint: at most 1 value(s) are permitted; values must be instances of InstrumentState.</ns3:message>
    <ns3:name xml:lang="en">applies in state property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/instrument#appliesInState" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-childComponent-PropertyShape-03">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">child component property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/instrument#InstrumentComponent" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Child component constraint: exactly 1 value(s) are required; values must be instances of InstrumentComponent.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">child component property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/instrument#childComponent" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-membershipInstrument-PropertyShape-04">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">membership instrument property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/instrument#MusicalInstrument" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Membership instrument constraint: exactly 1 value(s) are required; values must be instances of MusicalInstrument.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">membership instrument property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/instrument#membershipInstrument" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-membershipType-PropertyShape-05">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">membership type property constraint</ns2:label>
    <ns3:in rdf:nodeID="cb9326f9c1d007abcc0f74b9eda5e74acd885b420e95781e7d10d4d7e29688afc4" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Membership type constraint: exactly 1 value(s) are required; values must have node kind IRI; values must belong to the enumerated release set.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">membership type property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/instrument#membershipType" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-parentComponent-PropertyShape-06">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">parent component property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/instrument#InstrumentComponent" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Parent component constraint: at most 1 value(s) are permitted; values must be instances of InstrumentComponent.</ns3:message>
    <ns3:name xml:lang="en">parent component property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/instrument#parentComponent" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ConflictDecisionShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">conflict decision shape</ns2:label>
    <ns3:name xml:lang="en">conflict decision shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ConflictDecisionShape-chosenAssertion-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ConflictDecisionShape-decidedBy-PropertyShape-02" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ConflictDecisionShape-decisionFor-PropertyShape-03" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ConflictDecisionShape-decisionRationale-PropertyShape-04" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ConflictDecisionShape-SPARQLConstraint-01" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/assertion#ConflictDecision" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ConflictDecisionShape-SPARQLConstraint-01">
    <ns2:label xml:lang="en">conflict decision shape sparqlconstraint 01</ns2:label>
    <ns3:message xml:lang="en">A chosen assertion must be a member of the conflict set addressed by the decision.</ns3:message>
    <ns3:name xml:lang="en">conflict decision shape sparqlconstraint 01</ns3:name>
    <ns3:select>
      PREFIX modassert: &lt;https://w3id.org/modavis/ontology/assertion#&gt;
      SELECT $this WHERE {
        $this modassert:decisionFor ?conflict ; modassert:chosenAssertion ?chosen .
        FILTER NOT EXISTS { ?conflict modassert:hasConflictMember ?chosen . }
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ConflictDecisionShape-chosenAssertion-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">chosen assertion property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/assertion#Assertion" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Chosen assertion constraint: at most 1 value(s) are permitted; values must be instances of Assertion.</ns3:message>
    <ns3:name xml:lang="en">chosen assertion property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/assertion#chosenAssertion" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ConflictDecisionShape-decidedBy-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">decided by property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/core#Agent" />
    <ns3:message xml:lang="en">Decided by constraint: at least 1 value(s) are required; values must be instances of Agent; values must have node kind IRI.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">decided by property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/assertion#decidedBy" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ConflictDecisionShape-decisionFor-PropertyShape-03">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">decision for property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/assertion#ConflictSet" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Decision for constraint: exactly 1 value(s) are required; values must be instances of ConflictSet.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">decision for property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/assertion#decisionFor" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ConflictDecisionShape-decisionRationale-PropertyShape-04">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">decision rationale property constraint</ns2:label>
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Decision rationale constraint: exactly 1 value(s) are required; lexical length must be at least 1.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:minLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minLength>
    <ns3:name xml:lang="en">decision rationale property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/assertion#decisionRationale" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ConflictSetShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">conflict set shape</ns2:label>
    <ns3:name xml:lang="en">conflict set shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ConflictSetShape-conflictCriterion-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ConflictSetShape-hasConflictMember-PropertyShape-02" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/assertion#ConflictSet" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ConflictSetShape-conflictCriterion-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">conflict criterion property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/assertion#ConflictCriterion" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A conflict set requires one identified criterion explaining why its member assertions cannot all be accepted.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">conflict criterion property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/assertion#conflictCriterion" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ConflictSetShape-hasConflictMember-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">has conflict member property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/assertion#Assertion" />
    <ns3:message xml:lang="en">Has conflict member constraint: at least 2 value(s) are required; values must be instances of Assertion.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</ns3:minCount>
    <ns3:name xml:lang="en">has conflict member property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/assertion#hasConflictMember" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ContextBindingShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">context binding shape</ns2:label>
    <ns3:message xml:lang="en">The focus node must satisfy the named logical, node-kind, or lexical constraint declared by this shape.</ns3:message>
    <ns3:name xml:lang="en">context binding shape</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ContextBindingShape-contextRelation-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ContextBindingShape-contextValue-PropertyShape-02" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ContextBindingShape-contextualizesAssertion-PropertyShape-03" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ContextBindingShape-dimension-PropertyShape-04" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ContextBindingShape-SPARQLConstraint-01" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/context#ContextBinding" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ContextBindingShape-SPARQLConstraint-01">
    <ns2:label xml:lang="en">context binding shape sparqlconstraint 01</ns2:label>
    <ns3:message xml:lang="en">Every context binding linked from an assertion must identify that same assertion.</ns3:message>
    <ns3:name xml:lang="en">context binding shape sparqlconstraint 01</ns3:name>
    <ns3:select>
      PREFIX modcontext: &lt;https://w3id.org/modavis/ontology/context#&gt;
      SELECT $this WHERE {
        ?assertion modcontext:hasContextBinding $this .
        FILTER NOT EXISTS { $this modcontext:contextualizesAssertion ?assertion . }
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ContextBindingShape-contextRelation-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">context relation property constraint</ns2:label>
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Context relation constraint: exactly 1 value(s) are required; values must have node kind IRI.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">context relation property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/context#contextRelation" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ContextBindingShape-contextValue-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">context value property constraint</ns2:label>
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Context value constraint: exactly 1 value(s) are required; values must have node kind IRI.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">context value property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/context#contextValue" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ContextBindingShape-contextualizesAssertion-PropertyShape-03">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">contextualizes assertion property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/assertion#Assertion" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Contextualizes assertion constraint: exactly 1 value(s) are required; values must be instances of Assertion.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">contextualizes assertion property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/context#contextualizesAssertion" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ContextBindingShape-dimension-PropertyShape-04">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">dimension property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/context#ContextDimension" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Dimension constraint: exactly 1 value(s) are required; values must be instances of ContextDimension.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">dimension property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/context#dimension" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ContextDimensionShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">context dimension shape</ns2:label>
    <ns3:message xml:lang="en">The focus node must satisfy the named logical, node-kind, or lexical constraint declared by this shape.</ns3:message>
    <ns3:name xml:lang="en">context dimension shape</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ContextDimensionShape-valueModel-PropertyShape-01" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/context#ContextDimension" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ContextDimensionShape-valueModel-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">value model property constraint</ns2:label>
    <ns3:message xml:lang="en">Value model constraint: values must have node kind IRI.</ns3:message>
    <ns3:name xml:lang="en">value model property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/context#valueModel" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#CuratedKnowledgeCollectionShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">curated knowledge collection shape</ns2:label>
    <ns3:name xml:lang="en">curated knowledge collection shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#CuratedKnowledgeCollectionShape-curatedBy-PropertyShape-02" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#CuratedKnowledgeCollectionShape-currentSnapshot-PropertyShape-04" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#CuratedKnowledgeCollectionShape-documentsResource-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#CuratedKnowledgeCollectionShape-hasKnowledgeSnapshot-PropertyShape-03" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#CuratedKnowledgeCollectionShape-SPARQLConstraint-01" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#CuratedKnowledgeCollectionShape-SPARQLConstraint-02" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/heritage#CuratedKnowledgeCollection" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#CuratedKnowledgeCollectionShape-SPARQLConstraint-01">
    <ns2:label xml:lang="en">curated knowledge collection shape sparqlconstraint 01</ns2:label>
    <ns2:label xml:lang="en">current snapshot membership constraint</ns2:label>
    <ns3:message xml:lang="en">The current snapshot must also be explicitly retained by the curated knowledge collection.</ns3:message>
    <ns3:name xml:lang="en">curated knowledge collection shape sparqlconstraint 01</ns3:name>
    <ns3:name xml:lang="en">current snapshot membership constraint</ns3:name>
    <ns3:select>
    PREFIX modheritage: &lt;https://w3id.org/modavis/ontology/heritage#&gt;
    SELECT $this WHERE {
      $this modheritage:currentSnapshot ?snapshot .
      FILTER NOT EXISTS { $this modheritage:hasKnowledgeSnapshot ?snapshot . }
    }
  </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#CuratedKnowledgeCollectionShape-SPARQLConstraint-02">
    <ns2:label xml:lang="en">curated knowledge collection shape sparqlconstraint 02</ns2:label>
    <ns2:label xml:lang="en">retained snapshot backlink constraint</ns2:label>
    <ns3:message xml:lang="en">Every retained snapshot must identify the same curated knowledge collection through snapshotOfCollection.</ns3:message>
    <ns3:name xml:lang="en">curated knowledge collection shape sparqlconstraint 02</ns3:name>
    <ns3:name xml:lang="en">retained snapshot backlink constraint</ns3:name>
    <ns3:select>
    PREFIX modheritage: &lt;https://w3id.org/modavis/ontology/heritage#&gt;
    SELECT $this WHERE {
      $this modheritage:hasKnowledgeSnapshot ?snapshot .
      FILTER NOT EXISTS { ?snapshot modheritage:snapshotOfCollection $this . }
    }
  </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#CuratedKnowledgeCollectionShape-curatedBy-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">collection curator property constraint</ns2:label>
    <ns2:label xml:lang="en">curated by property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/core#Agent" />
    <ns3:message xml:lang="en">A curated knowledge collection must identify at least one accountable curator.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">collection curator property constraint</ns3:name>
    <ns3:name xml:lang="en">curated by property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/heritage#curatedBy" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#CuratedKnowledgeCollectionShape-currentSnapshot-PropertyShape-04">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">current knowledge snapshot property constraint</ns2:label>
    <ns2:label xml:lang="en">current snapshot property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/heritage#KnowledgeSnapshot" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A curated knowledge collection must identify exactly one retained snapshot as current.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">current knowledge snapshot property constraint</ns3:name>
    <ns3:name xml:lang="en">current snapshot property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/heritage#currentSnapshot" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#CuratedKnowledgeCollectionShape-documentsResource-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">documented resource property constraint</ns2:label>
    <ns2:label xml:lang="en">documents resource property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/core#IdentifiedResource" />
    <ns3:message xml:lang="en">A curated knowledge collection must identify at least one documentary subject.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">documented resource property constraint</ns3:name>
    <ns3:name xml:lang="en">documents resource property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/heritage#documentsResource" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#CuratedKnowledgeCollectionShape-hasKnowledgeSnapshot-PropertyShape-03">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">has knowledge snapshot property constraint</ns2:label>
    <ns2:label xml:lang="en">retained knowledge snapshot property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/heritage#KnowledgeSnapshot" />
    <ns3:message xml:lang="en">A curated knowledge collection must retain at least one fixed knowledge snapshot.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">has knowledge snapshot property constraint</ns3:name>
    <ns3:name xml:lang="en">retained knowledge snapshot property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/heritage#hasKnowledgeSnapshot" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#DigitalAssetShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">digital asset shape</ns2:label>
    <ns3:name xml:lang="en">digital asset shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#DigitalAssetShape-contentUrl-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#DigitalAssetShape-derivedFrom-PropertyShape-02" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#DigitalAssetShape-generatedBy-PropertyShape-03" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#DigitalAssetShape-mediaType-PropertyShape-04" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#DigitalAssetShape-SPARQLConstraint-01" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/media#DigitalAsset" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#DigitalAssetShape-SPARQLConstraint-01">
    <ns2:label xml:lang="en">digital asset shape sparqlconstraint 01</ns2:label>
    <ns3:message xml:lang="en">A digital-asset derivation chain cannot contain a cycle.</ns3:message>
    <ns3:name xml:lang="en">digital asset shape sparqlconstraint 01</ns3:name>
    <ns3:select>
      PREFIX modmedia: &lt;https://w3id.org/modavis/ontology/media#&gt;
      SELECT $this WHERE { $this modmedia:derivedFrom+ $this . }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#DigitalAssetShape-contentUrl-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">content url property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI" />
    <ns3:message xml:lang="en">A content URL must be an absolute xsd:anyURI value.</ns3:message>
    <ns3:name xml:lang="en">content url property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/media#contentUrl" />
    <ns3:pattern>^[A-Za-z][A-Za-z0-9+.-]*:</ns3:pattern>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#DigitalAssetShape-derivedFrom-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">derived from property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/media#DigitalAsset" />
    <ns3:message xml:lang="en">Derived from constraint: values must be instances of DigitalAsset.</ns3:message>
    <ns3:name xml:lang="en">derived from property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/media#derivedFrom" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#DigitalAssetShape-generatedBy-PropertyShape-03">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">generated by property constraint</ns2:label>
    <ns3:class rdf:resource="http://www.w3.org/ns/prov#Activity" />
    <ns3:message xml:lang="en">Generated by constraint: values must be instances of Activity.</ns3:message>
    <ns3:name xml:lang="en">generated by property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/media#generatedBy" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#DigitalAssetShape-mediaType-PropertyShape-04">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">media type property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A media type must be a lowercase type/subtype token, with optional parameters.</ns3:message>
    <ns3:name xml:lang="en">media type property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/media#mediaType" />
    <ns3:pattern>^[a-z0-9!#$&amp;^_.+-]+/[a-z0-9!#$&amp;^_.+-]+(?:\s*;.*)?$</ns3:pattern>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#DigitalRepresentationShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">digital representation shape</ns2:label>
    <ns3:name xml:lang="en">digital representation shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#DigitalRepresentationShape-representationStatus-PropertyShape-01" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/media#DigitalRepresentation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#DigitalRepresentationShape-representationStatus-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">representation status property constraint</ns2:label>
    <ns3:in rdf:nodeID="cb113a8eb9908ca908ab1822808fcd1d95968c2fe51eae4a20c4ed05900e0d08a06" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A digital representation requires exactly one governed representation-status concept IRI.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">representation status property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/media#representationStatus" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#EventRecordShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">event record shape</ns2:label>
    <ns3:name xml:lang="en">event record shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#EventRecordShape-describesEvent-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#EventRecordShape-generatedBy-PropertyShape-02" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/events#EventRecord" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#EventRecordShape-describesEvent-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">describes event property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/events#Event" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Describes event constraint: exactly 1 value(s) are required; values must be instances of Event.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">describes event property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/events#describesEvent" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#EventRecordShape-generatedBy-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">generated by property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/provenance#ProcessingActivity" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Generated by constraint: exactly 1 value(s) are required; values must be instances of ProcessingActivity.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">generated by property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/events#generatedBy" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#EvidenceRelationShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">evidence relation shape</ns2:label>
    <ns3:name xml:lang="en">evidence relation shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#EvidenceRelationShape-evaluates-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#EvidenceRelationShape-evidenceRole-PropertyShape-02" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#EvidenceRelationShape-extractionConfidence-PropertyShape-03" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#EvidenceRelationShape-usesFragment-PropertyShape-04" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/evidence#EvidenceRelation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#EvidenceRelationShape-evaluates-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">evaluates property constraint</ns2:label>
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A qualified evidence relation evaluates exactly one identified target; create separate relations for separate targets.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">evaluates property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/evidence#evaluates" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#EvidenceRelationShape-evidenceRole-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">evidence role property constraint</ns2:label>
    <ns3:in rdf:nodeID="cb12e13c61b46606668b9e4669c193b150f620a81a7a0205a051b5cd9bf8ce28f6b" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Evidence role constraint: exactly 1 value(s) are required; values must have node kind IRI; values must belong to the enumerated release set.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">evidence role property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/evidence#evidenceRole" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#EvidenceRelationShape-extractionConfidence-PropertyShape-03">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">extraction confidence property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxInclusive>
    <ns3:message xml:lang="en">Extraction confidence constraint: at most 1 value(s) are permitted; values must use the decimal datatype; value must be at least 0; value must be at most 1.</ns3:message>
    <ns3:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</ns3:minInclusive>
    <ns3:name xml:lang="en">extraction confidence property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/evidence#extractionConfidence" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#EvidenceRelationShape-usesFragment-PropertyShape-04">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">uses fragment property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/evidence#SourceFragment" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Uses fragment constraint: exactly 1 value(s) are required; values must be instances of SourceFragment.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">uses fragment property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/evidence#usesFragment" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#FunctionalRoleAssignmentShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">functional role assignment shape</ns2:label>
    <ns3:name xml:lang="en">functional role assignment shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#FunctionalRoleAssignmentShape-appliesInConfiguration-PropertyShape-02" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#FunctionalRoleAssignmentShape-appliesInState-PropertyShape-03" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#FunctionalRoleAssignmentShape-assignedRole-PropertyShape-04" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#FunctionalRoleAssignmentShape-roleOfComponent-PropertyShape-05" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#FunctionalRoleAssignmentShape-validDuring-PropertyShape-01" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#FunctionalRoleAssignmentShape-SPARQLConstraint-01" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/instrument#FunctionalRoleAssignment" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#FunctionalRoleAssignmentShape-SPARQLConstraint-01">
    <ns2:label xml:lang="en">functional role assignment shape sparqlconstraint 01</ns2:label>
    <ns3:message xml:lang="en">A role assignment's state and configuration qualifiers must concern the same musical instrument.</ns3:message>
    <ns3:name xml:lang="en">functional role assignment shape sparqlconstraint 01</ns3:name>
    <ns3:select>
      PREFIX modinst: &lt;https://w3id.org/modavis/ontology/instrument#&gt;
      SELECT $this WHERE {
        $this modinst:appliesInConfiguration ?configuration ;
              modinst:appliesInState ?state .
        ?configuration modinst:configurationOf ?configurationInstrument .
        ?state modinst:stateOf ?stateInstrument .
        FILTER (?configurationInstrument != ?stateInstrument)
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#FunctionalRoleAssignmentShape-appliesInConfiguration-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">applies in configuration property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/instrument#InstrumentConfiguration" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Applies in configuration constraint: at most 1 value(s) are permitted; values must be instances of InstrumentConfiguration.</ns3:message>
    <ns3:name xml:lang="en">applies in configuration property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/instrument#appliesInConfiguration" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#FunctionalRoleAssignmentShape-appliesInState-PropertyShape-03">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">applies in state property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/instrument#InstrumentState" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Applies in state constraint: at most 1 value(s) are permitted; values must be instances of InstrumentState.</ns3:message>
    <ns3:name xml:lang="en">applies in state property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/instrument#appliesInState" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#FunctionalRoleAssignmentShape-assignedRole-PropertyShape-04">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">assigned role property constraint</ns2:label>
    <ns3:in rdf:nodeID="cb78c331ed11e270a1d7651c2d45c5549b5cedb153559a06d3c62d5cc277b7fd50" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Assigned role constraint: exactly 1 value(s) are required; values must have node kind IRI; values must belong to the enumerated release set.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">assigned role property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/instrument#assignedRole" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#FunctionalRoleAssignmentShape-roleOfComponent-PropertyShape-05">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">role of component property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/instrument#InstrumentComponent" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Role of component constraint: exactly 1 value(s) are required; values must be instances of InstrumentComponent.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">role of component property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/instrument#roleOfComponent" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#FunctionalRoleAssignmentShape-validDuring-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">valid during property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/core#TimeSpan" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Valid during constraint: at most 1 value(s) are permitted; values must be instances of TimeSpan.</ns3:message>
    <ns3:name xml:lang="en">valid during property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/core#validDuring" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">heritage recognition shape</ns2:label>
    <ns3:name xml:lang="en">heritage recognition shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-hasEvidenceRelation-PropertyShape-07" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-recognitionAssignedBy-PropertyShape-02" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-recognitionBasis-PropertyShape-03" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-recognitionRecordedBy-PropertyShape-06" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-recognitionStatus-PropertyShape-04" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-recognizesResource-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-supersedesRecognition-PropertyShape-08" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-validDuring-PropertyShape-05" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-SPARQLConstraint-01" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-SPARQLConstraint-02" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-SPARQLConstraint-03" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/heritage#HeritageRecognition" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-SPARQLConstraint-01">
    <ns2:label xml:lang="en">heritage recognition evidence consistency constraint</ns2:label>
    <ns2:label xml:lang="en">heritage recognition shape sparqlconstraint 01</ns2:label>
    <ns3:message xml:lang="en">Every heritage-recognition evidence relation must identify that recognition as the resource it evaluates.</ns3:message>
    <ns3:name xml:lang="en">heritage recognition evidence consistency constraint</ns3:name>
    <ns3:name xml:lang="en">heritage recognition shape sparqlconstraint 01</ns3:name>
    <ns3:select>
    PREFIX modevidence: &lt;https://w3id.org/modavis/ontology/evidence#&gt;
    PREFIX modheritage: &lt;https://w3id.org/modavis/ontology/heritage#&gt;
    SELECT $this WHERE {
      $this modheritage:hasEvidenceRelation ?relation .
      FILTER NOT EXISTS { ?relation modevidence:evaluates $this . }
    }
  </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-SPARQLConstraint-02">
    <ns2:label xml:lang="en">heritage recognition shape sparqlconstraint 02</ns2:label>
    <ns2:label xml:lang="en">heritage recognition supersession cycle constraint</ns2:label>
    <ns3:message xml:lang="en">A heritage-recognition supersession chain cannot contain a cycle.</ns3:message>
    <ns3:name xml:lang="en">heritage recognition shape sparqlconstraint 02</ns3:name>
    <ns3:name xml:lang="en">heritage recognition supersession cycle constraint</ns3:name>
    <ns3:select>
    PREFIX modheritage: &lt;https://w3id.org/modavis/ontology/heritage#&gt;
    SELECT $this WHERE { $this modheritage:supersedesRecognition+ $this . }
  </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-SPARQLConstraint-03">
    <ns2:label xml:lang="en">heritage recognition shape sparqlconstraint 03</ns2:label>
    <ns2:label xml:lang="en">heritage recognition supersession subject constraint</ns2:label>
    <ns3:message xml:lang="en">A heritage recognition may supersede only a recognition of the same resource.</ns3:message>
    <ns3:name xml:lang="en">heritage recognition shape sparqlconstraint 03</ns3:name>
    <ns3:name xml:lang="en">heritage recognition supersession subject constraint</ns3:name>
    <ns3:select>
    PREFIX modheritage: &lt;https://w3id.org/modavis/ontology/heritage#&gt;
    SELECT $this WHERE {
      $this modheritage:recognizesResource ?resource ;
            modheritage:supersedesRecognition ?earlier .
      FILTER NOT EXISTS { ?earlier modheritage:recognizesResource ?resource . }
    }
  </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-hasEvidenceRelation-PropertyShape-07">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">has evidence relation property constraint</ns2:label>
    <ns2:label xml:lang="en">heritage recognition evidence property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/evidence#EvidenceRelation" />
    <ns3:message xml:lang="en">A heritage recognition must cite at least one qualified evidence relation.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">has evidence relation property constraint</ns3:name>
    <ns3:name xml:lang="en">heritage recognition evidence property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/heritage#hasEvidenceRelation" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-recognitionAssignedBy-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">recognition assigned by property constraint</ns2:label>
    <ns2:label xml:lang="en">recognition assigning agent property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/core#Agent" />
    <ns3:message xml:lang="en">A heritage recognition must identify at least one accountable assigning agent.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">recognition assigned by property constraint</ns3:name>
    <ns3:name xml:lang="en">recognition assigning agent property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/heritage#recognitionAssignedBy" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-recognitionBasis-PropertyShape-03">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">recognition basis property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/core#IdentifiedResource" />
    <ns3:message xml:lang="en">A heritage recognition must identify at least one citable criterion, policy, register, or other basis.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">recognition basis property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/heritage#recognitionBasis" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-recognitionRecordedBy-PropertyShape-06">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">recognition recorded by property constraint</ns2:label>
    <ns2:label xml:lang="en">recognition recording activity property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/provenance#ProcessingActivity" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A heritage recognition must identify exactly one activity that created the MODAVIS record.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">recognition recorded by property constraint</ns3:name>
    <ns3:name xml:lang="en">recognition recording activity property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/heritage#recognitionRecordedBy" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-recognitionStatus-PropertyShape-04">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">recognition status property constraint</ns2:label>
    <ns3:in rdf:nodeID="cbe0397f159f5dffb6c3ceb7170dd63c99ff649468f97e0d07b8bdecc1c0dbcca1" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A heritage recognition must use exactly one status from the governed MODAVIS recognition-status scheme.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">recognition status property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/heritage#recognitionStatus" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-recognizesResource-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">recognized resource property constraint</ns2:label>
    <ns2:label xml:lang="en">recognizes resource property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/core#IdentifiedResource" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A heritage recognition must identify exactly one recognized resource IRI.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">recognized resource property constraint</ns3:name>
    <ns3:name xml:lang="en">recognizes resource property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/heritage#recognizesResource" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-supersedesRecognition-PropertyShape-08">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">superseded recognition property constraint</ns2:label>
    <ns2:label xml:lang="en">supersedes recognition property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/heritage#HeritageRecognition" />
    <ns3:message xml:lang="en">A superseded recognition must be another heritage recognition.</ns3:message>
    <ns3:name xml:lang="en">superseded recognition property constraint</ns3:name>
    <ns3:name xml:lang="en">supersedes recognition property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/heritage#supersedesRecognition" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-validDuring-PropertyShape-05">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">recognition validity property constraint</ns2:label>
    <ns2:label xml:lang="en">valid during property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/core#TimeSpan" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A heritage recognition must carry exactly one explicit validity time span.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">recognition validity property constraint</ns3:name>
    <ns3:name xml:lang="en">valid during property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/core#validDuring" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#HistoricalClaimReviewShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">historical claim review shape</ns2:label>
    <ns3:name xml:lang="en">historical claim review shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#HistoricalClaimReviewShape-producesAssertion-PropertyShape-03" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#HistoricalClaimReviewShape-reviewRationale-PropertyShape-04" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#HistoricalClaimReviewShape-reviewSubject-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#HistoricalClaimReviewShape-reviewsAssertion-PropertyShape-02" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#HistoricalClaimReviewShape-SPARQLConstraint-01" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#HistoricalClaimReviewShape-SPARQLConstraint-02" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/heritage#HistoricalClaimReview" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#HistoricalClaimReviewShape-SPARQLConstraint-01">
    <ns2:label xml:lang="en">historical claim review shape sparqlconstraint 01</ns2:label>
    <ns2:label xml:lang="en">historical claim review subject consistency constraint</ns2:label>
    <ns3:message xml:lang="en">Every input and conclusion assertion in a historical claim review must assert about the review subject.</ns3:message>
    <ns3:name xml:lang="en">historical claim review shape sparqlconstraint 01</ns3:name>
    <ns3:name xml:lang="en">historical claim review subject consistency constraint</ns3:name>
    <ns3:select>
    PREFIX modassert: &lt;https://w3id.org/modavis/ontology/assertion#&gt;
    PREFIX modheritage: &lt;https://w3id.org/modavis/ontology/heritage#&gt;
    SELECT $this WHERE {
      $this modheritage:reviewSubject ?subject .
      $this (modheritage:reviewsAssertion|modheritage:producesAssertion) ?assertion .
      FILTER NOT EXISTS { ?assertion modassert:assertsSubject ?subject . }
    }
  </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#HistoricalClaimReviewShape-SPARQLConstraint-02">
    <ns2:label xml:lang="en">historical claim review conclusion lineage constraint</ns2:label>
    <ns2:label xml:lang="en">historical claim review shape sparqlconstraint 02</ns2:label>
    <ns3:message xml:lang="en">The conclusion must be distinct from every input assertion and must identify the historical claim review as its generating activity.</ns3:message>
    <ns3:name xml:lang="en">historical claim review conclusion lineage constraint</ns3:name>
    <ns3:name xml:lang="en">historical claim review shape sparqlconstraint 02</ns3:name>
    <ns3:select>
    PREFIX modassert: &lt;https://w3id.org/modavis/ontology/assertion#&gt;
    PREFIX modheritage: &lt;https://w3id.org/modavis/ontology/heritage#&gt;
    SELECT $this WHERE {
      $this modheritage:producesAssertion ?conclusion .
      FILTER (
        EXISTS { $this modheritage:reviewsAssertion ?conclusion } ||
        NOT EXISTS { ?conclusion modassert:generatedBy $this }
      )
    }
  </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#HistoricalClaimReviewShape-producesAssertion-PropertyShape-03">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">historical review conclusion property constraint</ns2:label>
    <ns2:label xml:lang="en">produces assertion property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/assertion#Assertion" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A historical claim review must identify exactly one distinct conclusion assertion.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">historical review conclusion property constraint</ns3:name>
    <ns3:name xml:lang="en">produces assertion property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/heritage#producesAssertion" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#HistoricalClaimReviewShape-reviewRationale-PropertyShape-04">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">historical review rationale property constraint</ns2:label>
    <ns2:label xml:lang="en">review rationale property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A historical claim review must record exactly one non-empty xsd:string rationale.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:minLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minLength>
    <ns3:name xml:lang="en">historical review rationale property constraint</ns3:name>
    <ns3:name xml:lang="en">review rationale property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/heritage#reviewRationale" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#HistoricalClaimReviewShape-reviewSubject-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">historical claim review subject property constraint</ns2:label>
    <ns2:label xml:lang="en">review subject property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/core#IdentifiedResource" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A historical claim review must identify exactly one reviewed subject.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">historical claim review subject property constraint</ns3:name>
    <ns3:name xml:lang="en">review subject property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/heritage#reviewSubject" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#HistoricalClaimReviewShape-reviewsAssertion-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">reviewed historical assertion property constraint</ns2:label>
    <ns2:label xml:lang="en">reviews assertion property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/assertion#Assertion" />
    <ns3:message xml:lang="en">A historical claim review must identify at least one input assertion.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">reviewed historical assertion property constraint</ns3:name>
    <ns3:name xml:lang="en">reviews assertion property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/heritage#reviewsAssertion" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#IdentifiedResourceShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">identified resource shape</ns2:label>
    <ns3:message xml:lang="en">An identified resource must have an IRI. Stable HTTP IRIs provide normative MODAVIS identity; legacy MDVS v1 strings are optional compatibility data.</ns3:message>
    <ns3:name xml:lang="en">identified resource shape</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#IdentifiedResourceShape-canonicalLabel-PropertyShape-01" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/core#IdentifiedResource" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#IdentifiedResourceShape-canonicalLabel-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">canonical label property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString" />
    <ns3:message xml:lang="en">Canonical label constraint: values must use the langString datatype; at most one value is permitted per language.</ns3:message>
    <ns3:name xml:lang="en">canonical label property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/core#canonicalLabel" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:uniqueLang rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns3:uniqueLang>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#IdentifierShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">identifier shape</ns2:label>
    <ns3:name xml:lang="en">identifier shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#IdentifierShape-identifierScheme-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#IdentifierShape-identifierValue-PropertyShape-02" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/core#Identifier" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#IdentifierShape-identifierScheme-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">identifier scheme property constraint</ns2:label>
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A reified identifier requires exactly one identified assigning scheme.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">identifier scheme property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/core#identifierScheme" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#IdentifierShape-identifierValue-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">identifier value property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A reified identifier requires one non-empty lexical value.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:minLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minLength>
    <ns3:name xml:lang="en">identifier value property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/core#identifierValue" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentComponentShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">instrument component shape</ns2:label>
    <ns3:name xml:lang="en">instrument component shape</ns3:name>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/instrument#InstrumentComponent" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentConfigurationShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">instrument configuration shape</ns2:label>
    <ns3:name xml:lang="en">instrument configuration shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentConfigurationShape-configurationOf-PropertyShape-01" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentConfigurationShape-SPARQLConstraint-01" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/instrument#InstrumentConfiguration" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentConfigurationShape-SPARQLConstraint-01">
    <ns2:label xml:lang="en">instrument configuration shape sparqlconstraint 01</ns2:label>
    <ns3:message xml:lang="en">A hasConfiguration link must originate from the configuration's instrument or from a state of that instrument.</ns3:message>
    <ns3:name xml:lang="en">instrument configuration shape sparqlconstraint 01</ns3:name>
    <ns3:select>
      PREFIX modinst: &lt;https://w3id.org/modavis/ontology/instrument#&gt;
      SELECT $this WHERE {
        $this modinst:configurationOf ?instrument .
        ?owner modinst:hasConfiguration $this .
        FILTER (?owner != ?instrument)
        FILTER NOT EXISTS { ?owner modinst:stateOf ?instrument . }
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentConfigurationShape-configurationOf-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">configuration of property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/instrument#MusicalInstrument" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">An instrument configuration requires exactly one instrument for which it is defined.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">configuration of property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/instrument#configurationOf" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentIdentityLayerShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">instrument identity layer shape</ns2:label>
    <ns3:name xml:lang="en">instrument identity layer shape</ns3:name>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentIdentityLayerShape-SPARQLConstraint-01" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/instrument#InstrumentConfiguration" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/instrument#InstrumentState" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/instrument#MusicalInstrument" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentIdentityLayerShape-SPARQLConstraint-01">
    <ns2:label xml:lang="en">instrument identity layer shape sparqlconstraint 01</ns2:label>
    <ns3:message xml:lang="en">A resource cannot occupy more than one of the distinct musical-instrument, instrument-state, and instrument-configuration identity layers.</ns3:message>
    <ns3:name xml:lang="en">instrument identity layer shape sparqlconstraint 01</ns3:name>
    <ns3:select>
      PREFIX modinst: &lt;https://w3id.org/modavis/ontology/instrument#&gt;
      PREFIX rdfs: &lt;http://www.w3.org/2000/01/rdf-schema#&gt;
      SELECT DISTINCT $this WHERE {
        $this a ?leftType, ?rightType .
        ?leftType rdfs:subClassOf* ?leftLayer .
        ?rightType rdfs:subClassOf* ?rightLayer .
        FILTER (?leftLayer IN (
          modinst:MusicalInstrument,
          modinst:InstrumentState,
          modinst:InstrumentConfiguration
        ))
        FILTER (?rightLayer IN (
          modinst:MusicalInstrument,
          modinst:InstrumentState,
          modinst:InstrumentConfiguration
        ))
        FILTER (?leftLayer != ?rightLayer)
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">instrument source relation shape</ns2:label>
    <ns3:name xml:lang="en">instrument source relation shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-hasEvidenceRelation-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-sourceConfidence-PropertyShape-02" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-sourceInstrument-PropertyShape-03" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-sourceRelationSubject-PropertyShape-04" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-sourceRelationType-PropertyShape-05" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-sourceState-PropertyShape-06" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-SPARQLConstraint-01" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-SPARQLConstraint-02" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/virtual-instrument#InstrumentSourceRelation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-SPARQLConstraint-01">
    <ns2:label xml:lang="en">instrument source relation shape sparqlconstraint 01</ns2:label>
    <ns3:message xml:lang="en">A source state must be a state of the source instrument named by the same relation.</ns3:message>
    <ns3:name xml:lang="en">instrument source relation shape sparqlconstraint 01</ns3:name>
    <ns3:select>
      PREFIX modinst: &lt;https://w3id.org/modavis/ontology/instrument#&gt;
      PREFIX modvmi: &lt;https://w3id.org/modavis/ontology/virtual-instrument#&gt;
      SELECT $this WHERE {
        $this modvmi:sourceInstrument ?instrument ; modvmi:sourceState ?state .
        FILTER NOT EXISTS { ?state modinst:stateOf ?instrument . }
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-SPARQLConstraint-02">
    <ns2:label xml:lang="en">instrument source relation shape sparqlconstraint 02</ns2:label>
    <ns3:message xml:lang="en">Every source-relation evidence relation must identify the source relation it evaluates.</ns3:message>
    <ns3:name xml:lang="en">instrument source relation shape sparqlconstraint 02</ns3:name>
    <ns3:select>
      PREFIX modevidence: &lt;https://w3id.org/modavis/ontology/evidence#&gt;
      PREFIX modvmi: &lt;https://w3id.org/modavis/ontology/virtual-instrument#&gt;
      SELECT $this WHERE {
        $this modvmi:hasEvidenceRelation ?relation .
        FILTER NOT EXISTS { ?relation modevidence:evaluates $this . }
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-hasEvidenceRelation-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">has evidence relation property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/evidence#EvidenceRelation" />
    <ns3:message xml:lang="en">An accepted source relation requires at least one qualified evidence relation.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">has evidence relation property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/virtual-instrument#hasEvidenceRelation" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-or-Alternative-NodeShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">instrument source relation shape or alternative node shape 01</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/virtual-instrument#VirtualMusicalInstrument" />
    <ns3:name xml:lang="en">instrument source relation shape or alternative node shape 01</ns3:name>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-or-Alternative-NodeShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">instrument source relation shape or alternative node shape 02</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/virtual-instrument#VirtualInstrumentProduct" />
    <ns3:name xml:lang="en">instrument source relation shape or alternative node shape 02</ns3:name>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-or-Alternative-NodeShape-03">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">instrument source relation shape or alternative node shape 03</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/virtual-instrument#VirtualInstrumentVersion" />
    <ns3:name xml:lang="en">instrument source relation shape or alternative node shape 03</ns3:name>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-sourceConfidence-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">source confidence property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxInclusive>
    <ns3:message xml:lang="en">Source-relation confidence must be a decimal from zero through one.</ns3:message>
    <ns3:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</ns3:minInclusive>
    <ns3:name xml:lang="en">source confidence property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/virtual-instrument#sourceConfidence" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-sourceInstrument-PropertyShape-03">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">source instrument property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/instrument#MusicalInstrument" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A source relation must identify exactly one resource typed as a musical instrument.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">source instrument property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/virtual-instrument#sourceInstrument" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-sourceRelationSubject-PropertyShape-04">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">source relation subject property constraint</ns2:label>
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A source relation subject must be a playable virtual instrument, stable product, or version.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">source relation subject property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:or rdf:nodeID="cbe3504b53bd9676a81bb104b6956f570680ea1f2f818c11ea8b745dde39c2a3c7" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/virtual-instrument#sourceRelationSubject" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-sourceRelationType-PropertyShape-05">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">source relation type property constraint</ns2:label>
    <ns3:in rdf:nodeID="cbc5735fd45c3ca8d369c2946942f27eb64c2b84e41d1571f47209627e6ffd6d5f" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Source relation type constraint: exactly 1 value(s) are required; values must have node kind IRI; values must belong to the enumerated release set.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">source relation type property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/virtual-instrument#sourceRelationType" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-sourceState-PropertyShape-06">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">source state property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/instrument#InstrumentState" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A source state, when supplied, must be typed as an instrument state.</ns3:message>
    <ns3:name xml:lang="en">source state property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/virtual-instrument#sourceState" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentStateShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">instrument state shape</ns2:label>
    <ns3:name xml:lang="en">instrument state shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentStateShape-stateOf-PropertyShape-02" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentStateShape-validDuring-PropertyShape-01" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/instrument#InstrumentState" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentStateShape-stateOf-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">state of property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/instrument#MusicalInstrument" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">State of constraint: exactly 1 value(s) are required; values must be instances of MusicalInstrument.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">state of property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/instrument#stateOf" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentStateShape-validDuring-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">valid during property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/core#TimeSpan" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">An instrument state requires exactly one temporal extent; use distinct state resources for distinct extents.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">valid during property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/core#validDuring" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeIdentityBoundaryShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">knowledge identity boundary shape</ns2:label>
    <ns3:name xml:lang="en">knowledge identity boundary shape</ns3:name>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeIdentityBoundaryShape-SPARQLConstraint-01" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/heritage#CuratedKnowledgeCollection" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/heritage#KnowledgeSnapshot" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeIdentityBoundaryShape-SPARQLConstraint-01">
    <ns2:label xml:lang="en">knowledge identity boundary constraint</ns2:label>
    <ns2:label xml:lang="en">knowledge identity boundary shape sparqlconstraint 01</ns2:label>
    <ns3:message xml:lang="en">A curated knowledge collection or fixed knowledge snapshot cannot also be a musical instrument, digital asset, digital surrogate, virtual-instrument product, version, or package.</ns3:message>
    <ns3:name xml:lang="en">knowledge identity boundary constraint</ns3:name>
    <ns3:name xml:lang="en">knowledge identity boundary shape sparqlconstraint 01</ns3:name>
    <ns3:select>
    PREFIX modinst: &lt;https://w3id.org/modavis/ontology/instrument#&gt;
    PREFIX modmedia: &lt;https://w3id.org/modavis/ontology/media#&gt;
    PREFIX modvmi: &lt;https://w3id.org/modavis/ontology/virtual-instrument#&gt;
    PREFIX rdfs: &lt;http://www.w3.org/2000/01/rdf-schema#&gt;
    SELECT DISTINCT $this WHERE {
      $this a ?type .
      ?type rdfs:subClassOf* ?forbiddenLayer .
      FILTER (?forbiddenLayer IN (
        modinst:MusicalInstrument,
        modmedia:DigitalAsset,
        modmedia:DigitalSurrogate,
        modvmi:VirtualInstrumentProduct,
        modvmi:VirtualInstrumentVersion,
        modvmi:VirtualInstrumentPackage
      ))
    }
  </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">knowledge maintenance activity shape</ns2:label>
    <ns3:name xml:lang="en">knowledge maintenance activity shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-addedAssertion-PropertyShape-04" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-maintainedCollection-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-previousSnapshot-PropertyShape-02" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-removedAssertion-PropertyShape-05" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-resultingSnapshot-PropertyShape-03" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-SPARQLConstraint-01" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-SPARQLConstraint-02" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-SPARQLConstraint-03" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-SPARQLConstraint-04" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/heritage#KnowledgeMaintenanceActivity" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-SPARQLConstraint-01">
    <ns2:label xml:lang="en">knowledge maintenance activity shape sparqlconstraint 01</ns2:label>
    <ns2:label xml:lang="en">knowledge snapshot lineage consistency constraint</ns2:label>
    <ns3:message xml:lang="en">Previous and resulting snapshots must be distinct states of the maintained collection, and the resulting snapshot must identify this generating activity.</ns3:message>
    <ns3:name xml:lang="en">knowledge maintenance activity shape sparqlconstraint 01</ns3:name>
    <ns3:name xml:lang="en">knowledge snapshot lineage consistency constraint</ns3:name>
    <ns3:select>
    PREFIX modheritage: &lt;https://w3id.org/modavis/ontology/heritage#&gt;
    SELECT $this WHERE {
      $this modheritage:maintainedCollection ?collection ;
            modheritage:resultingSnapshot ?result .
      FILTER (
        NOT EXISTS { ?result modheritage:snapshotOfCollection ?collection } ||
        NOT EXISTS { ?result modheritage:snapshotCreatedBy $this } ||
        EXISTS { $this modheritage:previousSnapshot ?result } ||
        EXISTS {
          $this modheritage:previousSnapshot ?previous .
          FILTER NOT EXISTS { ?previous modheritage:snapshotOfCollection ?collection }
        }
      )
    }
  </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-SPARQLConstraint-02">
    <ns2:label xml:lang="en">knowledge maintenance activity shape sparqlconstraint 02</ns2:label>
    <ns2:label xml:lang="en">knowledge snapshot delta consistency constraint</ns2:label>
    <ns3:message xml:lang="en">The added and removed assertion lists must be non-empty as a combined delta and must exactly match the difference between the previous and resulting snapshots.</ns3:message>
    <ns3:name xml:lang="en">knowledge maintenance activity shape sparqlconstraint 02</ns3:name>
    <ns3:name xml:lang="en">knowledge snapshot delta consistency constraint</ns3:name>
    <ns3:select>
    PREFIX modheritage: &lt;https://w3id.org/modavis/ontology/heritage#&gt;
    SELECT $this WHERE {
      { FILTER NOT EXISTS { $this (modheritage:addedAssertion|modheritage:removedAssertion) ?change . } }
      UNION {
        $this modheritage:addedAssertion ?assertion ;
              modheritage:resultingSnapshot ?result .
        FILTER NOT EXISTS { ?result modheritage:includesAssertion ?assertion . }
      }
      UNION {
        $this modheritage:addedAssertion ?assertion ;
              modheritage:previousSnapshot ?previous .
        ?previous modheritage:includesAssertion ?assertion .
      }
      UNION {
        $this modheritage:removedAssertion ?assertion .
        FILTER NOT EXISTS {
          $this modheritage:previousSnapshot ?previous .
          ?previous modheritage:includesAssertion ?assertion .
        }
      }
      UNION {
        $this modheritage:removedAssertion ?assertion ;
              modheritage:resultingSnapshot ?result .
        ?result modheritage:includesAssertion ?assertion .
      }
      UNION {
        $this modheritage:resultingSnapshot ?result .
        ?result modheritage:includesAssertion ?assertion .
        FILTER NOT EXISTS {
          $this modheritage:previousSnapshot ?previous .
          ?previous modheritage:includesAssertion ?assertion .
        }
        FILTER NOT EXISTS { $this modheritage:addedAssertion ?assertion . }
      }
      UNION {
        $this modheritage:previousSnapshot ?previous ;
              modheritage:resultingSnapshot ?result .
        ?previous modheritage:includesAssertion ?assertion .
        FILTER NOT EXISTS { ?result modheritage:includesAssertion ?assertion . }
        FILTER NOT EXISTS { $this modheritage:removedAssertion ?assertion . }
      }
      UNION {
        $this modheritage:addedAssertion ?assertion ;
              modheritage:removedAssertion ?assertion .
      }
    }
  </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-SPARQLConstraint-03">
    <ns2:label xml:lang="en">knowledge maintenance activity shape sparqlconstraint 03</ns2:label>
    <ns2:label xml:lang="en">knowledge snapshot revision cycle constraint</ns2:label>
    <ns3:message xml:lang="en">A knowledge-snapshot revision chain cannot contain a cycle.</ns3:message>
    <ns3:name xml:lang="en">knowledge maintenance activity shape sparqlconstraint 03</ns3:name>
    <ns3:name xml:lang="en">knowledge snapshot revision cycle constraint</ns3:name>
    <ns3:select>
    PREFIX modheritage: &lt;https://w3id.org/modavis/ontology/heritage#&gt;
    SELECT $this WHERE {
      $this modheritage:previousSnapshot ?previous ;
            modheritage:resultingSnapshot ?result .
      ?result (^modheritage:previousSnapshot/modheritage:resultingSnapshot)+ ?previous .
    }
  </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-SPARQLConstraint-04">
    <ns2:label xml:lang="en">knowledge maintenance activity shape sparqlconstraint 04</ns2:label>
    <ns2:label xml:lang="en">knowledge snapshot revision chronology constraint</ns2:label>
    <ns3:message xml:lang="en">A resulting knowledge snapshot must have a creation time later than its previous snapshot.</ns3:message>
    <ns3:name xml:lang="en">knowledge maintenance activity shape sparqlconstraint 04</ns3:name>
    <ns3:name xml:lang="en">knowledge snapshot revision chronology constraint</ns3:name>
    <ns3:select>
    PREFIX modheritage: &lt;https://w3id.org/modavis/ontology/heritage#&gt;
    SELECT $this WHERE {
      $this modheritage:previousSnapshot ?previous ;
            modheritage:resultingSnapshot ?result .
      ?previous modheritage:snapshotCreatedAt ?previousTime .
      ?result modheritage:snapshotCreatedAt ?resultTime .
      FILTER (?resultTime &lt;= ?previousTime)
    }
  </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-addedAssertion-PropertyShape-04">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">added assertion property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/assertion#Assertion" />
    <ns3:message xml:lang="en">Every added resource must be typed as a MODAVIS assertion.</ns3:message>
    <ns3:name xml:lang="en">added assertion property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/heritage#addedAssertion" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-maintainedCollection-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">maintained collection property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/heritage#CuratedKnowledgeCollection" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A knowledge maintenance activity must identify exactly one maintained collection.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">maintained collection property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/heritage#maintainedCollection" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-previousSnapshot-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">previous snapshot property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/heritage#KnowledgeSnapshot" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A knowledge maintenance activity may identify at most one preceding snapshot.</ns3:message>
    <ns3:name xml:lang="en">previous snapshot property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/heritage#previousSnapshot" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-removedAssertion-PropertyShape-05">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">removed assertion property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/assertion#Assertion" />
    <ns3:message xml:lang="en">Every removed resource must be typed as a MODAVIS assertion.</ns3:message>
    <ns3:name xml:lang="en">removed assertion property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/heritage#removedAssertion" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-resultingSnapshot-PropertyShape-03">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">resulting snapshot property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/heritage#KnowledgeSnapshot" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A knowledge maintenance activity must identify exactly one resulting snapshot.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">resulting snapshot property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/heritage#resultingSnapshot" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">knowledge snapshot shape</ns2:label>
    <ns3:name xml:lang="en">knowledge snapshot shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-canonicalMaterialization-PropertyShape-09" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-canonicalizationProfile-PropertyShape-04" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-includesAssertion-PropertyShape-02" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-materializedAs-PropertyShape-06" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-snapshotCreatedAt-PropertyShape-07" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-snapshotCreatedBy-PropertyShape-08" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-snapshotGraphIri-PropertyShape-05" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-snapshotOfCollection-PropertyShape-01" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-SPARQLConstraint-01" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-SPARQLConstraint-02" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/heritage#KnowledgeSnapshot" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-SPARQLConstraint-01">
    <ns2:label xml:lang="en">canonical snapshot materialization media type constraint</ns2:label>
    <ns2:label xml:lang="en">knowledge snapshot shape sparqlconstraint 01</ns2:label>
    <ns3:message xml:lang="en">The canonical snapshot materialization must declare media type application/n-quads.</ns3:message>
    <ns3:name xml:lang="en">canonical snapshot materialization media type constraint</ns3:name>
    <ns3:name xml:lang="en">knowledge snapshot shape sparqlconstraint 01</ns3:name>
    <ns3:select>
    PREFIX modheritage: &lt;https://w3id.org/modavis/ontology/heritage#&gt;
    PREFIX modmedia: &lt;https://w3id.org/modavis/ontology/media#&gt;
    SELECT $this WHERE {
      $this modheritage:canonicalMaterialization ?bitstream .
      FILTER NOT EXISTS { ?bitstream modmedia:mediaType "application/n-quads" . }
    }
  </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-SPARQLConstraint-02">
    <ns2:label xml:lang="en">knowledge snapshot self-checksum exclusion constraint</ns2:label>
    <ns2:label xml:lang="en">knowledge snapshot shape sparqlconstraint 02</ns2:label>
    <ns3:message xml:lang="en">A knowledge snapshot must not carry a direct checksum; fix the exact canonical materialization bitstream to avoid an ambiguous or self-referential digest.</ns3:message>
    <ns3:name xml:lang="en">knowledge snapshot self-checksum exclusion constraint</ns3:name>
    <ns3:name xml:lang="en">knowledge snapshot shape sparqlconstraint 02</ns3:name>
    <ns3:select>
    PREFIX modevidence: &lt;https://w3id.org/modavis/ontology/evidence#&gt;
    SELECT $this WHERE { $this modevidence:hasChecksum ?checksum . }
  </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-canonicalMaterialization-PropertyShape-09">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">canonical materialization property constraint</ns2:label>
    <ns2:label xml:lang="en">canonical snapshot materialization property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/media#Bitstream" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A knowledge snapshot must identify exactly one checksum-fixed canonical N-Quads bitstream.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">canonical materialization property constraint</ns3:name>
    <ns3:name xml:lang="en">canonical snapshot materialization property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/heritage#canonicalMaterialization" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-canonicalizationProfile-PropertyShape-04">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">canonicalization profile property constraint</ns2:label>
    <ns2:label xml:lang="en">snapshot canonicalization profile property constraint</ns2:label>
    <ns3:hasValue rdf:resource="https://www.w3.org/TR/2024/REC-rdf-canon-20240521/" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A knowledge snapshot must identify exactly the immutable RDFC-1.0 W3C Recommendation as its canonicalization profile.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">canonicalization profile property constraint</ns3:name>
    <ns3:name xml:lang="en">snapshot canonicalization profile property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/heritage#canonicalizationProfile" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-includesAssertion-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">includes assertion property constraint</ns2:label>
    <ns2:label xml:lang="en">snapshot assertion membership property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/assertion#Assertion" />
    <ns3:message xml:lang="en">A knowledge snapshot must explicitly include at least one assertion.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">includes assertion property constraint</ns3:name>
    <ns3:name xml:lang="en">snapshot assertion membership property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/heritage#includesAssertion" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-materializedAs-PropertyShape-06">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">materialized as property constraint</ns2:label>
    <ns2:label xml:lang="en">snapshot materialization property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/media#DigitalAsset" />
    <ns3:message xml:lang="en">Every snapshot materialization must be an identified digital asset.</ns3:message>
    <ns3:name xml:lang="en">materialized as property constraint</ns3:name>
    <ns3:name xml:lang="en">snapshot materialization property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/heritage#materializedAs" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-snapshotCreatedAt-PropertyShape-07">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">snapshot created at property constraint</ns2:label>
    <ns2:label xml:lang="en">snapshot creation time property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A knowledge snapshot must record exactly one timezone-qualified xsd:dateTime creation timestamp.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">snapshot created at property constraint</ns3:name>
    <ns3:name xml:lang="en">snapshot creation time property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/heritage#snapshotCreatedAt" />
    <ns3:pattern>(Z|[+-](0[0-9]|1[0-4]):[0-5][0-9])$</ns3:pattern>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-snapshotCreatedBy-PropertyShape-08">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">snapshot created by property constraint</ns2:label>
    <ns2:label xml:lang="en">snapshot generation activity property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/heritage#KnowledgeMaintenanceActivity" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A knowledge snapshot must identify exactly one knowledge maintenance activity that created it.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">snapshot created by property constraint</ns3:name>
    <ns3:name xml:lang="en">snapshot generation activity property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/heritage#snapshotCreatedBy" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-snapshotGraphIri-PropertyShape-05">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">snapshot graph IRI property constraint</ns2:label>
    <ns2:label xml:lang="en">snapshot graph iri property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A knowledge snapshot must record exactly one absolute named-graph IRI.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">snapshot graph IRI property constraint</ns3:name>
    <ns3:name xml:lang="en">snapshot graph iri property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/heritage#snapshotGraphIri" />
    <ns3:pattern>^[A-Za-z][A-Za-z0-9+.-]*:</ns3:pattern>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-snapshotOfCollection-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">snapshot collection property constraint</ns2:label>
    <ns2:label xml:lang="en">snapshot of collection property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/heritage#CuratedKnowledgeCollection" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A knowledge snapshot must identify exactly one curated knowledge collection.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">snapshot collection property constraint</ns3:name>
    <ns3:name xml:lang="en">snapshot of collection property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/heritage#snapshotOfCollection" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#LoopPointSetShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">loop point set shape</ns2:label>
    <ns3:name xml:lang="en">loop point set shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#LoopPointSetShape-appliesToSignal-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#LoopPointSetShape-confidence-PropertyShape-02" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#LoopPointSetShape-hasLoopRegion-PropertyShape-03" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#LoopPointSetShape-loopabilityAssessment-PropertyShape-04" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#LoopPointSetShape-SPARQLConstraint-01" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/audio#LoopPointSet" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#LoopPointSetShape-SPARQLConstraint-01">
    <ns2:label xml:lang="en">loop point set shape sparqlconstraint 01</ns2:label>
    <ns3:message xml:lang="en">Every loop region in a loop point set must use the same fixed audio signal as the set.</ns3:message>
    <ns3:name xml:lang="en">loop point set shape sparqlconstraint 01</ns3:name>
    <ns3:select>
      PREFIX modaudio: &lt;https://w3id.org/modavis/ontology/audio#&gt;
      SELECT $this WHERE {
        $this modaudio:appliesToSignal ?signal ; modaudio:hasLoopRegion ?region .
        FILTER NOT EXISTS { ?region modaudio:appliesToSignal ?signal . }
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#LoopPointSetShape-appliesToSignal-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">applies to signal property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/audio#AudioSignal" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Applies to signal constraint: exactly 1 value(s) are required; values must be instances of AudioSignal.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">applies to signal property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/audio#appliesToSignal" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#LoopPointSetShape-confidence-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">confidence property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxInclusive>
    <ns3:message xml:lang="en">Confidence constraint: at most 1 value(s) are permitted; values must use the decimal datatype; value must be at least 0; value must be at most 1.</ns3:message>
    <ns3:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</ns3:minInclusive>
    <ns3:name xml:lang="en">confidence property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/audio#confidence" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#LoopPointSetShape-hasLoopRegion-PropertyShape-03">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">has loop region property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/audio#SustainLoopRegion" />
    <ns3:message xml:lang="en">Has loop region constraint: at least 1 value(s) are required; values must be instances of SustainLoopRegion.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">has loop region property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/audio#hasLoopRegion" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#LoopPointSetShape-loopabilityAssessment-PropertyShape-04">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">loopability assessment property constraint</ns2:label>
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Loopability assessment constraint: at most 1 value(s) are permitted; values must have node kind IRI.</ns3:message>
    <ns3:name xml:lang="en">loopability assessment property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/audio#loopabilityAssessment" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#MidiExtractionBindingShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">midi extraction binding shape</ns2:label>
    <ns3:name xml:lang="en">midi extraction binding shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#MidiExtractionBindingShape-assignedNoteNumber-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#MidiExtractionBindingShape-extractionRegion-PropertyShape-02" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/midi#MidiExtractionBinding" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#MidiExtractionBindingShape-assignedNoteNumber-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">assigned note number property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">127</ns3:maxInclusive>
    <ns3:message xml:lang="en">Assigned note number constraint: exactly 1 value(s) are required; values must use the nonNegativeInteger datatype; value must be at most 127.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">assigned note number property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/midi#assignedNoteNumber" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#MidiExtractionBindingShape-extractionRegion-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">extraction region property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/audio#SampleExtractionRegion" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Extraction region constraint: exactly 1 value(s) are required; values must be instances of SampleExtractionRegion.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">extraction region property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/midi#extractionRegion" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#MidiPlaybackBindingShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">midi playback binding shape</ns2:label>
    <ns3:name xml:lang="en">midi playback binding shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#MidiPlaybackBindingShape-maximumNoteNumber-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#MidiPlaybackBindingShape-maximumNoteOnVelocity-PropertyShape-02" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#MidiPlaybackBindingShape-minimumNoteNumber-PropertyShape-03" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#MidiPlaybackBindingShape-minimumNoteOnVelocity-PropertyShape-04" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#MidiPlaybackBindingShape-playbackParameters-PropertyShape-05" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#MidiPlaybackBindingShape-rootNoteNumber-PropertyShape-06" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#MidiPlaybackBindingShape-SPARQLConstraint-01" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#MidiPlaybackBindingShape-SPARQLConstraint-02" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#MidiPlaybackBindingShape-SPARQLConstraint-03" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/midi#MidiPlaybackBinding" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#MidiPlaybackBindingShape-SPARQLConstraint-01">
    <ns2:label xml:lang="en">midi playback binding shape sparqlconstraint 01</ns2:label>
    <ns3:message xml:lang="en">A MIDI note-number range cannot have a minimum greater than its maximum.</ns3:message>
    <ns3:name xml:lang="en">midi playback binding shape sparqlconstraint 01</ns3:name>
    <ns3:select>
      PREFIX modmidi: &lt;https://w3id.org/modavis/ontology/midi#&gt;
      SELECT $this WHERE {
        $this modmidi:minimumNoteNumber ?minimum ; modmidi:maximumNoteNumber ?maximum .
        FILTER (?minimum &gt; ?maximum)
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#MidiPlaybackBindingShape-SPARQLConstraint-02">
    <ns2:label xml:lang="en">midi playback binding shape sparqlconstraint 02</ns2:label>
    <ns3:message xml:lang="en">A MIDI note-on velocity range cannot have a minimum greater than its maximum.</ns3:message>
    <ns3:name xml:lang="en">midi playback binding shape sparqlconstraint 02</ns3:name>
    <ns3:select>
      PREFIX modmidi: &lt;https://w3id.org/modavis/ontology/midi#&gt;
      SELECT $this WHERE {
        $this modmidi:minimumNoteOnVelocity ?minimum ; modmidi:maximumNoteOnVelocity ?maximum .
        FILTER (?minimum &gt; ?maximum)
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#MidiPlaybackBindingShape-SPARQLConstraint-03">
    <ns2:label xml:lang="en">midi playback binding shape sparqlconstraint 03</ns2:label>
    <ns3:message xml:lang="en">The root MIDI note number must fall within any declared note-number range.</ns3:message>
    <ns3:name xml:lang="en">midi playback binding shape sparqlconstraint 03</ns3:name>
    <ns3:select>
      PREFIX modmidi: &lt;https://w3id.org/modavis/ontology/midi#&gt;
      SELECT $this WHERE {
        { $this modmidi:rootNoteNumber ?root ; modmidi:minimumNoteNumber ?minimum . FILTER (?root &lt; ?minimum) }
        UNION
        { $this modmidi:rootNoteNumber ?root ; modmidi:maximumNoteNumber ?maximum . FILTER (?root &gt; ?maximum) }
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#MidiPlaybackBindingShape-maximumNoteNumber-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">maximum note number property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">127</ns3:maxInclusive>
    <ns3:message xml:lang="en">Maximum note number constraint: at most 1 value(s) are permitted; values must use the nonNegativeInteger datatype; value must be at most 127.</ns3:message>
    <ns3:name xml:lang="en">maximum note number property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/midi#maximumNoteNumber" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#MidiPlaybackBindingShape-maximumNoteOnVelocity-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">maximum note on velocity property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">127</ns3:maxInclusive>
    <ns3:message xml:lang="en">A MIDI 1.0 note-on velocity selection bound must be from 1 through 127; velocity zero denotes note-off.</ns3:message>
    <ns3:name xml:lang="en">maximum note on velocity property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/midi#maximumNoteOnVelocity" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#MidiPlaybackBindingShape-minimumNoteNumber-PropertyShape-03">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">minimum note number property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">127</ns3:maxInclusive>
    <ns3:message xml:lang="en">Minimum note number constraint: at most 1 value(s) are permitted; values must use the nonNegativeInteger datatype; value must be at most 127.</ns3:message>
    <ns3:name xml:lang="en">minimum note number property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/midi#minimumNoteNumber" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#MidiPlaybackBindingShape-minimumNoteOnVelocity-PropertyShape-04">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">minimum note on velocity property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">127</ns3:maxInclusive>
    <ns3:message xml:lang="en">A MIDI 1.0 note-on velocity selection bound must be from 1 through 127; velocity zero denotes note-off.</ns3:message>
    <ns3:name xml:lang="en">minimum note on velocity property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/midi#minimumNoteOnVelocity" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
