      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "historical claim review shape"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#HistoricalClaimReviewShape-producesAssertion-PropertyShape-03"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#HistoricalClaimReviewShape-reviewRationale-PropertyShape-04"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#HistoricalClaimReviewShape-reviewSubject-PropertyShape-01"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#HistoricalClaimReviewShape-reviewsAssertion-PropertyShape-02"
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ],
    "http://www.w3.org/ns/shacl#sparql": [
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#HistoricalClaimReviewShape-SPARQLConstraint-01"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#HistoricalClaimReviewShape-SPARQLConstraint-02"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://w3id.org/modavis/ontology/heritage#HistoricalClaimReview"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#HistoricalClaimReviewShape-SPARQLConstraint-01",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "historical claim review shape sparqlconstraint 01"
      },
      {
        "@language": "en",
        "@value": "historical claim review subject consistency constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "Every input and conclusion assertion in a historical claim review must assert about the review subject."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "historical claim review shape sparqlconstraint 01"
      },
      {
        "@language": "en",
        "@value": "historical claim review subject consistency constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n    PREFIX modassert: <https://w3id.org/modavis/ontology/assertion#>\n    PREFIX modheritage: <https://w3id.org/modavis/ontology/heritage#>\n    SELECT $this WHERE {\n      $this modheritage:reviewSubject ?subject .\n      $this (modheritage:reviewsAssertion|modheritage:producesAssertion) ?assertion .\n      FILTER NOT EXISTS { ?assertion modassert:assertsSubject ?subject . }\n    }\n  "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#HistoricalClaimReviewShape-SPARQLConstraint-02",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "historical claim review conclusion lineage constraint"
      },
      {
        "@language": "en",
        "@value": "historical claim review shape sparqlconstraint 02"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "The conclusion must be distinct from every input assertion and must identify the historical claim review as its generating activity."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "historical claim review conclusion lineage constraint"
      },
      {
        "@language": "en",
        "@value": "historical claim review shape sparqlconstraint 02"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n    PREFIX modassert: <https://w3id.org/modavis/ontology/assertion#>\n    PREFIX modheritage: <https://w3id.org/modavis/ontology/heritage#>\n    SELECT $this WHERE {\n      $this modheritage:producesAssertion ?conclusion .\n      FILTER (\n        EXISTS { $this modheritage:reviewsAssertion ?conclusion } ||\n        NOT EXISTS { ?conclusion modassert:generatedBy $this }\n      )\n    }\n  "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
