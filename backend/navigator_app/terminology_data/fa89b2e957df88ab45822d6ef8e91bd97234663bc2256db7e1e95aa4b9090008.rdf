    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Playback parameters constraint: exactly 1 value(s) are required; values must be instances of SamplePlaybackParameters.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">playback parameters property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/midi#playbackParameters" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
