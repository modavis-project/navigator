      {
        "@value": "testing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Identifies the one snapshot selected as current under the collection's recorded governance state while retaining earlier snapshots."
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/ontology/heritage#documentsResource",
    "@type": [
