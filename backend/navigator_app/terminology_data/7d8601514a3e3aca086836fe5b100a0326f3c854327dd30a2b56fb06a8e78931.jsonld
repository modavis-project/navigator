  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeIdentityBoundaryShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "knowledge identity boundary shape"
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "knowledge identity boundary shape"
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ],
    "http://www.w3.org/ns/shacl#sparql": [
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeIdentityBoundaryShape-SPARQLConstraint-01"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://w3id.org/modavis/ontology/heritage#CuratedKnowledgeCollection"
      },
      {
        "@id": "https://w3id.org/modavis/ontology/heritage#KnowledgeSnapshot"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeIdentityBoundaryShape-SPARQLConstraint-01",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "knowledge identity boundary constraint"
      },
      {
        "@language": "en",
        "@value": "knowledge identity boundary shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "A curated knowledge collection or fixed knowledge snapshot cannot also be a musical instrument, digital asset, digital surrogate, virtual-instrument product, version, or package."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "knowledge identity boundary constraint"
      },
      {
        "@language": "en",
        "@value": "knowledge identity boundary shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n    PREFIX modinst: <https://w3id.org/modavis/ontology/instrument#>\n    PREFIX modmedia: <https://w3id.org/modavis/ontology/media#>\n    PREFIX modvmi: <https://w3id.org/modavis/ontology/virtual-instrument#>\n    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\n    SELECT DISTINCT $this WHERE {\n      $this a ?type .\n      ?type rdfs:subClassOf* ?forbiddenLayer .\n      FILTER (?forbiddenLayer IN (\n        modinst:MusicalInstrument,\n        modmedia:DigitalAsset,\n        modmedia:DigitalSurrogate,\n        modvmi:VirtualInstrumentProduct,\n        modvmi:VirtualInstrumentVersion,\n        modvmi:VirtualInstrumentPackage\n      ))\n    }\n  "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "knowledge maintenance activity shape"
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "knowledge maintenance activity shape"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-addedAssertion-PropertyShape-04"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-maintainedCollection-PropertyShape-01"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-previousSnapshot-PropertyShape-02"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-removedAssertion-PropertyShape-05"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-resultingSnapshot-PropertyShape-03"
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ],
    "http://www.w3.org/ns/shacl#sparql": [
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-SPARQLConstraint-01"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-SPARQLConstraint-02"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-SPARQLConstraint-03"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-SPARQLConstraint-04"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://w3id.org/modavis/ontology/heritage#KnowledgeMaintenanceActivity"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-SPARQLConstraint-01",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "knowledge maintenance activity shape sparqlconstraint 01"
      },
      {
        "@language": "en",
        "@value": "knowledge snapshot lineage consistency constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "Previous and resulting snapshots must be distinct states of the maintained collection, and the resulting snapshot must identify this generating activity."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "knowledge maintenance activity shape sparqlconstraint 01"
      },
      {
        "@language": "en",
        "@value": "knowledge snapshot lineage consistency constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n    PREFIX modheritage: <https://w3id.org/modavis/ontology/heritage#>\n    SELECT $this WHERE {\n      $this modheritage:maintainedCollection ?collection ;\n            modheritage:resultingSnapshot ?result .\n      FILTER (\n        NOT EXISTS { ?result modheritage:snapshotOfCollection ?collection } ||\n        NOT EXISTS { ?result modheritage:snapshotCreatedBy $this } ||\n        EXISTS { $this modheritage:previousSnapshot ?result } ||\n        EXISTS {\n          $this modheritage:previousSnapshot ?previous .\n          FILTER NOT EXISTS { ?previous modheritage:snapshotOfCollection ?collection }\n        }\n      )\n    }\n  "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-SPARQLConstraint-02",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "knowledge maintenance activity shape sparqlconstraint 02"
      },
      {
        "@language": "en",
        "@value": "knowledge snapshot delta consistency constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "The added and removed assertion lists must be non-empty as a combined delta and must exactly match the difference between the previous and resulting snapshots."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "knowledge maintenance activity shape sparqlconstraint 02"
      },
      {
        "@language": "en",
        "@value": "knowledge snapshot delta consistency constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n    PREFIX modheritage: <https://w3id.org/modavis/ontology/heritage#>\n    SELECT $this WHERE {\n      { FILTER NOT EXISTS { $this (modheritage:addedAssertion|modheritage:removedAssertion) ?change . } }\n      UNION {\n        $this modheritage:addedAssertion ?assertion ;\n              modheritage:resultingSnapshot ?result .\n        FILTER NOT EXISTS { ?result modheritage:includesAssertion ?assertion . }\n      }\n      UNION {\n        $this modheritage:addedAssertion ?assertion ;\n              modheritage:previousSnapshot ?previous .\n        ?previous modheritage:includesAssertion ?assertion .\n      }\n      UNION {\n        $this modheritage:removedAssertion ?assertion .\n        FILTER NOT EXISTS {\n          $this modheritage:previousSnapshot ?previous .\n          ?previous modheritage:includesAssertion ?assertion .\n        }\n      }\n      UNION {\n        $this modheritage:removedAssertion ?assertion ;\n              modheritage:resultingSnapshot ?result .\n        ?result modheritage:includesAssertion ?assertion .\n      }\n      UNION {\n        $this modheritage:resultingSnapshot ?result .\n        ?result modheritage:includesAssertion ?assertion .\n        FILTER NOT EXISTS {\n          $this modheritage:previousSnapshot ?previous .\n          ?previous modheritage:includesAssertion ?assertion .\n        }\n        FILTER NOT EXISTS { $this modheritage:addedAssertion ?assertion . }\n      }\n      UNION {\n        $this modheritage:previousSnapshot ?previous ;\n              modheritage:resultingSnapshot ?result .\n        ?previous modheritage:includesAssertion ?assertion .\n        FILTER NOT EXISTS { ?result modheritage:includesAssertion ?assertion . }\n        FILTER NOT EXISTS { $this modheritage:removedAssertion ?assertion . }\n      }\n      UNION {\n        $this modheritage:addedAssertion ?assertion ;\n              modheritage:removedAssertion ?assertion .\n      }\n    }\n  "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-SPARQLConstraint-03",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "knowledge maintenance activity shape sparqlconstraint 03"
      },
      {
        "@language": "en",
        "@value": "knowledge snapshot revision cycle constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "A knowledge-snapshot revision chain cannot contain a cycle."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "knowledge maintenance activity shape sparqlconstraint 03"
      },
      {
        "@language": "en",
        "@value": "knowledge snapshot revision cycle constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n    PREFIX modheritage: <https://w3id.org/modavis/ontology/heritage#>\n    SELECT $this WHERE {\n      $this modheritage:previousSnapshot ?previous ;\n            modheritage:resultingSnapshot ?result .\n      ?result (^modheritage:previousSnapshot/modheritage:resultingSnapshot)+ ?previous .\n    }\n  "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-SPARQLConstraint-04",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "knowledge maintenance activity shape sparqlconstraint 04"
      },
      {
        "@language": "en",
        "@value": "knowledge snapshot revision chronology constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "A resulting knowledge snapshot must have a creation time later than its previous snapshot."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "knowledge maintenance activity shape sparqlconstraint 04"
      },
      {
        "@language": "en",
        "@value": "knowledge snapshot revision chronology constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n    PREFIX modheritage: <https://w3id.org/modavis/ontology/heritage#>\n    SELECT $this WHERE {\n      $this modheritage:previousSnapshot ?previous ;\n            modheritage:resultingSnapshot ?result .\n      ?previous modheritage:snapshotCreatedAt ?previousTime .\n      ?result modheritage:snapshotCreatedAt ?resultTime .\n      FILTER (?resultTime <= ?previousTime)\n    }\n  "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeMaintenanceActivityShape-addedAssertion-PropertyShape-04",
    "@type": [
      "http://www.w3.org/ns/shacl#PropertyShape"
