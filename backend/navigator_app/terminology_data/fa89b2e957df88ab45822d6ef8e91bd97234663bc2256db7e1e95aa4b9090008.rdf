    <ns2:label xml:lang="en">interval semitones property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Interval semitones constraint: at most 1 value(s) are permitted; values must use the integer datatype.</ns3:message>
    <ns3:name xml:lang="en">interval semitones property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/organ#intervalSemitones" />
