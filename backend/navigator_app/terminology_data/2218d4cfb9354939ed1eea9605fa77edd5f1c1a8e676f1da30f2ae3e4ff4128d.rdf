<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF xmlns:ns1="http://purl.org/dc/terms/" xmlns:ns2="http://purl.org/vocab/vann/" xmlns:ns3="http://www.w3.org/2002/07/owl#" xmlns:ns4="http://www.w3.org/2000/01/rdf-schema#" xmlns:ns5="http://www.w3.org/2003/06/sw-vocab-status/ns#" xmlns:ns6="http://www.w3.org/2004/02/skos/core#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/events">
    <ns1:conformsTo rdf:resource="https://www.w3.org/TR/owl2-profiles/#OWL_2_RL" />
    <ns1:creator rdf:resource="https://orcid.org/0000-0002-7904-3892" />
    <ns1:description xml:lang="en">Historical and domain events with participants, affected entities, time, place, sources, evidence, and processing provenance.</ns1:description>
    <ns1:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-27</ns1:issued>
    <ns1:license rdf:resource="https://creativecommons.org/licenses/by/4.0/" />
    <ns1:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-27</ns1:modified>
    <ns1:publisher rdf:resource="https://orcid.org/0000-0002-7904-3892" />
    <ns1:title xml:lang="en">MODAVIS Event Ontology</ns1:title>
    <ns2:preferredNamespacePrefix>modevent</ns2:preferredNamespacePrefix>
    <ns2:preferredNamespaceUri>https://w3id.org/modavis/ontology/events#</ns2:preferredNamespaceUri>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology" />
    <ns3:imports rdf:resource="https://w3id.org/modavis/ontology/core/0.1.0" />
    <ns3:imports rdf:resource="https://w3id.org/modavis/ontology/evidence/0.1.0" />
    <ns3:imports rdf:resource="https://w3id.org/modavis/ontology/provenance/0.1.0" />
    <ns3:versionIRI rdf:resource="https://w3id.org/modavis/ontology/events/0.1.0" />
    <ns3:versionInfo>0.1.0</ns3:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/events#Activity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/events" />
    <ns4:label xml:lang="en">domain activity</ns4:label>
    <ns4:subClassOf rdf:resource="https://w3id.org/modavis/ontology/events#Event" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">A domain event understood as an intentional or organized action or process.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/events#Event">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/events" />
    <ns4:label xml:lang="en">domain event</ns4:label>
    <ns4:subClassOf rdf:resource="https://w3id.org/modavis/ontology/core#IdentifiedResource" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">A citable occurrence or process in the documented world, distinct from the computational or editorial activity that recorded it.</ns6:definition>
    <ns6:scopeNote xml:lang="en">No equivalence or disjointness with prov:Activity is asserted. Historical event semantics and processing provenance remain separate roles and records.</ns6:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/events#EventRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/events" />
    <ns4:label xml:lang="en">event record</ns4:label>
    <ns4:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity" />
    <ns4:subClassOf rdf:resource="https://w3id.org/modavis/ontology/core#Entity" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">A provenance-bearing information entity that describes a domain event without claiming that the historical occurrence itself was generated by the recording process.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/events#affectedEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/events#Event" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/events" />
    <ns4:label xml:lang="en">affected entity</ns4:label>
    <ns4:range rdf:resource="https://w3id.org/modavis/ontology/core#Entity" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Relates a domain event to an entity whose state, location, structure, ownership, interpretation, or other documented condition it affected.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/events#describesEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/events#EventRecord" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/events" />
    <ns4:label xml:lang="en">describes event</ns4:label>
    <ns4:range rdf:resource="https://w3id.org/modavis/ontology/events#Event" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Identifies the domain event described by an event record.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/events#eventType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/events#Event" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/events" />
    <ns4:label xml:lang="en">event type</ns4:label>
    <ns4:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Classifies a domain event with a governed event-type concept.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/events#evidencedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/events#Event" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/events" />
    <ns4:label xml:lang="en">evidenced by</ns4:label>
    <ns4:range rdf:resource="https://w3id.org/modavis/ontology/evidence#EvidenceRelation" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Relates a domain event to qualified source-fragment evidence that evaluates the documented occurrence.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/events#generatedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/events#EventRecord" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/events" />
    <ns4:label xml:lang="en">event record generated by</ns4:label>
    <ns4:range rdf:resource="https://w3id.org/modavis/ontology/provenance#ProcessingActivity" />
    <ns4:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasGeneratedBy" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Identifies the processing or editorial activity that generated an event record, never the real-world occurrence it describes.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/events#hasParticipant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/events#Event" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/events" />
    <ns4:label xml:lang="en">has participant</ns4:label>
    <ns4:range rdf:resource="https://w3id.org/modavis/ontology/core#Entity" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Relates a domain event to an entity that participated in it.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/events#hasSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/events#Event" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/events" />
    <ns4:label xml:lang="en">has source</ns4:label>
    <ns4:range rdf:resource="https://w3id.org/modavis/ontology/evidence#SourceResource" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Relates a domain event to a source resource documenting or contextualizing the occurrence.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/events#hasTimeSpan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/events#Event" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/events" />
    <ns4:label xml:lang="en">has time span</ns4:label>
    <ns4:range rdf:resource="https://w3id.org/modavis/ontology/core#TimeSpan" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Relates a domain event to its documented temporal extent.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/events#tookPlaceAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/events#Event" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/events" />
    <ns4:label xml:lang="en">took place at</ns4:label>
    <ns4:range rdf:resource="https://w3id.org/modavis/ontology/core#Place" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Relates a domain event to a place at which it occurred.</ns6:definition>
  </rdf:Description>
</rdf:RDF>
