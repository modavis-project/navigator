      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-hasEvidenceRelation-PropertyShape-07"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-recognitionAssignedBy-PropertyShape-02"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-recognitionBasis-PropertyShape-03"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-recognitionRecordedBy-PropertyShape-06"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-recognitionStatus-PropertyShape-04"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-recognizesResource-PropertyShape-01"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-supersedesRecognition-PropertyShape-08"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-validDuring-PropertyShape-05"
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ],
    "http://www.w3.org/ns/shacl#sparql": [
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-SPARQLConstraint-01"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-SPARQLConstraint-02"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-SPARQLConstraint-03"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://w3id.org/modavis/ontology/heritage#HeritageRecognition"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-SPARQLConstraint-01",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "heritage recognition evidence consistency constraint"
      },
      {
        "@language": "en",
        "@value": "heritage recognition shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "Every heritage-recognition evidence relation must identify that recognition as the resource it evaluates."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "heritage recognition evidence consistency constraint"
      },
      {
        "@language": "en",
        "@value": "heritage recognition shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n    PREFIX modevidence: <https://w3id.org/modavis/ontology/evidence#>\n    PREFIX modheritage: <https://w3id.org/modavis/ontology/heritage#>\n    SELECT $this WHERE {\n      $this modheritage:hasEvidenceRelation ?relation .\n      FILTER NOT EXISTS { ?relation modevidence:evaluates $this . }\n    }\n  "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-SPARQLConstraint-02",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "heritage recognition shape sparqlconstraint 02"
      },
      {
        "@language": "en",
        "@value": "heritage recognition supersession cycle constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "A heritage-recognition supersession chain cannot contain a cycle."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "heritage recognition shape sparqlconstraint 02"
      },
      {
        "@language": "en",
        "@value": "heritage recognition supersession cycle constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n    PREFIX modheritage: <https://w3id.org/modavis/ontology/heritage#>\n    SELECT $this WHERE { $this modheritage:supersedesRecognition+ $this . }\n  "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-SPARQLConstraint-03",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "heritage recognition shape sparqlconstraint 03"
      },
      {
        "@language": "en",
        "@value": "heritage recognition supersession subject constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "A heritage recognition may supersede only a recognition of the same resource."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "heritage recognition shape sparqlconstraint 03"
      },
      {
        "@language": "en",
        "@value": "heritage recognition supersession subject constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n    PREFIX modheritage: <https://w3id.org/modavis/ontology/heritage#>\n    SELECT $this WHERE {\n      $this modheritage:recognizesResource ?resource ;\n            modheritage:supersedesRecognition ?earlier .\n      FILTER NOT EXISTS { ?earlier modheritage:recognizesResource ?resource . }\n    }\n  "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#HeritageRecognitionShape-hasEvidenceRelation-PropertyShape-07",
    "@type": [
      "http://www.w3.org/ns/shacl#PropertyShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
