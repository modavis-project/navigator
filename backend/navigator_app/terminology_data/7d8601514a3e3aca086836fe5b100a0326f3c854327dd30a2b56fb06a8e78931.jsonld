    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "instrument component shape"
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "instrument component shape"
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://w3id.org/modavis/ontology/instrument#InstrumentComponent"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentConfigurationShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "instrument configuration shape"
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "instrument configuration shape"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentConfigurationShape-configurationOf-PropertyShape-01"
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ],
    "http://www.w3.org/ns/shacl#sparql": [
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentConfigurationShape-SPARQLConstraint-01"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://w3id.org/modavis/ontology/instrument#InstrumentConfiguration"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentConfigurationShape-SPARQLConstraint-01",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "instrument configuration shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "A hasConfiguration link must originate from the configuration's instrument or from a state of that instrument."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "instrument configuration shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      PREFIX modinst: <https://w3id.org/modavis/ontology/instrument#>\n      SELECT $this WHERE {\n        $this modinst:configurationOf ?instrument .\n        ?owner modinst:hasConfiguration $this .\n        FILTER (?owner != ?instrument)\n        FILTER NOT EXISTS { ?owner modinst:stateOf ?instrument . }\n      }\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentConfigurationShape-configurationOf-PropertyShape-01",
    "@type": [
      "http://www.w3.org/ns/shacl#PropertyShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "configuration of property constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://w3id.org/modavis/ontology/instrument#MusicalInstrument"
      }
    ],
    "http://www.w3.org/ns/shacl#maxCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "An instrument configuration requires exactly one instrument for which it is defined."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "configuration of property constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://w3id.org/modavis/ontology/instrument#configurationOf"
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentIdentityLayerShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "instrument identity layer shape"
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "instrument identity layer shape"
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ],
    "http://www.w3.org/ns/shacl#sparql": [
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentIdentityLayerShape-SPARQLConstraint-01"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://w3id.org/modavis/ontology/instrument#InstrumentConfiguration"
      },
      {
        "@id": "https://w3id.org/modavis/ontology/instrument#InstrumentState"
      },
      {
        "@id": "https://w3id.org/modavis/ontology/instrument#MusicalInstrument"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentIdentityLayerShape-SPARQLConstraint-01",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "instrument identity layer shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "A resource cannot occupy more than one of the distinct musical-instrument, instrument-state, and instrument-configuration identity layers."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "instrument identity layer shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      PREFIX modinst: <https://w3id.org/modavis/ontology/instrument#>\n      PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\n      SELECT DISTINCT $this WHERE {\n        $this a ?leftType, ?rightType .\n        ?leftType rdfs:subClassOf* ?leftLayer .\n        ?rightType rdfs:subClassOf* ?rightLayer .\n        FILTER (?leftLayer IN (\n          modinst:MusicalInstrument,\n          modinst:InstrumentState,\n          modinst:InstrumentConfiguration\n        ))\n        FILTER (?rightLayer IN (\n          modinst:MusicalInstrument,\n          modinst:InstrumentState,\n          modinst:InstrumentConfiguration\n        ))\n        FILTER (?leftLayer != ?rightLayer)\n      }\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "instrument source relation shape"
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "instrument source relation shape"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-hasEvidenceRelation-PropertyShape-01"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-sourceConfidence-PropertyShape-02"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-sourceInstrument-PropertyShape-03"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-sourceRelationSubject-PropertyShape-04"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-sourceRelationType-PropertyShape-05"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-sourceState-PropertyShape-06"
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ],
    "http://www.w3.org/ns/shacl#sparql": [
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-SPARQLConstraint-01"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-SPARQLConstraint-02"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://w3id.org/modavis/ontology/virtual-instrument#InstrumentSourceRelation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-SPARQLConstraint-01",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "instrument source relation shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "A source state must be a state of the source instrument named by the same relation."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "instrument source relation shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      PREFIX modinst: <https://w3id.org/modavis/ontology/instrument#>\n      PREFIX modvmi: <https://w3id.org/modavis/ontology/virtual-instrument#>\n      SELECT $this WHERE {\n        $this modvmi:sourceInstrument ?instrument ; modvmi:sourceState ?state .\n        FILTER NOT EXISTS { ?state modinst:stateOf ?instrument . }\n      }\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-SPARQLConstraint-02",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "instrument source relation shape sparqlconstraint 02"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "Every source-relation evidence relation must identify the source relation it evaluates."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "instrument source relation shape sparqlconstraint 02"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      PREFIX modevidence: <https://w3id.org/modavis/ontology/evidence#>\n      PREFIX modvmi: <https://w3id.org/modavis/ontology/virtual-instrument#>\n      SELECT $this WHERE {\n        $this modvmi:hasEvidenceRelation ?relation .\n        FILTER NOT EXISTS { ?relation modevidence:evaluates $this . }\n      }\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-hasEvidenceRelation-PropertyShape-01",
    "@type": [
      "http://www.w3.org/ns/shacl#PropertyShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has evidence relation property constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://w3id.org/modavis/ontology/evidence#EvidenceRelation"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "An accepted source relation requires at least one qualified evidence relation."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "has evidence relation property constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://w3id.org/modavis/ontology/virtual-instrument#hasEvidenceRelation"
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-or-Alternative-NodeShape-01",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "instrument source relation shape or alternative node shape 01"
      }
    ],
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://w3id.org/modavis/ontology/virtual-instrument#VirtualMusicalInstrument"
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "instrument source relation shape or alternative node shape 01"
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-or-Alternative-NodeShape-02",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "instrument source relation shape or alternative node shape 02"
      }
    ],
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://w3id.org/modavis/ontology/virtual-instrument#VirtualInstrumentProduct"
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "instrument source relation shape or alternative node shape 02"
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#InstrumentSourceRelationShape-or-Alternative-NodeShape-03",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "instrument source relation shape or alternative node shape 03"
      }
    ],
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://w3id.org/modavis/ontology/virtual-instrument#VirtualInstrumentVersion"
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
