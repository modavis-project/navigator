  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SelectorShape-or-Alternative-NodeShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
