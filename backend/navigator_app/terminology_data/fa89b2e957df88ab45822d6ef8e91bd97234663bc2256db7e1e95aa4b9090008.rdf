    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A tuning reference requires one positive reference frequency in hertz.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</ns3:minExclusive>
    <ns3:name xml:lang="en">reference frequency hz property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/audio#referenceFrequencyHz" />
