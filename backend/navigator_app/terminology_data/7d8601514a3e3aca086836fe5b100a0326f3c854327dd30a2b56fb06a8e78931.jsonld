      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "Applies in state constraint: at most 1 value(s) are permitted; values must be instances of InstrumentState."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "applies in state property constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://w3id.org/modavis/ontology/instrument#appliesInState"
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-childComponent-PropertyShape-03",
    "@type": [
      "http://www.w3.org/ns/shacl#PropertyShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "child component property constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://w3id.org/modavis/ontology/instrument#InstrumentComponent"
      }
    ],
    "http://www.w3.org/ns/shacl#maxCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "Child component constraint: exactly 1 value(s) are required; values must be instances of InstrumentComponent."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
