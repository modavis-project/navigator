@prefix modavis: <https://w3id.org/modavis/ontology/core#> .
@prefix modevent: <https://w3id.org/modavis/ontology/events#> .
@prefix modevidence: <https://w3id.org/modavis/ontology/evidence#> .
@prefix modprov: <https://w3id.org/modavis/ontology/provenance#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .

<https://w3id.org/modavis/ontology/events> a owl:Ontology ;
  owl:imports <https://w3id.org/modavis/ontology/core/0.1.0>,
              <https://w3id.org/modavis/ontology/evidence/0.1.0>,
              <https://w3id.org/modavis/ontology/provenance/0.1.0> ;
  dcterms:title "MODAVIS Event Ontology"@en ;
  dcterms:description "Historical and domain events with participants, affected entities, time, place, sources, evidence, and processing provenance."@en ;
  dcterms:creator <https://orcid.org/0000-0002-7904-3892> ;
  dcterms:publisher <https://orcid.org/0000-0002-7904-3892> ;
  dcterms:issued "2026-08-27"^^xsd:date ;
  dcterms:modified "2026-08-27"^^xsd:date ;
  dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
  dcterms:conformsTo <https://www.w3.org/TR/owl2-profiles/#OWL_2_RL> ;
  owl:versionIRI <https://w3id.org/modavis/ontology/events/0.1.0> ;
  owl:versionInfo "0.1.0" ;
  vann:preferredNamespacePrefix "modevent" ;
  vann:preferredNamespaceUri "https://w3id.org/modavis/ontology/events#" .

modevent:Event a owl:Class ;
  rdfs:subClassOf modavis:IdentifiedResource ;
  rdfs:label "domain event"@en ;
  skos:definition "A citable occurrence or process in the documented world, distinct from the computational or editorial activity that recorded it."@en ;
  skos:scopeNote "No equivalence or disjointness with prov:Activity is asserted. Historical event semantics and processing provenance remain separate roles and records."@en ;
  rdfs:isDefinedBy <https://w3id.org/modavis/ontology/events> ;
  vs:term_status "testing" .

modevent:Activity a owl:Class ;
  rdfs:subClassOf modevent:Event ;
  rdfs:label "domain activity"@en ;
  skos:definition "A domain event understood as an intentional or organized action or process."@en ;
  rdfs:isDefinedBy <https://w3id.org/modavis/ontology/events> ;
  vs:term_status "testing" .

modevent:EventRecord a owl:Class ;
  rdfs:subClassOf modavis:Entity, prov:Entity ;
  rdfs:label "event record"@en ;
  skos:definition "A provenance-bearing information entity that describes a domain event without claiming that the historical occurrence itself was generated by the recording process."@en ;
  rdfs:isDefinedBy <https://w3id.org/modavis/ontology/events> ;
  vs:term_status "testing" .

modevent:eventType a owl:ObjectProperty ;
  rdfs:domain modevent:Event ;
  rdfs:range skos:Concept ;
  rdfs:label "event type"@en ;
  skos:definition "Classifies a domain event with a governed event-type concept."@en ;
  rdfs:isDefinedBy <https://w3id.org/modavis/ontology/events> ;
  vs:term_status "testing" .

modevent:affectedEntity a owl:ObjectProperty ;
  rdfs:domain modevent:Event ;
  rdfs:range modavis:Entity ;
  rdfs:label "affected entity"@en ;
  skos:definition "Relates a domain event to an entity whose state, location, structure, ownership, interpretation, or other documented condition it affected."@en ;
  rdfs:isDefinedBy <https://w3id.org/modavis/ontology/events> ;
  vs:term_status "testing" .

modevent:hasParticipant a owl:ObjectProperty ;
  rdfs:domain modevent:Event ;
  rdfs:range modavis:Entity ;
  rdfs:label "has participant"@en ;
  skos:definition "Relates a domain event to an entity that participated in it."@en ;
  rdfs:isDefinedBy <https://w3id.org/modavis/ontology/events> ;
  vs:term_status "testing" .

modevent:hasTimeSpan a owl:ObjectProperty ;
  rdfs:domain modevent:Event ;
  rdfs:range modavis:TimeSpan ;
  rdfs:label "has time span"@en ;
  skos:definition "Relates a domain event to its documented temporal extent."@en ;
  rdfs:isDefinedBy <https://w3id.org/modavis/ontology/events> ;
  vs:term_status "testing" .

modevent:tookPlaceAt a owl:ObjectProperty ;
  rdfs:domain modevent:Event ;
  rdfs:range modavis:Place ;
  rdfs:label "took place at"@en ;
  skos:definition "Relates a domain event to a place at which it occurred."@en ;
  rdfs:isDefinedBy <https://w3id.org/modavis/ontology/events> ;
  vs:term_status "testing" .

modevent:hasSource a owl:ObjectProperty ;
  rdfs:domain modevent:Event ;
  rdfs:range modevidence:SourceResource ;
  rdfs:label "has source"@en ;
  skos:definition "Relates a domain event to a source resource documenting or contextualizing the occurrence."@en ;
  rdfs:isDefinedBy <https://w3id.org/modavis/ontology/events> ;
  vs:term_status "testing" .

modevent:evidencedBy a owl:ObjectProperty ;
  rdfs:domain modevent:Event ;
  rdfs:range modevidence:EvidenceRelation ;
  rdfs:label "evidenced by"@en ;
  skos:definition "Relates a domain event to qualified source-fragment evidence that evaluates the documented occurrence."@en ;
  rdfs:isDefinedBy <https://w3id.org/modavis/ontology/events> ;
  vs:term_status "testing" .

modevent:describesEvent a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain modevent:EventRecord ;
  rdfs:range modevent:Event ;
  rdfs:label "describes event"@en ;
  skos:definition "Identifies the domain event described by an event record."@en ;
  rdfs:isDefinedBy <https://w3id.org/modavis/ontology/events> ;
  vs:term_status "testing" .

modevent:generatedBy a owl:ObjectProperty ;
  rdfs:subPropertyOf prov:wasGeneratedBy ;
  rdfs:domain modevent:EventRecord ;
  rdfs:range modprov:ProcessingActivity ;
  rdfs:label "event record generated by"@en ;
  skos:definition "Identifies the processing or editorial activity that generated an event record, never the real-world occurrence it describes."@en ;
  rdfs:isDefinedBy <https://w3id.org/modavis/ontology/events> ;
  vs:term_status "testing" .
