    sh:severity sh:Violation .

modshape:SamplePlaybackParametersShape-playsSample-PropertyShape-07 a sh:PropertyShape ;
    rdfs:label "plays sample property constraint"@en ;
    sh:class modaudio:AudioSample ;
    sh:maxCount 1 ;
    sh:message "Plays sample constraint: exactly 1 value(s) are required; values must be instances of AudioSample."@en ;
    sh:minCount 1 ;
    sh:name "plays sample property constraint"@en ;
    sh:path modaudio:playsSample ;
    sh:severity sh:Violation .

modshape:SamplePlaybackParametersShape-roundRobinGroup-PropertyShape-08 a sh:PropertyShape ;
    rdfs:label "round robin group property constraint"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:message "Round robin group constraint: at most 1 value(s) are permitted; values must use the string datatype; lexical length must be at least 1."@en ;
    sh:minLength 1 ;
    sh:name "round robin group property constraint"@en ;
    sh:path modaudio:roundRobinGroup ;
    sh:severity sh:Violation .

modshape:SamplePlaybackParametersShape-roundRobinIndex-PropertyShape-09 a sh:PropertyShape ;
    rdfs:label "round robin index property constraint"@en ;
    sh:datatype xsd:nonNegativeInteger ;
    sh:maxCount 1 ;
    sh:message "Round robin index constraint: at most 1 value(s) are permitted; values must use the nonNegativeInteger datatype."@en ;
    sh:name "round robin index property constraint"@en ;
    sh:path modaudio:roundRobinIndex ;
    sh:severity sh:Violation .

modshape:SamplePlaybackParametersShape-selectionPriority-PropertyShape-10 a sh:PropertyShape ;
    rdfs:label "selection priority property constraint"@en ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:message "Selection priority constraint: at most 1 value(s) are permitted; values must use the integer datatype."@en ;
    sh:name "selection priority property constraint"@en ;
    sh:path modaudio:selectionPriority ;
    sh:severity sh:Violation .

modshape:SamplePlaybackParametersShape-sourceFundamentalHz-PropertyShape-11 a sh:PropertyShape ;
    rdfs:label "source fundamental hz property constraint"@en ;
    sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:message "Source fundamental hz constraint: at most 1 value(s) are permitted; values must use the decimal datatype; value must be greater than 0."@en ;
    sh:minExclusive 0 ;
    sh:name "source fundamental hz property constraint"@en ;
    sh:path modaudio:sourceFundamentalHz ;
    sh:severity sh:Violation .

modshape:SamplePlaybackParametersShape-targetFrequencyHz-PropertyShape-12 a sh:PropertyShape ;
    rdfs:label "target frequency hz property constraint"@en ;
    sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:message "Target frequency hz constraint: at most 1 value(s) are permitted; values must use the decimal datatype; value must be greater than 0."@en ;
    sh:minExclusive 0 ;
    sh:name "target frequency hz property constraint"@en ;
    sh:path modaudio:targetFrequencyHz ;
    sh:severity sh:Violation .

