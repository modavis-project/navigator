  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SamplePlaybackParametersShape-SPARQLConstraint-01">
    <ns2:label xml:lang="en">sample playback parameters shape sparqlconstraint 01</ns2:label>
    <ns3:message xml:lang="en">A loop point set selected for playback must apply to the sample being played.</ns3:message>
    <ns3:name xml:lang="en">sample playback parameters shape sparqlconstraint 01</ns3:name>
    <ns3:select>
      PREFIX modaudio: &lt;https://w3id.org/modavis/ontology/audio#&gt;
      SELECT $this WHERE {
        $this modaudio:playsSample ?sample ; modaudio:usesLoopPointSet ?loopSet .
        FILTER NOT EXISTS { ?loopSet modaudio:appliesToSignal ?sample . }
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SamplePlaybackParametersShape-SPARQLConstraint-02">
    <ns2:label xml:lang="en">sample playback parameters shape sparqlconstraint 02</ns2:label>
    <ns3:message xml:lang="en">A release region selected for playback must apply to the sample being played.</ns3:message>
    <ns3:name xml:lang="en">sample playback parameters shape sparqlconstraint 02</ns3:name>
    <ns3:select>
      PREFIX modaudio: &lt;https://w3id.org/modavis/ontology/audio#&gt;
      SELECT $this WHERE {
        $this modaudio:playsSample ?sample ; modaudio:usesReleaseRegion ?region .
        FILTER NOT EXISTS { ?region modaudio:appliesToSignal ?sample . }
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SamplePlaybackParametersShape-SPARQLConstraint-03">
    <ns2:label xml:lang="en">sample playback parameters shape sparqlconstraint 03</ns2:label>
    <ns3:message xml:lang="en">A round-robin index requires a non-empty round-robin group identifier.</ns3:message>
    <ns3:name xml:lang="en">sample playback parameters shape sparqlconstraint 03</ns3:name>
    <ns3:select>
      PREFIX modaudio: &lt;https://w3id.org/modavis/ontology/audio#&gt;
      SELECT $this WHERE {
        $this modaudio:roundRobinIndex ?index .
        FILTER NOT EXISTS { $this modaudio:roundRobinGroup ?group . }
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
