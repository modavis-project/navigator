    sh:name "take number property constraint"@en ;
    sh:path modaudio:takeNumber ;
    sh:severity sh:Violation .

modshape:SamplePlaybackParametersShape-SPARQLConstraint-01 rdfs:label "sample playback parameters shape sparqlconstraint 01"@en ;
    sh:message "A loop point set selected for playback must apply to the sample being played."@en ;
    sh:name "sample playback parameters shape sparqlconstraint 01"@en ;
    sh:select """
      PREFIX modaudio: <https://w3id.org/modavis/ontology/audio#>
      SELECT $this WHERE {
        $this modaudio:playsSample ?sample ; modaudio:usesLoopPointSet ?loopSet .
        FILTER NOT EXISTS { ?loopSet modaudio:appliesToSignal ?sample . }
      }
    """ ;
    sh:severity sh:Violation .

modshape:SamplePlaybackParametersShape-SPARQLConstraint-02 rdfs:label "sample playback parameters shape sparqlconstraint 02"@en ;
    sh:message "A release region selected for playback must apply to the sample being played."@en ;
    sh:name "sample playback parameters shape sparqlconstraint 02"@en ;
    sh:select """
      PREFIX modaudio: <https://w3id.org/modavis/ontology/audio#>
      SELECT $this WHERE {
        $this modaudio:playsSample ?sample ; modaudio:usesReleaseRegion ?region .
        FILTER NOT EXISTS { ?region modaudio:appliesToSignal ?sample . }
      }
    """ ;
    sh:severity sh:Violation .

modshape:SamplePlaybackParametersShape-SPARQLConstraint-03 rdfs:label "sample playback parameters shape sparqlconstraint 03"@en ;
    sh:message "A round-robin index requires a non-empty round-robin group identifier."@en ;
    sh:name "sample playback parameters shape sparqlconstraint 03"@en ;
    sh:select """
      PREFIX modaudio: <https://w3id.org/modavis/ontology/audio#>
      SELECT $this WHERE {
        $this modaudio:roundRobinIndex ?index .
        FILTER NOT EXISTS { $this modaudio:roundRobinGroup ?group . }
      }
    """ ;
    sh:severity sh:Violation .

