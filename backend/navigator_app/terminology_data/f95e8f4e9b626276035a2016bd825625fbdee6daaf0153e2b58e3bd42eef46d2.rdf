<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF xmlns:ns1="http://purl.org/dc/terms/" xmlns:ns2="http://purl.org/vocab/vann/" xmlns:ns3="http://www.w3.org/2002/07/owl#" xmlns:ns4="http://www.w3.org/2000/01/rdf-schema#" xmlns:ns5="http://www.w3.org/2003/06/sw-vocab-status/ns#" xmlns:ns6="http://www.w3.org/2004/02/skos/core#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/midi">
    <ns1:conformsTo rdf:resource="https://www.w3.org/TR/owl2-profiles/#OWL_2_RL" />
    <ns1:creator rdf:resource="https://orcid.org/0000-0002-7904-3892" />
    <ns1:description xml:lang="en">MIDI-specific bindings for protocol-neutral MODAVIS audio regions, sampled-playback parameters, and tuning records.</ns1:description>
    <ns1:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-27</ns1:issued>
    <ns1:license rdf:resource="https://creativecommons.org/licenses/by/4.0/" />
    <ns1:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-27</ns1:modified>
    <ns1:publisher rdf:resource="https://orcid.org/0000-0002-7904-3892" />
    <ns1:title xml:lang="en">MODAVIS MIDI Binding Ontology</ns1:title>
    <ns2:preferredNamespacePrefix>modmidi</ns2:preferredNamespacePrefix>
    <ns2:preferredNamespaceUri>https://w3id.org/modavis/ontology/midi#</ns2:preferredNamespaceUri>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology" />
    <ns3:imports rdf:resource="https://w3id.org/modavis/ontology/audio/0.1.0" />
    <ns3:versionIRI rdf:resource="https://w3id.org/modavis/ontology/midi/0.1.0" />
    <ns3:versionInfo>0.1.0</ns3:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/midi#MidiExtractionBinding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/midi" />
    <ns4:label xml:lang="en">MIDI extraction binding</ns4:label>
    <ns4:subClassOf rdf:resource="https://w3id.org/modavis/ontology/core#IdentifiedResource" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">A MIDI note-number assignment bound to a protocol-neutral sample extraction region.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/midi#MidiPlaybackBinding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/midi" />
    <ns4:label xml:lang="en">MIDI playback binding</ns4:label>
    <ns4:subClassOf rdf:resource="https://w3id.org/modavis/ontology/core#IdentifiedResource" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">A MIDI 1.0 note-number and note-on-velocity selection domain bound to protocol-neutral sampled-playback parameters.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/midi#MidiReferencePitchBinding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/midi" />
    <ns4:label xml:lang="en">MIDI reference-pitch binding</ns4:label>
    <ns4:subClassOf rdf:resource="https://w3id.org/modavis/ontology/core#IdentifiedResource" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">A MIDI note number bound to a protocol-neutral tuning reference.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/midi#MidiTuningEntryBinding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/midi" />
    <ns4:label xml:lang="en">MIDI tuning-entry binding</ns4:label>
    <ns4:subClassOf rdf:resource="https://w3id.org/modavis/ontology/core#IdentifiedResource" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">A MIDI note number bound to a protocol-neutral tuning entry.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/midi#assignedNoteNumber">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/midi#MidiExtractionBinding" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/midi" />
    <ns4:label xml:lang="en">assigned MIDI note number</ns4:label>
    <ns4:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">The MIDI note number assigned to the bound sample extraction region.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/midi#extractionRegion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/midi#MidiExtractionBinding" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/midi" />
    <ns4:label xml:lang="en">extraction region</ns4:label>
    <ns4:range rdf:resource="https://w3id.org/modavis/ontology/audio#SampleExtractionRegion" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Identifies the sample extraction region assigned to a MIDI note number.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/midi#maximumNoteNumber">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/midi#MidiPlaybackBinding" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/midi" />
    <ns4:label xml:lang="en">maximum MIDI note number</ns4:label>
    <ns4:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">The inclusive highest MIDI note number selecting the bound playback parameters.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/midi#maximumNoteOnVelocity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/midi#MidiPlaybackBinding" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/midi" />
    <ns4:label xml:lang="en">maximum MIDI note-on velocity</ns4:label>
    <ns4:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">The inclusive highest MIDI note-on velocity selecting the bound playback parameters.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/midi#minimumNoteNumber">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/midi#MidiPlaybackBinding" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/midi" />
    <ns4:label xml:lang="en">minimum MIDI note number</ns4:label>
    <ns4:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">The inclusive lowest MIDI note number selecting the bound playback parameters.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/midi#minimumNoteOnVelocity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/midi#MidiPlaybackBinding" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/midi" />
    <ns4:label xml:lang="en">minimum MIDI note-on velocity</ns4:label>
    <ns4:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">The inclusive lowest MIDI note-on velocity selecting the bound playback parameters.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/midi#noteNumber">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/midi" />
    <ns4:label xml:lang="en">MIDI note number</ns4:label>
    <ns4:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">The MIDI note number bound to a tuning entry or tuning reference.</ns6:definition>
    <ns6:scopeNote xml:lang="en">The exchange profile permits this property on TuningEntry and TuningReference and restricts it to the MIDI range 0–127. A global domain is omitted because asserting both domains would infer an invalid intersection.</ns6:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/midi#playbackParameters">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/midi#MidiPlaybackBinding" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/midi" />
    <ns4:label xml:lang="en">playback parameters</ns4:label>
    <ns4:range rdf:resource="https://w3id.org/modavis/ontology/audio#SamplePlaybackParameters" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Identifies the protocol-neutral sampled-playback parameters to which the MIDI selection domain applies.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/midi#rootNoteNumber">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/midi#MidiPlaybackBinding" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/midi" />
    <ns4:label xml:lang="en">root MIDI note number</ns4:label>
    <ns4:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">The MIDI note number at which the sample plays at its untransposed reference pitch.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/midi#tuningEntry">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/midi#MidiTuningEntryBinding" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/midi" />
    <ns4:label xml:lang="en">binds tuning entry</ns4:label>
    <ns4:range rdf:resource="https://w3id.org/modavis/ontology/audio#TuningEntry" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Identifies the protocol-neutral tuning entry bound to a MIDI note number.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/midi#tuningReference">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <ns4:domain rdf:resource="https://w3id.org/modavis/ontology/midi#MidiReferencePitchBinding" />
    <ns4:isDefinedBy rdf:resource="https://w3id.org/modavis/ontology/midi" />
    <ns4:label xml:lang="en">binds tuning reference</ns4:label>
    <ns4:range rdf:resource="https://w3id.org/modavis/ontology/audio#TuningReference" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Identifies the protocol-neutral tuning reference bound to a MIDI note number.</ns6:definition>
  </rdf:Description>
</rdf:RDF>
