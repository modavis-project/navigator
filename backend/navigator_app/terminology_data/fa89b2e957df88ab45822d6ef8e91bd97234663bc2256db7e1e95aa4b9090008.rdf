    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SamplePlaybackParametersShape-channelPolicy-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SamplePlaybackParametersShape-controlReleasePolicy-PropertyShape-02" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SamplePlaybackParametersShape-gainDB-PropertyShape-03" />
