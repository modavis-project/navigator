        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#FunctionalRoleAssignmentShape-validDuring-PropertyShape-01"
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ],
    "http://www.w3.org/ns/shacl#sparql": [
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#FunctionalRoleAssignmentShape-SPARQLConstraint-01"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://w3id.org/modavis/ontology/instrument#FunctionalRoleAssignment"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#FunctionalRoleAssignmentShape-SPARQLConstraint-01",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "functional role assignment shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "A role assignment's state and configuration qualifiers must concern the same musical instrument."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "functional role assignment shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      PREFIX modinst: <https://w3id.org/modavis/ontology/instrument#>\n      SELECT $this WHERE {\n        $this modinst:appliesInConfiguration ?configuration ;\n              modinst:appliesInState ?state .\n        ?configuration modinst:configurationOf ?configurationInstrument .\n        ?state modinst:stateOf ?stateInstrument .\n        FILTER (?configurationInstrument != ?stateInstrument)\n      }\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
