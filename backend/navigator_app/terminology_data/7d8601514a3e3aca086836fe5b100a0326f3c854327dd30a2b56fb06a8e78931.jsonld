  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#SamplePlaybackParametersShape-SPARQLConstraint-01",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "sample playback parameters shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "A loop point set selected for playback must apply to the sample being played."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "sample playback parameters shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      PREFIX modaudio: <https://w3id.org/modavis/ontology/audio#>\n      SELECT $this WHERE {\n        $this modaudio:playsSample ?sample ; modaudio:usesLoopPointSet ?loopSet .\n        FILTER NOT EXISTS { ?loopSet modaudio:appliesToSignal ?sample . }\n      }\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#SamplePlaybackParametersShape-SPARQLConstraint-02",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "sample playback parameters shape sparqlconstraint 02"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "A release region selected for playback must apply to the sample being played."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "sample playback parameters shape sparqlconstraint 02"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      PREFIX modaudio: <https://w3id.org/modavis/ontology/audio#>\n      SELECT $this WHERE {\n        $this modaudio:playsSample ?sample ; modaudio:usesReleaseRegion ?region .\n        FILTER NOT EXISTS { ?region modaudio:appliesToSignal ?sample . }\n      }\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#SamplePlaybackParametersShape-SPARQLConstraint-03",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "sample playback parameters shape sparqlconstraint 03"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "A round-robin index requires a non-empty round-robin group identifier."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "sample playback parameters shape sparqlconstraint 03"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      PREFIX modaudio: <https://w3id.org/modavis/ontology/audio#>\n      SELECT $this WHERE {\n        $this modaudio:roundRobinIndex ?index .\n        FILTER NOT EXISTS { $this modaudio:roundRobinGroup ?group . }\n      }\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
