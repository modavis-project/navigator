<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF xmlns:ns1="http://purl.org/dc/terms/" xmlns:ns2="http://www.w3.org/2000/01/rdf-schema#" xmlns:ns3="http://www.w3.org/ns/shacl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0">
    <ns1:conformsTo rdf:resource="https://www.w3.org/TR/shacl/" />
    <ns1:creator rdf:resource="https://orcid.org/0000-0002-7904-3892" />
    <ns1:description xml:lang="en">Versioned exchange conformance profile for MODAVIS 0.1.0 data.</ns1:description>
    <ns1:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-27</ns1:issued>
    <ns1:license rdf:resource="https://creativecommons.org/licenses/by/4.0/" />
    <ns1:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-27</ns1:modified>
    <ns1:publisher rdf:resource="https://orcid.org/0000-0002-7904-3892" />
    <ns1:requires rdf:resource="https://w3id.org/modavis/ontology/0.1.0" />
    <ns1:title xml:lang="en">MODAVIS exchange SHACL profile</ns1:title>
    <rdf:type rdf:resource="http://purl.org/dc/terms/Standard" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#AssertionShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">assertion shape</ns2:label>
    <ns3:message xml:lang="en">The focus node must satisfy the named logical, node-kind, or lexical constraint declared by this shape.</ns3:message>
    <ns3:name xml:lang="en">assertion shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#AssertionShape-assertionStatus-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#AssertionShape-assertsLiteral-PropertyShape-02" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#AssertionShape-assertsObject-PropertyShape-03" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#AssertionShape-assertsPredicate-PropertyShape-04" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#AssertionShape-assertsSubject-PropertyShape-05" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#AssertionShape-confidence-PropertyShape-06" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#AssertionShape-hasEvidenceRelation-PropertyShape-07" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#AssertionShape-SPARQLConstraint-01" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#AssertionShape-SPARQLConstraint-02" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/assertion#Assertion" />
    <ns3:xone rdf:nodeID="cbf100f4bf0b7b856fd31adcf08e53e7776c9d565629243023fb09221f6ea68992" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#AssertionShape-SPARQLConstraint-01">
    <ns2:label xml:lang="en">assertion shape sparqlconstraint 01</ns2:label>
    <ns3:message xml:lang="en">An assertion-supersession chain cannot contain a cycle.</ns3:message>
    <ns3:name xml:lang="en">assertion shape sparqlconstraint 01</ns3:name>
    <ns3:select>
      PREFIX modassert: &lt;https://w3id.org/modavis/ontology/assertion#&gt;
      SELECT $this WHERE { $this modassert:supersedes+ $this . }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#AssertionShape-SPARQLConstraint-02">
    <ns2:label xml:lang="en">assertion shape sparqlconstraint 02</ns2:label>
    <ns3:message xml:lang="en">Every evidence relation linked from an assertion must identify that assertion as the resource it evaluates.</ns3:message>
    <ns3:name xml:lang="en">assertion shape sparqlconstraint 02</ns3:name>
    <ns3:select>
      PREFIX modassert: &lt;https://w3id.org/modavis/ontology/assertion#&gt;
      PREFIX modevidence: &lt;https://w3id.org/modavis/ontology/evidence#&gt;
      SELECT $this WHERE {
        $this modassert:hasEvidenceRelation ?relation .
        FILTER NOT EXISTS { ?relation modevidence:evaluates $this . }
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#AssertionShape-assertionStatus-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">assertion status property constraint</ns2:label>
    <ns3:in rdf:nodeID="cb112288dff55f393516d6f8036623c30d0d6c9340ee7b7c1491320aed78839982d" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Assertion status constraint: exactly 1 value(s) are required; values must have node kind IRI; values must belong to the enumerated release set.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">assertion status property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/assertion#assertionStatus" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#AssertionShape-assertsLiteral-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">asserts literal property constraint</ns2:label>
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</ns3:maxCount>
    <ns3:message xml:lang="en">Asserts literal constraint: at most 0 value(s) are permitted.</ns3:message>
    <ns3:name xml:lang="en">asserts literal property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/assertion#assertsLiteral" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#AssertionShape-assertsLiteral-PropertyShape-08">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">asserts literal property constraint</ns2:label>
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</ns3:maxCount>
    <ns3:message xml:lang="en">Asserts literal constraint: at most 0 value(s) are permitted.</ns3:message>
    <ns3:name xml:lang="en">asserts literal property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/assertion#assertsLiteral" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#AssertionShape-assertsLiteral-PropertyShape-10">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">asserts literal property constraint</ns2:label>
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Asserts literal constraint: exactly 1 value(s) are required; values must have node kind Literal.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">asserts literal property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal" />
