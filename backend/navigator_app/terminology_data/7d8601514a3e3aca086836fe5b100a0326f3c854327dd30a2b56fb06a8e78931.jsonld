      {
        "@language": "en",
        "@value": "Membership instrument constraint: exactly 1 value(s) are required; values must be instances of MusicalInstrument."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
