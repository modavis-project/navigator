    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/modavis/ontology/core#IdentifiedResource"
      }
    ],
    "http://www.w3.org/2003/06/sw-vocab-status/ns#term_status": [
      {
        "@value": "testing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A citable occurrence or process in the documented world, distinct from the computational or editorial activity that recorded it."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "No equivalence or disjointness with prov:Activity is asserted. Historical event semantics and processing provenance remain separate roles and records."
      }
    ]
  },
