  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#SustainLoopRegionShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "sustain loop region shape"
      }
    ],
