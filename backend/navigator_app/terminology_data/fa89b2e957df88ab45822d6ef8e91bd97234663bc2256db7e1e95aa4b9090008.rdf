    <ns2:label xml:lang="en">instrument type property constraint</ns2:label>
    <ns3:message xml:lang="en">A released instrument requires at least one governed instrument type.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">instrument type property constraint</ns3:name>
