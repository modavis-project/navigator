        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "Applies in configuration constraint: at most 1 value(s) are permitted; values must be instances of InstrumentConfiguration."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "applies in configuration property constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
