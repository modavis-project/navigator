        "@value": "testing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Records a source-preserving nominal organ pitch designation such as 8′ or 2 2/3′ without treating it as an exact measured frequency."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "The exchange profile permits this source designation on organ stops and ranks. It is documentary notation, not a numeric acoustical measurement or tuning assertion."
      }
