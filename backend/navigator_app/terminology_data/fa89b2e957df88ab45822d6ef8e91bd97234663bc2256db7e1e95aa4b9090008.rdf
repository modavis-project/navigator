    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#AssertionShape-assertsObject-PropertyShape-03">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">asserts object property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/core#Agent" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">The MODAVIS 0.1.0 has-builder assertion predicate requires an identified agent object, not a literal.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">asserts object property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/assertion#assertsObject" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#AssertionShape-assertsObject-PropertyShape-09">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">asserts object property constraint</ns2:label>
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Asserts object constraint: exactly 1 value(s) are required; values must have node kind IRI.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">asserts object property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/assertion#assertsObject" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#AssertionShape-assertsObject-PropertyShape-11">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">asserts object property constraint</ns2:label>
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</ns3:maxCount>
    <ns3:message xml:lang="en">Asserts object constraint: at most 0 value(s) are permitted.</ns3:message>
    <ns3:name xml:lang="en">asserts object property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/assertion#assertsObject" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#AssertionShape-assertsPredicate-PropertyShape-04">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">asserts predicate property constraint</ns2:label>
    <ns3:in rdf:nodeID="cb1999a5c2e5c955c893a99584c2fa80e1cb040e9f17d1549b65f72b31ec548e11a" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Asserts predicate constraint: exactly 1 value(s) are required; values must have node kind IRI; values must belong to the enumerated release set.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">asserts predicate property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/assertion#assertsPredicate" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#AssertionShape-assertsSubject-PropertyShape-05">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">asserts subject property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/instrument#MusicalInstrument" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">The MODAVIS 0.1.0 has-builder assertion predicate requires a musical-instrument subject.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">asserts subject property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/assertion#assertsSubject" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#AssertionShape-confidence-PropertyShape-06">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">confidence property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxInclusive>
    <ns3:message xml:lang="en">Confidence constraint: at most 1 value(s) are permitted; values must use the decimal datatype; value must be at least 0; value must be at most 1.</ns3:message>
    <ns3:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</ns3:minInclusive>
    <ns3:name xml:lang="en">confidence property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/assertion#confidence" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#AssertionShape-hasEvidenceRelation-PropertyShape-07">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">has evidence relation property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/evidence#EvidenceRelation" />
    <ns3:message xml:lang="en">Has evidence relation constraint: at least 1 value(s) are required; values must be instances of EvidenceRelation.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">has evidence relation property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/assertion#hasEvidenceRelation" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#AssertionShape-xone-Alternative-NodeShape-01">
