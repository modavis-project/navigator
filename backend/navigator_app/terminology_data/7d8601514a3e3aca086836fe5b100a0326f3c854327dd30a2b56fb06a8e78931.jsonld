    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://w3id.org/modavis/ontology/evidence#selectorType"
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#SelectorShape-selectorValue-PropertyShape-03",
    "@type": [
      "http://www.w3.org/ns/shacl#PropertyShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "selector value property constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#datatype": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/ns/shacl#maxCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "Selector value constraint: exactly 1 value(s) are required; values must use the string datatype; lexical length must be at least 1."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#minLength": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "selector value property constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://w3id.org/modavis/ontology/evidence#selectorValue"
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "signal region shape"
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "signal region shape"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-appliesToSignal-PropertyShape-01"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-boundaryCensoring-PropertyShape-02"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-boundaryConfidence-PropertyShape-03"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-endFrameExclusive-PropertyShape-04"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-exitPolicy-PropertyShape-05"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-playbackMode-PropertyShape-06"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-referenceChannelIndex-PropertyShape-07"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-regionRole-PropertyShape-08"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-releaseStartFrame-PropertyShape-09"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-startFrameInclusive-PropertyShape-10"
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ],
    "http://www.w3.org/ns/shacl#sparql": [
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-SPARQLConstraint-01"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-SPARQLConstraint-02"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-SPARQLConstraint-03"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-SPARQLConstraint-04"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-SPARQLConstraint-05"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://w3id.org/modavis/ontology/audio#SignalRegion"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-SPARQLConstraint-01",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "signal region shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "A region reference-channel index must be smaller than the fixed signal's channel count."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "signal region shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      PREFIX modaudio: <https://w3id.org/modavis/ontology/audio#>\n      SELECT $this WHERE {\n        $this modaudio:appliesToSignal ?signal ; modaudio:referenceChannelIndex ?index .\n        ?signal modaudio:channelCount ?count .\n        FILTER (?index >= ?count)\n      }\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-SPARQLConstraint-02",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "signal region shape sparqlconstraint 02"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "A region's release start frame cannot exceed the fixed signal's total frame count."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "signal region shape sparqlconstraint 02"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      PREFIX modaudio: <https://w3id.org/modavis/ontology/audio#>\n      SELECT $this WHERE {\n        $this modaudio:appliesToSignal ?signal ; modaudio:releaseStartFrame ?release .\n        ?signal modaudio:totalFrames ?total .\n        FILTER (?release > ?total)\n      }\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-SPARQLConstraint-03",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "signal region shape sparqlconstraint 03"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "A region's release start frame cannot precede its inclusive start frame."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "signal region shape sparqlconstraint 03"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      PREFIX modaudio: <https://w3id.org/modavis/ontology/audio#>\n      SELECT $this WHERE {\n        $this modaudio:startFrameInclusive ?start ; modaudio:releaseStartFrame ?release .\n        FILTER (?release < ?start)\n      }\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-SPARQLConstraint-04",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "signal region shape sparqlconstraint 04"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "A signal region's exclusive end frame cannot exceed the fixed signal's total frame count."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "signal region shape sparqlconstraint 04"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      PREFIX modaudio: <https://w3id.org/modavis/ontology/audio#>\n      SELECT $this WHERE {\n        $this modaudio:appliesToSignal ?signal ; modaudio:endFrameExclusive ?end .\n        ?signal modaudio:totalFrames ?total .\n        FILTER (?end > ?total)\n      }\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-SPARQLConstraint-05",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "signal region shape sparqlconstraint 05"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "A signal region's exclusive end frame must be greater than its inclusive start frame."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "signal region shape sparqlconstraint 05"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      PREFIX modaudio: <https://w3id.org/modavis/ontology/audio#>\n      SELECT $this WHERE {\n        $this modaudio:startFrameInclusive ?start ; modaudio:endFrameExclusive ?end .\n        FILTER (?end <= ?start)\n      }\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
