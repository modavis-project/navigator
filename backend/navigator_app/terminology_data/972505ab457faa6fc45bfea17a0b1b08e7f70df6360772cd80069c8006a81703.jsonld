  {
    "@id": "https://w3id.org/modavis/vocab/representation-status/measured",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/modavis/vocab"
      }
    ],
