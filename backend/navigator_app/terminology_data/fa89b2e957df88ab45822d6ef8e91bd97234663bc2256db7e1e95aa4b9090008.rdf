    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SelectorShape-selectorConformsTo-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">selector conforms to property constraint</ns2:label>
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Selector conforms to constraint: at most 1 value(s) are permitted; values must have node kind IRI.</ns3:message>
    <ns3:name xml:lang="en">selector conforms to property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/evidence#selectorConformsTo" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SelectorShape-selectorConformsTo-PropertyShape-05">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">selector conforms to property constraint</ns2:label>
    <ns3:message xml:lang="en">Selector conforms to constraint: at least 1 value(s) are required.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">selector conforms to property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/evidence#selectorConformsTo" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SelectorShape-selectorType-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">selector type property constraint</ns2:label>
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Selector type constraint: at most 1 value(s) are permitted; values must have node kind IRI.</ns3:message>
    <ns3:name xml:lang="en">selector type property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/evidence#selectorType" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SelectorShape-selectorType-PropertyShape-04">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">selector type property constraint</ns2:label>
    <ns3:message xml:lang="en">Selector type constraint: at least 1 value(s) are required.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">selector type property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/evidence#selectorType" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SelectorShape-selectorValue-PropertyShape-03">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">selector value property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Selector value constraint: exactly 1 value(s) are required; values must use the string datatype; lexical length must be at least 1.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:minLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minLength>
    <ns3:name xml:lang="en">selector value property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/evidence#selectorValue" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">signal region shape</ns2:label>
    <ns3:name xml:lang="en">signal region shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-appliesToSignal-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-boundaryCensoring-PropertyShape-02" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-boundaryConfidence-PropertyShape-03" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-endFrameExclusive-PropertyShape-04" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-exitPolicy-PropertyShape-05" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-playbackMode-PropertyShape-06" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-referenceChannelIndex-PropertyShape-07" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-regionRole-PropertyShape-08" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-releaseStartFrame-PropertyShape-09" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-startFrameInclusive-PropertyShape-10" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-SPARQLConstraint-01" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-SPARQLConstraint-02" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-SPARQLConstraint-03" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-SPARQLConstraint-04" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-SPARQLConstraint-05" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/audio#SignalRegion" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-SPARQLConstraint-01">
    <ns2:label xml:lang="en">signal region shape sparqlconstraint 01</ns2:label>
    <ns3:message xml:lang="en">A region reference-channel index must be smaller than the fixed signal's channel count.</ns3:message>
    <ns3:name xml:lang="en">signal region shape sparqlconstraint 01</ns3:name>
    <ns3:select>
      PREFIX modaudio: &lt;https://w3id.org/modavis/ontology/audio#&gt;
      SELECT $this WHERE {
        $this modaudio:appliesToSignal ?signal ; modaudio:referenceChannelIndex ?index .
        ?signal modaudio:channelCount ?count .
        FILTER (?index &gt;= ?count)
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-SPARQLConstraint-02">
    <ns2:label xml:lang="en">signal region shape sparqlconstraint 02</ns2:label>
    <ns3:message xml:lang="en">A region's release start frame cannot exceed the fixed signal's total frame count.</ns3:message>
    <ns3:name xml:lang="en">signal region shape sparqlconstraint 02</ns3:name>
    <ns3:select>
      PREFIX modaudio: &lt;https://w3id.org/modavis/ontology/audio#&gt;
      SELECT $this WHERE {
        $this modaudio:appliesToSignal ?signal ; modaudio:releaseStartFrame ?release .
        ?signal modaudio:totalFrames ?total .
        FILTER (?release &gt; ?total)
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-SPARQLConstraint-03">
    <ns2:label xml:lang="en">signal region shape sparqlconstraint 03</ns2:label>
    <ns3:message xml:lang="en">A region's release start frame cannot precede its inclusive start frame.</ns3:message>
    <ns3:name xml:lang="en">signal region shape sparqlconstraint 03</ns3:name>
    <ns3:select>
      PREFIX modaudio: &lt;https://w3id.org/modavis/ontology/audio#&gt;
      SELECT $this WHERE {
        $this modaudio:startFrameInclusive ?start ; modaudio:releaseStartFrame ?release .
        FILTER (?release &lt; ?start)
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-SPARQLConstraint-04">
    <ns2:label xml:lang="en">signal region shape sparqlconstraint 04</ns2:label>
    <ns3:message xml:lang="en">A signal region's exclusive end frame cannot exceed the fixed signal's total frame count.</ns3:message>
    <ns3:name xml:lang="en">signal region shape sparqlconstraint 04</ns3:name>
    <ns3:select>
      PREFIX modaudio: &lt;https://w3id.org/modavis/ontology/audio#&gt;
      SELECT $this WHERE {
        $this modaudio:appliesToSignal ?signal ; modaudio:endFrameExclusive ?end .
        ?signal modaudio:totalFrames ?total .
        FILTER (?end &gt; ?total)
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-SPARQLConstraint-05">
    <ns2:label xml:lang="en">signal region shape sparqlconstraint 05</ns2:label>
    <ns3:message xml:lang="en">A signal region's exclusive end frame must be greater than its inclusive start frame.</ns3:message>
    <ns3:name xml:lang="en">signal region shape sparqlconstraint 05</ns3:name>
    <ns3:select>
      PREFIX modaudio: &lt;https://w3id.org/modavis/ontology/audio#&gt;
      SELECT $this WHERE {
        $this modaudio:startFrameInclusive ?start ; modaudio:endFrameExclusive ?end .
        FILTER (?end &lt;= ?start)
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-appliesToSignal-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">applies to signal property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/audio#AudioSignal" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Applies to signal constraint: exactly 1 value(s) are required; values must be instances of AudioSignal.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">applies to signal property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/audio#appliesToSignal" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-boundaryCensoring-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">boundary censoring property constraint</ns2:label>
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Boundary censoring constraint: at most 1 value(s) are permitted; values must have node kind IRI.</ns3:message>
    <ns3:name xml:lang="en">boundary censoring property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/audio#boundaryCensoring" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-boundaryConfidence-PropertyShape-03">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">boundary confidence property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxInclusive>
    <ns3:message xml:lang="en">Boundary confidence constraint: at most 1 value(s) are permitted; values must use the decimal datatype; value must be at least 0; value must be at most 1.</ns3:message>
    <ns3:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</ns3:minInclusive>
    <ns3:name xml:lang="en">boundary confidence property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/audio#boundaryConfidence" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-endFrameExclusive-PropertyShape-04">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">end frame exclusive property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">End frame exclusive constraint: exactly 1 value(s) are required; values must use the positiveInteger datatype.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">end frame exclusive property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/audio#endFrameExclusive" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-exitPolicy-PropertyShape-05">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">exit policy property constraint</ns2:label>
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Exit policy constraint: at most 1 value(s) are permitted; values must have node kind IRI.</ns3:message>
    <ns3:name xml:lang="en">exit policy property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/audio#exitPolicy" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-playbackMode-PropertyShape-06">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">playback mode property constraint</ns2:label>
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Playback mode constraint: at most 1 value(s) are permitted; values must have node kind IRI.</ns3:message>
    <ns3:name xml:lang="en">playback mode property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/audio#playbackMode" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-referenceChannelIndex-PropertyShape-07">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">reference channel index property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Reference channel index constraint: at most 1 value(s) are permitted; values must use the nonNegativeInteger datatype.</ns3:message>
    <ns3:name xml:lang="en">reference channel index property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/audio#referenceChannelIndex" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-regionRole-PropertyShape-08">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">region role property constraint</ns2:label>
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Region role constraint: at most 1 value(s) are permitted; values must have node kind IRI.</ns3:message>
    <ns3:name xml:lang="en">region role property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/audio#regionRole" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-releaseStartFrame-PropertyShape-09">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">release start frame property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Release start frame constraint: at most 1 value(s) are permitted; values must use the nonNegativeInteger datatype.</ns3:message>
    <ns3:name xml:lang="en">release start frame property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/audio#releaseStartFrame" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SignalRegionShape-startFrameInclusive-PropertyShape-10">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">start frame inclusive property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Start frame inclusive constraint: exactly 1 value(s) are required; values must use the nonNegativeInteger datatype.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">start frame inclusive property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/audio#startFrameInclusive" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SourceFragmentShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">source fragment shape</ns2:label>
    <ns3:name xml:lang="en">source fragment shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SourceFragmentShape-fragmentOf-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SourceFragmentShape-hasSelector-PropertyShape-02" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/evidence#SourceFragment" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SourceFragmentShape-fragmentOf-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">fragment of property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/evidence#SourceSnapshot" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Fragment of constraint: exactly 1 value(s) are required; values must be instances of SourceSnapshot.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">fragment of property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/evidence#fragmentOf" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SourceFragmentShape-hasSelector-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">has selector property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/evidence#Selector" />
    <ns3:message xml:lang="en">Has selector constraint: at least 1 value(s) are required; values must be instances of Selector.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">has selector property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/evidence#hasSelector" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SourceResourceShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">source resource shape</ns2:label>
    <ns3:name xml:lang="en">source resource shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SourceResourceShape-sourceUri-PropertyShape-01" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/evidence#SourceResource" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SourceResourceShape-sourceUri-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">source uri property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI" />
    <ns3:message xml:lang="en">Source uri constraint: values must use the anyURI datatype; lexical form must match the declared pattern.</ns3:message>
    <ns3:name xml:lang="en">source uri property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/evidence#sourceUri" />
    <ns3:pattern>^[A-Za-z][A-Za-z0-9+.-]*:</ns3:pattern>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SourceSnapshotShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">source snapshot shape</ns2:label>
    <ns3:name xml:lang="en">source snapshot shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SourceSnapshotShape-hasChecksum-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SourceSnapshotShape-snapshotCapturedAt-PropertyShape-03" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SourceSnapshotShape-snapshotCapturedBy-PropertyShape-04" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SourceSnapshotShape-snapshotOf-PropertyShape-02" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/evidence#SourceSnapshot" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SourceSnapshotShape-hasChecksum-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">has checksum property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/evidence#Checksum" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A fixed source snapshot requires exactly one qualified checksum under the closed MODAVIS 0.1.0 algorithm profile.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">has checksum property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/evidence#hasChecksum" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SourceSnapshotShape-snapshotCapturedAt-PropertyShape-03">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">snapshot captured at property constraint</ns2:label>
    <ns2:label xml:lang="en">source snapshot capture time property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A source snapshot requires exactly one timezone-qualified xsd:dateTime capture instant.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">snapshot captured at property constraint</ns3:name>
    <ns3:name xml:lang="en">source snapshot capture time property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/evidence#snapshotCapturedAt" />
    <ns3:pattern>(Z|[+-](0[0-9]|1[0-4]):[0-5][0-9])$</ns3:pattern>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SourceSnapshotShape-snapshotCapturedBy-PropertyShape-04">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">snapshot captured by property constraint</ns2:label>
    <ns2:label xml:lang="en">source snapshot capture activity property constraint</ns2:label>
    <ns3:class rdf:resource="http://www.w3.org/ns/prov#Activity" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A source snapshot requires exactly one accountable generating activity.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">snapshot captured by property constraint</ns3:name>
    <ns3:name xml:lang="en">source snapshot capture activity property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/evidence#snapshotCapturedBy" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SourceSnapshotShape-snapshotOf-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">snapshot of property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/evidence#SourceResource" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Snapshot of constraint: exactly 1 value(s) are required; values must be instances of SourceResource.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">snapshot of property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/evidence#snapshotOf" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SustainLoopRegionShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">sustain loop region shape</ns2:label>
    <ns3:name xml:lang="en">sustain loop region shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SustainLoopRegionShape-crossfadeFrames-PropertyShape-01" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#SustainLoopRegionShape-SPARQLConstraint-01" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/audio#SustainLoopRegion" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SustainLoopRegionShape-SPARQLConstraint-01">
    <ns2:label xml:lang="en">sustain loop region shape sparqlconstraint 01</ns2:label>
    <ns3:message xml:lang="en">A loop crossfade cannot be longer than the loop interval.</ns3:message>
    <ns3:name xml:lang="en">sustain loop region shape sparqlconstraint 01</ns3:name>
    <ns3:select>
      PREFIX modaudio: &lt;https://w3id.org/modavis/ontology/audio#&gt;
      SELECT $this WHERE {
        $this modaudio:startFrameInclusive ?start ;
              modaudio:endFrameExclusive ?end ;
              modaudio:crossfadeFrames ?crossfade .
        FILTER (?crossfade &gt; (?end - ?start))
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#SustainLoopRegionShape-crossfadeFrames-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">crossfade frames property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Crossfade frames constraint: at most 1 value(s) are permitted; values must use the nonNegativeInteger datatype.</ns3:message>
    <ns3:name xml:lang="en">crossfade frames property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/audio#crossfadeFrames" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">time span shape</ns2:label>
    <ns3:message xml:lang="en">A time span requires a start, end, or raw temporal expression.</ns3:message>
    <ns3:name xml:lang="en">time span shape</ns3:name>
    <ns3:or rdf:nodeID="cbd4cfb3c5827a9801a53aca371b1213c59de0450eb45d8c5c3020367baaee705a" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape-endDate-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape-endDateTime-PropertyShape-02" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape-rawTemporalExpression-PropertyShape-03" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape-startDate-PropertyShape-04" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape-startDateTime-PropertyShape-05" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape-temporalCertainty-PropertyShape-06" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape-temporalPrecision-PropertyShape-07" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape-SPARQLConstraint-01" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/core#TimeSpan" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape-SPARQLConstraint-01">
    <ns2:label xml:lang="en">time span shape sparqlconstraint 01</ns2:label>
    <ns3:message xml:lang="en">A time span must not mix xsd:date and xsd:dateTime boundary systems on the same node.</ns3:message>
    <ns3:name xml:lang="en">time span shape sparqlconstraint 01</ns3:name>
    <ns3:select>
      PREFIX modavis: &lt;https://w3id.org/modavis/ontology/core#&gt;
      SELECT $this WHERE {
        $this ?dateProperty ?dateValue ; ?dateTimeProperty ?dateTimeValue .
        FILTER (?dateProperty IN (modavis:startDate, modavis:endDate))
        FILTER (?dateTimeProperty IN (modavis:startDateTime, modavis:endDateTime))
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape-endDate-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">end date property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">End date constraint: at most 1 value(s) are permitted; values must use the date datatype.</ns3:message>
    <ns3:name xml:lang="en">end date property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/core#endDate" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape-endDate-PropertyShape-09">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">end date property constraint</ns2:label>
    <ns3:message xml:lang="en">End date constraint: at least 1 value(s) are required.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">end date property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/core#endDate" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape-endDateTime-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">end date time property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">An end date-time must be a timezone-qualified xsd:dateTime and occur at most once.</ns3:message>
    <ns3:name xml:lang="en">end date time property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/core#endDateTime" />
    <ns3:pattern>(Z|[+-](0[0-9]|1[0-4]):[0-5][0-9])$</ns3:pattern>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape-endDateTime-PropertyShape-11">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">end date time property constraint</ns2:label>
    <ns3:message xml:lang="en">End date time constraint: at least 1 value(s) are required.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">end date time property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/core#endDateTime" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape-or-Alternative-NodeShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">time span shape or alternative node shape 01</ns2:label>
    <ns3:name xml:lang="en">time span shape or alternative node shape 01</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape-startDate-PropertyShape-08" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape-or-Alternative-NodeShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">time span shape or alternative node shape 02</ns2:label>
    <ns3:name xml:lang="en">time span shape or alternative node shape 02</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape-endDate-PropertyShape-09" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape-or-Alternative-NodeShape-03">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">time span shape or alternative node shape 03</ns2:label>
    <ns3:name xml:lang="en">time span shape or alternative node shape 03</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape-startDateTime-PropertyShape-10" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape-or-Alternative-NodeShape-04">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">time span shape or alternative node shape 04</ns2:label>
    <ns3:name xml:lang="en">time span shape or alternative node shape 04</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape-endDateTime-PropertyShape-11" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape-or-Alternative-NodeShape-05">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape" />
    <ns2:label xml:lang="en">time span shape or alternative node shape 05</ns2:label>
    <ns3:name xml:lang="en">time span shape or alternative node shape 05</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape-rawTemporalExpression-PropertyShape-12" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape-rawTemporalExpression-PropertyShape-03">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">raw temporal expression property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A raw temporal expression, when supplied, must be a non-empty string.</ns3:message>
    <ns3:minLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minLength>
    <ns3:name xml:lang="en">raw temporal expression property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/core#rawTemporalExpression" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape-rawTemporalExpression-PropertyShape-12">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">raw temporal expression property constraint</ns2:label>
    <ns3:message xml:lang="en">Raw temporal expression constraint: at least 1 value(s) are required.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">raw temporal expression property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/core#rawTemporalExpression" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape-startDate-PropertyShape-04">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">start date property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
    <ns3:lessThanOrEquals rdf:resource="https://w3id.org/modavis/ontology/core#endDate" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A time span's start date cannot be later than its end date.</ns3:message>
    <ns3:name xml:lang="en">start date property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/core#startDate" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape-startDate-PropertyShape-08">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">start date property constraint</ns2:label>
    <ns3:message xml:lang="en">Start date constraint: at least 1 value(s) are required.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">start date property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/core#startDate" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape-startDateTime-PropertyShape-05">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">start date time property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
    <ns3:lessThanOrEquals rdf:resource="https://w3id.org/modavis/ontology/core#endDateTime" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">A start date-time must include a timezone and cannot be later than the end date-time.</ns3:message>
    <ns3:name xml:lang="en">start date time property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/core#startDateTime" />
    <ns3:pattern>(Z|[+-](0[0-9]|1[0-4]):[0-5][0-9])$</ns3:pattern>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape-startDateTime-PropertyShape-10">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">start date time property constraint</ns2:label>
    <ns3:message xml:lang="en">Start date time constraint: at least 1 value(s) are required.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">start date time property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/core#startDateTime" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
