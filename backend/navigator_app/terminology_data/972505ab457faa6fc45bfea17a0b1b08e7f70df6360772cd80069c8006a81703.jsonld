      {
        "@value": "testing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The virtual instrument combines recorded, modeled, or reconstructed material from more than one identified source instrument or state."
