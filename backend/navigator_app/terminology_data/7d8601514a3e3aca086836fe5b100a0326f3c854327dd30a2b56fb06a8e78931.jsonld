  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#ConflictDecisionShape-SPARQLConstraint-01",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "conflict decision shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "A chosen assertion must be a member of the conflict set addressed by the decision."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "conflict decision shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      PREFIX modassert: <https://w3id.org/modavis/ontology/assertion#>\n      SELECT $this WHERE {\n        $this modassert:decisionFor ?conflict ; modassert:chosenAssertion ?chosen .\n        FILTER NOT EXISTS { ?conflict modassert:hasConflictMember ?chosen . }\n      }\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
