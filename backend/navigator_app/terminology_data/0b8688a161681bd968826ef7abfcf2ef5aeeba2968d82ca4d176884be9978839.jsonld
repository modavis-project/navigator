        "@id": "https://w3id.org/modavis/ontology/core#Agent"
      }
    ],
    "http://www.w3.org/2003/06/sw-vocab-status/ns#term_status": [
      {
        "@value": "testing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Relates a virtual-instrument product or version to an agent responsible for its development."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "The subject is a product or version. A global domain is omitted because multiple domain axioms would infer that every subject is both classes."
      }
    ]
  },
