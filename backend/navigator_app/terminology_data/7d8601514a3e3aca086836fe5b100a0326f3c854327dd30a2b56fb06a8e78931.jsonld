  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#IdentifiedResourceShape-canonicalLabel-PropertyShape-01",
    "@type": [
      "http://www.w3.org/ns/shacl#PropertyShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "canonical label property constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#datatype": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "Canonical label constraint: values must use the langString datatype; at most one value is permitted per language."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "canonical label property constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://w3id.org/modavis/ontology/core#canonicalLabel"
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ],
    "http://www.w3.org/ns/shacl#uniqueLang": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": true
      }
    ]
  },
  {
