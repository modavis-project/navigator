    <ns4:label xml:lang="en">version label</ns4:label>
    <ns4:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">The source-preserving version or edition label supplied for a virtual-instrument version.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/virtual-instrument#versionOfProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
