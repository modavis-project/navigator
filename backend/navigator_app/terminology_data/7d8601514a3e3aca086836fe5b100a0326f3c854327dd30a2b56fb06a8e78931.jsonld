      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "component membership shape"
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "component membership shape"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-appliesInConfiguration-PropertyShape-01"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-appliesInState-PropertyShape-02"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-childComponent-PropertyShape-03"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-membershipInstrument-PropertyShape-04"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-membershipType-PropertyShape-05"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-parentComponent-PropertyShape-06"
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ],
    "http://www.w3.org/ns/shacl#sparql": [
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-SPARQLConstraint-01"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-SPARQLConstraint-02"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-SPARQLConstraint-03"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-SPARQLConstraint-04"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://w3id.org/modavis/ontology/instrument#ComponentMembership"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-SPARQLConstraint-01",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "component membership shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "A component membership cannot relate a component to itself."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "component membership shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      PREFIX modinst: <https://w3id.org/modavis/ontology/instrument#>\n      SELECT $this WHERE {\n        $this modinst:parentComponent ?component ;\n              modinst:childComponent ?component .\n      }\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-SPARQLConstraint-02",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "component membership shape sparqlconstraint 02"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "A membership configuration must belong to the membership instrument."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "component membership shape sparqlconstraint 02"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      PREFIX modinst: <https://w3id.org/modavis/ontology/instrument#>\n      SELECT $this WHERE {\n        $this modinst:membershipInstrument ?instrument ;\n              modinst:appliesInConfiguration ?configuration .\n        FILTER NOT EXISTS { ?configuration modinst:configurationOf ?instrument . }\n      }\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-SPARQLConstraint-03",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "component membership shape sparqlconstraint 03"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "A membership state must describe the membership instrument."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "component membership shape sparqlconstraint 03"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      PREFIX modinst: <https://w3id.org/modavis/ontology/instrument#>\n      SELECT $this WHERE {\n        $this modinst:membershipInstrument ?instrument ;\n              modinst:appliesInState ?state .\n        FILTER NOT EXISTS { ?state modinst:stateOf ?instrument . }\n      }\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-SPARQLConstraint-04",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "component membership shape sparqlconstraint 04"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "A hasMembership discovery link must originate from the membership instrument or recorded parent component."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "component membership shape sparqlconstraint 04"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      PREFIX modinst: <https://w3id.org/modavis/ontology/instrument#>\n      SELECT $this WHERE {\n        ?owner modinst:hasMembership $this .\n        FILTER NOT EXISTS { $this modinst:membershipInstrument ?owner . }\n        FILTER NOT EXISTS { $this modinst:parentComponent ?owner . }\n      }\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#ComponentMembershipShape-appliesInConfiguration-PropertyShape-01",
    "@type": [
      "http://www.w3.org/ns/shacl#PropertyShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "applies in configuration property constraint"
