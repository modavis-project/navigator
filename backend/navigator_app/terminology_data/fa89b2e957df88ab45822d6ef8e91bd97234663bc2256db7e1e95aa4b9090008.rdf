    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:targetSubjectsOf rdf:resource="https://w3id.org/modavis/ontology/organ#hasNominalPitchDesignation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#OrganPitchDesignationShape-hasNominalPitchDesignation-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
