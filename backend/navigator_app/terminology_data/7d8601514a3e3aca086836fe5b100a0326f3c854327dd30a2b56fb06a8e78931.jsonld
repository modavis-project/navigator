      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#LoopPointSetShape-SPARQLConstraint-01"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://w3id.org/modavis/ontology/audio#LoopPointSet"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#LoopPointSetShape-SPARQLConstraint-01",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "loop point set shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "Every loop region in a loop point set must use the same fixed audio signal as the set."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "loop point set shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      PREFIX modaudio: <https://w3id.org/modavis/ontology/audio#>\n      SELECT $this WHERE {\n        $this modaudio:appliesToSignal ?signal ; modaudio:hasLoopRegion ?region .\n        FILTER NOT EXISTS { ?region modaudio:appliesToSignal ?signal . }\n      }\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
