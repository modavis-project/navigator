      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Identifies a resource that is an explicit documentary subject of a curated knowledge collection."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
