      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-canonicalMaterialization-PropertyShape-09"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-canonicalizationProfile-PropertyShape-04"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-includesAssertion-PropertyShape-02"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-materializedAs-PropertyShape-06"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-snapshotCreatedAt-PropertyShape-07"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-snapshotCreatedBy-PropertyShape-08"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-snapshotGraphIri-PropertyShape-05"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-snapshotOfCollection-PropertyShape-01"
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ],
    "http://www.w3.org/ns/shacl#sparql": [
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-SPARQLConstraint-01"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-SPARQLConstraint-02"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://w3id.org/modavis/ontology/heritage#KnowledgeSnapshot"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-SPARQLConstraint-01",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "canonical snapshot materialization media type constraint"
      },
      {
        "@language": "en",
        "@value": "knowledge snapshot shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "The canonical snapshot materialization must declare media type application/n-quads."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "canonical snapshot materialization media type constraint"
      },
      {
        "@language": "en",
        "@value": "knowledge snapshot shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n    PREFIX modheritage: <https://w3id.org/modavis/ontology/heritage#>\n    PREFIX modmedia: <https://w3id.org/modavis/ontology/media#>\n    SELECT $this WHERE {\n      $this modheritage:canonicalMaterialization ?bitstream .\n      FILTER NOT EXISTS { ?bitstream modmedia:mediaType \"application/n-quads\" . }\n    }\n  "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-SPARQLConstraint-02",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "knowledge snapshot self-checksum exclusion constraint"
      },
      {
        "@language": "en",
        "@value": "knowledge snapshot shape sparqlconstraint 02"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "A knowledge snapshot must not carry a direct checksum; fix the exact canonical materialization bitstream to avoid an ambiguous or self-referential digest."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "knowledge snapshot self-checksum exclusion constraint"
      },
      {
        "@language": "en",
        "@value": "knowledge snapshot shape sparqlconstraint 02"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n    PREFIX modevidence: <https://w3id.org/modavis/ontology/evidence#>\n    SELECT $this WHERE { $this modevidence:hasChecksum ?checksum . }\n  "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#KnowledgeSnapshotShape-canonicalMaterialization-PropertyShape-09",
    "@type": [
      "http://www.w3.org/ns/shacl#PropertyShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "canonical materialization property constraint"
      },
      {
        "@language": "en",
        "@value": "canonical snapshot materialization property constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#class": [
