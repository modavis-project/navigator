    <ns3:path rdf:nodeID="cb8a5a5dc25d2912f4c290064466dabd0e3902f9da6d5cceee7a36f44539c0ed51" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#ProcessingActivityShape-activityType-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">activity type property constraint</ns2:label>
    <ns3:message xml:lang="en">Activity type constraint: values must have node kind IRI.</ns3:message>
    <ns3:name xml:lang="en">activity type property constraint</ns3:name>
    <ns3:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI" />
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/provenance#activityType" />
