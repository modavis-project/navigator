        "@value": "testing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Relates a resource to a qualified checksum that names both digest algorithm and value."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "The applicable SHACL profile determines which fixed resource is being checked. A checksum establishes fixity only for the declared bytes or canonical materialization and does not establish authenticity or truth."
      }
    ]
  },
