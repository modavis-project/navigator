          }
        ]
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-Path-PropertyShape-08",
    "@type": [
      "http://www.w3.org/ns/shacl#PropertyShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "property path property constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#hasValue": [
      {
        "@id": "https://w3id.org/modavis/vocab/assertion-status/accepted"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "Property path constraint: the value accepted is required."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "property path property constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/modavis/ontology/assertion#projectsAssertion"
          },
          {
            "@id": "https://w3id.org/modavis/ontology/assertion#assertionStatus"
          }
        ]
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-SPARQLConstraint-01",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "projection shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "A projection without a named target graph must include its exact projected RDF statement in the validation graph."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "projection shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      PREFIX modassert: <https://w3id.org/modavis/ontology/assertion#>\n      SELECT $this WHERE {\n        $this modassert:projectionSubject ?subject ;\n              modassert:projectionPredicateIri ?predicateIri .\n        FILTER NOT EXISTS { $this modassert:projectionGraphIri ?graph . }\n        FILTER NOT EXISTS {\n          $this modassert:projectionObject ?object .\n          BIND (IRI(STR(?predicateIri)) AS ?predicate)\n          ?subject ?predicate ?object .\n        }\n        FILTER NOT EXISTS {\n          $this modassert:projectionLiteral ?literal .\n          BIND (IRI(STR(?predicateIri)) AS ?predicate)\n          ?subject ?predicate ?literal .\n        }\n      }\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-SPARQLConstraint-02",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "projection shape sparqlconstraint 02"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "Projection subject and object values must reproduce the assertion being projected."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "projection shape sparqlconstraint 02"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      PREFIX modassert: <https://w3id.org/modavis/ontology/assertion#>\n      SELECT $this WHERE {\n        $this modassert:projectsAssertion ?assertion ; modassert:projectionSubject ?subject .\n        { FILTER NOT EXISTS { ?assertion modassert:assertsSubject ?subject . } }\n        UNION\n        { $this modassert:projectionObject ?object . FILTER NOT EXISTS { ?assertion modassert:assertsObject ?object . } }\n        UNION\n        { $this modassert:projectionLiteral ?literal . FILTER NOT EXISTS { ?assertion modassert:assertsLiteral ?literal . } }\n      }\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#ProjectionShape-SPARQLConstraint-03",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "projection shape sparqlconstraint 03"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "The projection predicate IRI must equal the projected-property mapping of the assertion predicate concept."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "projection shape sparqlconstraint 03"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      PREFIX modassert: <https://w3id.org/modavis/ontology/assertion#>\n      PREFIX assertionpredicate: <https://w3id.org/modavis/vocab/assertion-predicate/>\n      PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\n      SELECT $this WHERE {\n        $this modassert:projectsAssertion ?assertion ; modassert:projectionPredicateIri ?projected .\n        ?assertion modassert:assertsPredicate ?predicate .\n        FILTER (\n          ?predicate != assertionpredicate:has-builder ||\n          ?projected != \"https://w3id.org/modavis/ontology/instrument#hasBuilder\"^^xsd:anyURI\n        )\n      }\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
