    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "compatibility statement shape"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#CompatibilityStatementShape-compatibilityStatus-PropertyShape-01"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#CompatibilityStatementShape-compatibilityTarget-PropertyShape-02"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#CompatibilityStatementShape-compatibilityVersion-PropertyShape-03"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#CompatibilityStatementShape-hasEvidenceRelation-PropertyShape-04"
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ],
    "http://www.w3.org/ns/shacl#sparql": [
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#CompatibilityStatementShape-SPARQLConstraint-01"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://w3id.org/modavis/ontology/virtual-instrument#CompatibilityStatement"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#CompatibilityStatementShape-SPARQLConstraint-01",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "compatibility statement shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "Every compatibility evidence relation must identify the compatibility statement it evaluates."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "compatibility statement shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      PREFIX modevidence: <https://w3id.org/modavis/ontology/evidence#>\n      PREFIX modvmi: <https://w3id.org/modavis/ontology/virtual-instrument#>\n      SELECT $this WHERE {\n        $this modvmi:hasEvidenceRelation ?relation .\n        FILTER NOT EXISTS { ?relation modevidence:evaluates $this . }\n      }\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#CompatibilityStatementShape-compatibilityStatus-PropertyShape-01",
    "@type": [
      "http://www.w3.org/ns/shacl#PropertyShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "compatibility status property constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#in": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/modavis/vocab/compatibility-status/compatible"
          },
          {
            "@id": "https://w3id.org/modavis/vocab/compatibility-status/compatible-with-limitations"
          },
          {
            "@id": "https://w3id.org/modavis/vocab/compatibility-status/incompatible"
          },
          {
            "@id": "https://w3id.org/modavis/vocab/compatibility-status/indeterminate"
          }
        ]
      }
    ],
    "http://www.w3.org/ns/shacl#maxCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "Compatibility status constraint: exactly 1 value(s) are required; values must have node kind IRI; values must belong to the enumerated release set."
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "compatibility status property constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#IRI"
      }
    ],
