    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "Representation-neutral semantics for digital surrogates, managed assets, bitstreams, fixity, derivation, and representation status."
      }
    ],
    "http://purl.org/dc/terms/issued": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
