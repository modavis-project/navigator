  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#VirtualInstrumentIdentityLayerShape-SPARQLConstraint-01",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "virtual instrument identity layer shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "A resource cannot occupy more than one of the distinct virtual-instrument, product, version, and package identity layers."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "virtual instrument identity layer shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      PREFIX modvmi: <https://w3id.org/modavis/ontology/virtual-instrument#>\n      PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\n      SELECT DISTINCT $this WHERE {\n        $this a ?leftType, ?rightType .\n        ?leftType rdfs:subClassOf* ?leftLayer .\n        ?rightType rdfs:subClassOf* ?rightLayer .\n        FILTER (?leftLayer IN (\n          modvmi:VirtualMusicalInstrument,\n          modvmi:VirtualInstrumentProduct,\n          modvmi:VirtualInstrumentVersion,\n          modvmi:VirtualInstrumentPackage\n        ))\n        FILTER (?rightLayer IN (\n          modvmi:VirtualMusicalInstrument,\n          modvmi:VirtualInstrumentProduct,\n          modvmi:VirtualInstrumentVersion,\n          modvmi:VirtualInstrumentPackage\n        ))\n        FILTER (?leftLayer != ?rightLayer)\n      }\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
