    <ns4:label xml:lang="en">source instrument state</ns4:label>
    <ns4:range rdf:resource="https://w3id.org/modavis/ontology/instrument#InstrumentState" />
    <ns5:term_status>testing</ns5:term_status>
    <ns6:definition xml:lang="en">Identifies the specific instrument state captured, modeled, reconstructed, or otherwise used by a virtual-instrument source relation.</ns6:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/ontology/virtual-instrument#versionLabel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
