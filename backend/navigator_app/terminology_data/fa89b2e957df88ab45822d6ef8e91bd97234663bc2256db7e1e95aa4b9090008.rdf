  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#TuningReferenceShape-referencePitchDesignation-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">reference pitch designation property constraint</ns2:label>
    <ns3:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Reference pitch designation constraint: exactly 1 value(s) are required; values must use the string datatype; lexical length must be at least 1.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
