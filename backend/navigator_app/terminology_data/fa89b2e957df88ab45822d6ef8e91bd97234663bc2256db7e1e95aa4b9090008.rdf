    <ns2:label xml:lang="en">organ coupler shape</ns2:label>
    <ns3:name xml:lang="en">organ coupler shape</ns3:name>
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#OrganCouplerShape-couplesFrom-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#OrganCouplerShape-couplesTo-PropertyShape-02" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#OrganCouplerShape-intervalSemitones-PropertyShape-03" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
    <ns3:sparql rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#OrganCouplerShape-SPARQLConstraint-01" />
    <ns3:targetClass rdf:resource="https://w3id.org/modavis/ontology/organ#OrganCoupler" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#OrganCouplerShape-SPARQLConstraint-01">
    <ns2:label xml:lang="en">organ coupler shape sparqlconstraint 01</ns2:label>
    <ns3:message xml:lang="en">An organ coupler must connect distinct components; model same-component effects separately.</ns3:message>
    <ns3:name xml:lang="en">organ coupler shape sparqlconstraint 01</ns3:name>
    <ns3:select>
      PREFIX modorgan: &lt;https://w3id.org/modavis/ontology/organ#&gt;
      SELECT $this WHERE {
        $this modorgan:couplesFrom ?component ;
              modorgan:couplesTo ?component .
      }
    </ns3:select>
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#OrganCouplerShape-couplesFrom-PropertyShape-01">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">couples from property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/organ#OrganComponent" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Couples from constraint: exactly 1 value(s) are required; values must be instances of OrganComponent.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">couples from property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/organ#couplesFrom" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/modavis/shapes/exchange/0.1.0#OrganCouplerShape-couplesTo-PropertyShape-02">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape" />
    <ns2:label xml:lang="en">couples to property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/organ#OrganComponent" />
    <ns3:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:maxCount>
    <ns3:message xml:lang="en">Couples to constraint: exactly 1 value(s) are required; values must be instances of OrganComponent.</ns3:message>
    <ns3:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns3:minCount>
    <ns3:name xml:lang="en">couples to property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/organ#couplesTo" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
  </rdf:Description>
