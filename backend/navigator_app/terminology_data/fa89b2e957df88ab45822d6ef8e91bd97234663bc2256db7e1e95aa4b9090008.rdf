    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ProcessingActivityShape-activityType-PropertyShape-01" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ProcessingActivityShape-usedParameterSet-PropertyShape-02" />
    <ns3:property rdf:resource="https://w3id.org/modavis/shapes/exchange/0.1.0#ProcessingActivityShape-usedSoftware-PropertyShape-03" />
