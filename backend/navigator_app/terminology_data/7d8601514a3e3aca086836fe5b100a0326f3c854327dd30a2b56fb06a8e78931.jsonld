  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#TimeSpanShape-SPARQLConstraint-01",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "time span shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "A time span must not mix xsd:date and xsd:dateTime boundary systems on the same node."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "time span shape sparqlconstraint 01"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n      PREFIX modavis: <https://w3id.org/modavis/ontology/core#>\n      SELECT $this WHERE {\n        $this ?dateProperty ?dateValue ; ?dateTimeProperty ?dateTimeValue .\n        FILTER (?dateProperty IN (modavis:startDate, modavis:endDate))\n        FILTER (?dateTimeProperty IN (modavis:startDateTime, modavis:endDateTime))\n      }\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
