    <ns2:label xml:lang="en">used parameter set property constraint</ns2:label>
    <ns3:class rdf:resource="https://w3id.org/modavis/ontology/provenance#ParameterSet" />
    <ns3:message xml:lang="en">Used parameter set constraint: values must be instances of ParameterSet.</ns3:message>
    <ns3:name xml:lang="en">used parameter set property constraint</ns3:name>
    <ns3:path rdf:resource="https://w3id.org/modavis/ontology/provenance#usedParameterSet" />
    <ns3:severity rdf:resource="http://www.w3.org/ns/shacl#Violation" />
