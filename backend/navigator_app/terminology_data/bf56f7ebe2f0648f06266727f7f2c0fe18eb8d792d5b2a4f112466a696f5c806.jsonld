      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The inclusive calendar date at which a time span ends, when known at day precision."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "The exchange SHACL profile enforces xsd:date because xsd:date is outside the OWL 2 RL datatype map."
      }
    ]
  },
