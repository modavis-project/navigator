      }
    ],
    "http://www.w3.org/ns/shacl#sparql": [
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#CuratedKnowledgeCollectionShape-SPARQLConstraint-01"
      },
      {
        "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#CuratedKnowledgeCollectionShape-SPARQLConstraint-02"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://w3id.org/modavis/ontology/heritage#CuratedKnowledgeCollection"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#CuratedKnowledgeCollectionShape-SPARQLConstraint-01",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "curated knowledge collection shape sparqlconstraint 01"
      },
      {
        "@language": "en",
        "@value": "current snapshot membership constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "The current snapshot must also be explicitly retained by the curated knowledge collection."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "curated knowledge collection shape sparqlconstraint 01"
      },
      {
        "@language": "en",
        "@value": "current snapshot membership constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n    PREFIX modheritage: <https://w3id.org/modavis/ontology/heritage#>\n    SELECT $this WHERE {\n      $this modheritage:currentSnapshot ?snapshot .\n      FILTER NOT EXISTS { $this modheritage:hasKnowledgeSnapshot ?snapshot . }\n    }\n  "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/modavis/shapes/exchange/0.1.0#CuratedKnowledgeCollectionShape-SPARQLConstraint-02",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "curated knowledge collection shape sparqlconstraint 02"
      },
      {
        "@language": "en",
        "@value": "retained snapshot backlink constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "Every retained snapshot must identify the same curated knowledge collection through snapshotOfCollection."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "curated knowledge collection shape sparqlconstraint 02"
      },
      {
        "@language": "en",
        "@value": "retained snapshot backlink constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n    PREFIX modheritage: <https://w3id.org/modavis/ontology/heritage#>\n    SELECT $this WHERE {\n      $this modheritage:hasKnowledgeSnapshot ?snapshot .\n      FILTER NOT EXISTS { ?snapshot modheritage:snapshotOfCollection $this . }\n    }\n  "
      }
    ],
    "http://www.w3.org/ns/shacl#severity": [
      {
        "@id": "http://www.w3.org/ns/shacl#Violation"
      }
    ]
  },
